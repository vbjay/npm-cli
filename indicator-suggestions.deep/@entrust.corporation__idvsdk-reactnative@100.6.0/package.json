{
  "name": "@entrust.corporation/idvsdk-reactnative",
  "version": "100.6.0",
  "description": "Entrust IDV SDK for React Native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "homepage": "https://documentation.identity.entrust.com/sdk/sdk-integration-guide-2025",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./*": {
      "types": "./lib/typescript/src/capture-api/*.d.ts",
      "default": "./lib/module/capture-api/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/typescript/src/capture-api/*"
      ]
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "bin/register-native-modules.ts",
    "README.md",
    "LICENSE.txt",
    "Frameworks"
  ],
  "scripts": {
    "example": "yarn workspace @entrust-idv/react-native-sdk-example",
    "test": "jest",
    "test:bin": "jest --config jest.config.bin.js",
    "typecheck": "tsc -p tsconfig.capture-api.json",
    "lint": "eslint",
    "prepare": "bob build",
    "release:npm": "npm publish --registry=https://registry.npmjs.org/",
    "release:npm:next": "npm publish --registry=https://registry.npmjs.org/ --tag next",
    "release:nexus": "npm publish --registry=https://nexus.mgmt.onfido.xyz/repository/onfido_npm_hosted/",
    "pages:generateJsonPage:android": "node .gitlab/pages/generateAndroidJsonPage.js",
    "pages:generateJsonPage:ios": "node .gitlab/pages/generateIOSJsonPage.js"
  },
  "bin": {
    "register-native-modules": "./bin/register-native-modules.ts"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "author": "https://documentation.identity.entrust.com/",
  "license": "Entrust Corporation",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.930.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@react-native-community/cli": "15.0.0-alpha.2",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "^0.78.0",
    "@release-it/conventional-changelog": "^9.0.2",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "commitlint": "^19.6.1",
    "del-cli": "^5.1.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.0.3",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-builder-bob": "^0.40.8",
    "release-it": "^17.10.0",
    "turbo": "^1.10.7",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "EntrustIdvNativeModule",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.entrustidv.reactnativesdk"
    },
    "ios": {
      "modulesProvider": {
        "RNEntrustIDV": "RNEntrustIDV"
      }
    }
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "version": "0.52.1"
  }
}
