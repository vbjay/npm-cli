{
  "name": "react-native-ariel-rs",
  "version": "0.5.0",
  "description": "Mermaid diagrams for React Native and React Native Web. No DOM. No WebView. Pure Rust.",
  "main": "./lib/module/index.js",
  "source": "./src/index.tsx",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "browser": "./lib/module/index.web.js",
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "ArielRsFramework.xcframework",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "clean": "del-cli android/build lib",
    "prepare": "bob build && node scripts/copy-wasm-to-lib.js",
    "typecheck": "tsc",
    "test": "jest",
    "ubrn:ios": "ubrn build ios",
    "ubrn:ios-ci": "ubrn build ios",
    "ubrn:android": "ubrn build android",
    "ubrn:web": "wasm-pack build rust_modules/wasm --target web --out-dir ../../src/generated/web/wasm-bindgen && node scripts/patch-wasm.js",
    "ubrn:web-release": "wasm-pack build rust_modules/wasm --target web --release --out-dir ../../src/generated/web/wasm-bindgen && node scripts/patch-wasm.js",
    "ubrn:checkout": "ubrn checkout",
    "ubrn:clean": "del-cli cpp ios src/generated src/Native* src/index.*ts* src/multiply*",
    "ubrn:generate": "node scripts/generate-bindings.js"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "mermaid",
    "mermaid-js",
    "svg",
    "diagram",
    "flowchart",
    "rust",
    "wasm",
    "web",
    "no-webview",
    "turbo-module",
    "jsi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinfimate/react-native-ariel-rs.git"
  },
  "author": "Rochanglien Infimate <r.infimate@gmail.com> (https://github.com/rinfimate)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rinfimate/react-native-ariel-rs/issues"
  },
  "homepage": "https://github.com/rinfimate/react-native-ariel-rs#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.77.0",
    "@types/react": "^18.3.0",
    "del-cli": "^7.0.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "react": "18.3.1",
    "react-native": "0.77.0",
    "react-native-builder-bob": "^0.41.0",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.73.0",
    "react-native-svg": ">=13.0.0"
  },
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "generated/web/wasm-bindgen/**",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ],
      "codegen"
    ]
  },
  "codegenConfig": {
    "name": "ArielSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.ariel"
    },
    "includesGeneratedCode": true
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": "babel-jest"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "moduleNameMapper": {
      "^react-native-ariel-rs$": "<rootDir>/src/index.tsx"
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "tools": [
      "jest"
    ],
    "version": "0.62.0"
  },
  "dependencies": {
    "uniffi-bindgen-react-native": "^0.31.0-2"
  }
}
