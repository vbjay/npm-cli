{
  "name": "@deliverysolutions/react-native-proximity-sdk",
  "version": "0.3.1",
  "description": "Proximity Delivery Solutions tracking sdk for react-native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.js",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!ios/ReactNativeProximitySdk.*",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepack": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn install && yarn example pods",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build",
    "publish:beta-dev": "cp config/config.dev.js src/config.js && npm version prerelease --commit-hooks false --preid=beta-dev && npm publish --tag beta-dev",
    "publish:beta-qa": "cp config/config.qa.js src/config.js && npm version prerelease --commit-hooks false --preid=beta-qa && npm publish --tag beta-qa",
    "publish:rc": "cp config/config.sandbox.js src/config.js && npm version prerelease --commit-hooks false --preid=rc && npm publish --tag rc",
    "publish:beta-dev-revamped-lib": "cp config/config.dev.js src/config.js && npm version prerelease --commit-hooks false --preid=beta-dev-revamped-lib && npm publish --tag beta-dev-revamped-lib"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "homepage": "https://github.com/delivery-solutions/ds-proximity-sdk-react-native#readme",
  "repository": "https://github.com/delivery-solutions/ds-proximity-sdk-react-native.git",
  "author": "Delivery Solutions <aman.gupta@deliverysolutions.co> (https://bitbucket.org/deliverysolutions)",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native-community/eslint-config": "^3.0.2",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^28.1.2",
    "@types/react": "~17.0.21",
    "@types/react-native": "0.70.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.0.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^28.1.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "18.2.0",
    "react-native": "0.71.4",
    "react-native-background-fetch": "^4.2.1",
    "react-native-background-geolocation": "^4.13.1",
    "react-native-builder-bob": "^0.20.4",
    "release-it": "^15.0.0",
    "typescript": "^4.5.2"
  },
  "resolutions": {
    "@types/react": "17.0.21"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-background-geolocation": "^4.10.0",
    "react-native-background-fetch": "^4.1.0"
  },
  "engines": {
    "node": ">= 16.0.0"
  },
  "packageManager": "^yarn@1.22.15",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.17.11",
    "react-native-uuid": "^2.0.1"
  }
}
