{
  "name": "@contrail/cli",
  "version": "3.5.3",
  "description": "VibeIQ's Contrail Platform CLI.",
  "bin": {
    "contrail-cli": "./bin/run",
    "contrail": "./bin/run"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "contrail-cli"
  ],
  "homepage": "https://www.npmjs.com/package/@contrail/cli",
  "main": "dist/index.js",
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "bundledDependencies": [
    "@contrail/entity-types",
    "@contrail/loader",
    "@contrail/org-config-migration",
    "@contrail/sdk",
    "@contrail/types",
    "@contrail/util"
  ],
  "dependencies": {
    "@contrail/entity-types": "^1.6.1",
    "@contrail/loader": "^2.0.9",
    "@contrail/org-config-migration": "^1.2.0",
    "@contrail/sdk": "^1.5.13",
    "@contrail/types": "^3.1.5",
    "@contrail/util": "^1.2.0",
    "@oclif/core": "^2",
    "@oclif/plugin-autocomplete": "^2.1.4",
    "@oclif/plugin-help": "^5",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "amazon-cognito-identity-js": "^5.2.3",
    "arg": "^4.0.1",
    "aws-sdk": "^2.1044.0",
    "axios": "^1.3.5",
    "chalk": "^4.0.0",
    "cli-table3": "^0.6.5",
    "command-line-usage": "^6.1.1",
    "csv-parse": "^5.5.5",
    "csvtojson": "^2.0.10",
    "esm": "^3.2.25",
    "execa": "^5.0.0",
    "inquirer": "^8.2.0",
    "js-yaml": "^4.1.0",
    "json2csv": "^5.0.7",
    "listr": "^0.14.3",
    "lodash": "^4.17.21",
    "ncp": "^2.0.0",
    "pkg-install": "^1.0.0",
    "semver": "^7.5.4",
    "winston": "^3.10.0",
    "zip-a-folder": "^1.1.5"
  },
  "devDependencies": {
    "@oclif/test": "^2.3.8",
    "@types/chai": "^4",
    "@types/jest": "^29.5.0",
    "@types/node": "^16.18.14",
    "@types/winston": "^2.4.4",
    "chai": "^4",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "oclif": "3.16",
    "prettier": "^3.0.0",
    "shx": "^0.3.3",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "tslib": "^2.5.0",
    "typescript": "^4.9.5"
  },
  "oclif": {
    "bin": "contrail",
    "dirname": "contrail-cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ],
    "topicSeparator": " ",
    "topics": {
      "app": {
        "description": "Create, deploy, and manage apps and extensions"
      },
      "config": {
        "description": "Manage the configuration of contrail cli"
      },
      "load": {
        "description": "Load data to VibeIQ from local CSV files"
      },
      "load-local": {
        "description": "Run the full data loading pipeline locally with staged feedback",
        "hidden": true
      },
      "types": {
        "description": "Export, manage, and import types"
      },
      "users": {
        "description": "Export and import users"
      },
      "groups": {
        "description": "Export and import user groups"
      },
      "webhooks": {
        "description": "Manage VibeIQ webhooks"
      },
      "workflow-template-definitions": {
        "description": "Manage workflow template definitions"
      },
      "workflow-templates": {
        "description": "Manage workflow templates"
      },
      "instance": {
        "description": "Manage instance (org) configuration data"
      }
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b && npm run copy-templates",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "copy-templates": "cp -r templates/ dist/templates",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "test": "jest",
    "version": "oclif readme && git add README.md"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "types": "dist/index.d.ts",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "bundleDependencies": [
    "@contrail/entity-types",
    "@contrail/loader",
    "@contrail/org-config-migration",
    "@contrail/sdk",
    "@contrail/types",
    "@contrail/util"
  ]
}
