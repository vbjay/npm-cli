{
  "name": "@alihamzaazhar/react-native-location-settings",
  "version": "1.0.5",
  "description": "Android-only in-app location enable dialog for React Native (New Architecture / TurboModule)",
  "platforms": {
    "android": true,
    "ios": false
  },
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "react-native": "src/index",
  "source": "src/index",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "src",
    "lib",
    "android",
    "!android/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "prepare": "bob build",
    "typescript": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "android",
    "location",
    "gps",
    "turbo-module",
    "new-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alihamzaazhar/react-native-location-settings.git",
    "homepage": "https://github.com/alihamzaazhar/react-native-location-settings"
  },
  "author": "Ali Hamza",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.76.0",
    "react": "18.2.0",
    "react-native": "0.76.0",
    "react-native-builder-bob": "^0.30.0",
    "typescript": "^5.3.0"
  },
  "codegenConfig": {
    "name": "RNLocationSettingsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.locationsettings"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript"
      ]
    ]
  }
}
