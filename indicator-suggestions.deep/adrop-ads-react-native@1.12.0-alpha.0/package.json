{
    "name": "adrop-ads-react-native",
    "version": "1.12.0-alpha.0",
    "description": "Adrop Ads",
    "main": "lib/commonjs/index",
    "module": "lib/module/index",
    "types": "lib/typescript/src/index.d.ts",
    "react-native": "src/index",
    "source": "src/index",
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "cpp",
        "*.podspec",
        "!ios/build",
        "!android/build",
        "!android/gradle",
        "!android/gradlew",
        "!android/gradlew.bat",
        "!android/local.properties",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/.*"
    ],
    "scripts": {
        "example": "yarn workspace adrop-ads-react-native-example",
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"**/*.{js,ts,tsx}\"",
        "format": "yarn run lint --fix",
        "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
        "prepare": "bob build",
        "release": "release-it"
    },
    "keywords": [
        "react-native",
        "ios",
        "android"
    ],
    "repository": "https://github.com/OpenRhapsody/adrop-ads-react-native",
    "author": "OpenRhapsody <dev@openrhapsody.com> (https://github.com/OpenRhapsody)",
    "license": "BSD-3-Clause",
    "bugs": {
        "url": "https://github.com/OpenRhapsody/adrop-ads-react-native/issues"
    },
    "homepage": "https://github.com/OpenRhapsody/adrop-ads-react-native#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^17.0.2",
        "@evilmartians/lefthook": "^1.5.0",
        "@react-native/eslint-config": "^0.72.2",
        "@release-it/conventional-changelog": "^5.0.0",
        "@testing-library/react-native": "^12.3.2",
        "@types/jest": "^29.5.7",
        "@types/react": "~17.0.21",
        "@types/react-native": "0.70.0",
        "commitlint": "^17.0.2",
        "del-cli": "^5.0.0",
        "eslint": "^8.4.1",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-prettier": "^4.0.0",
        "jest": "^28.1.1",
        "pod-install": "^0.1.0",
        "prettier": "^2.0.5",
        "react": "18.2.0",
        "react-native": "0.72.6",
        "react-native-builder-bob": "^0.23.1",
        "react-test-renderer": "^18.2.0",
        "release-it": "^15.0.0",
        "turbo": "^1.10.7",
        "typescript": "^5.0.2"
    },
    "resolutions": {
        "@types/react": "17.0.21"
    },
    "peerDependencies": {
        "react": "*",
        "react-native": ">=0.74.0"
    },
    "workspaces": [
        "example"
    ],
    "packageManager": "yarn@3.6.1",
    "engines": {
        "node": ">= 18.0.0"
    },
    "jest": {
        "preset": "react-native",
        "modulePathIgnorePatterns": [
            "<rootDir>/example/node_modules",
            "<rootDir>/lib/"
        ]
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "release-it": {
        "git": {
            "commitMessage": "chore: release ${version}",
            "tagName": "v${version}"
        },
        "npm": {
            "publish": true
        },
        "github": {
            "release": true
        },
        "plugins": {
            "@release-it/conventional-changelog": {
                "preset": "angular"
            }
        }
    },
    "eslintConfig": {
        "root": true,
        "extends": [
            "@react-native",
            "prettier"
        ],
        "rules": {
            "prettier/prettier": [
                "error",
                {
                    "quoteProps": "consistent",
                    "semi": false,
                    "singleQuote": true,
                    "tabWidth": 4,
                    "trailingComma": "es5",
                    "useTabs": false
                }
            ]
        }
    },
    "prettier": {
        "quoteProps": "consistent",
        "singleQuote": true,
        "tabWidth": 2,
        "trailingComma": "es5",
        "useTabs": false
    },
    "eslintIgnore": [
        "node_modules/",
        "lib/"
    ],
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            "commonjs",
            "module",
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    },
    "codegenConfig": {
        "name": "AdropAdsReactNativeSpec",
        "type": "all",
        "jsSrcsDir": "src/specs",
        "ios": {
            "componentProvider": {
                "AdropBannerView": "AdropBannerComponentView",
                "AdropNativeAdView": "AdropNativeAdComponentView",
                "AdropNativeAssetView": "AdropNativeAssetComponentView"
            }
        },
        "android": {
            "javaPackageName": "io.adrop.specs"
        }
    }
}
