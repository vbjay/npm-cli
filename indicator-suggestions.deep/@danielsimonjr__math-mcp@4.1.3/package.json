{
  "name": "@danielsimonjr/math-mcp",
  "version": "4.1.3",
  "description": "MCP server for mathematical computations powered by MathTS (TypeScript rewrite of mathjs with native WASM/parallel acceleration), with comprehensive input validation, security features, rate limiting, and expression caching",
  "main": "dist/index.js",
  "scripts": {
    "test": "node test/integration-test.js",
    "test:correctness": "node test/correctness-tests.js",
    "test:all": "npm test && npm run test:correctness",
    "test:unit": "vitest",
    "test:coverage": "vitest --coverage",
    "test:security": "vitest run test/security/",
    "build": "tsc",
    "verify:dist": "test -d dist && test -f dist/index.js || (echo 'Error: dist/ directory missing or incomplete' && exit 1)",
    "check:deps": "node scripts/check-dependencies.js",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "graph": "tsx tools/generate-dependency-graph.ts",
    "prepare": "husky install",
    "prepublishOnly": "npm run type-check && npm run build && npm test && npm run test:correctness"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mathjs",
    "mathematics",
    "calculator",
    "wasm",
    "webassembly",
    "performance",
    "statistics",
    "linear-algebra",
    "matrix",
    "calculus"
  ],
  "author": "math-mcp contributors",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/math-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/danielsimonjr/math-mcp/issues"
  },
  "homepage": "https://github.com/danielsimonjr/math-mcp#readme",
  "type": "module",
  "dependencies": {
    "@danielsimonjr/mathts-compat": "^0.1.9",
    "@danielsimonjr/mathts-matrix": "^0.1.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "61.4.1",
    "globals": "^15.15.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.8.3",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "bin": {
    "math-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "ip-address": "^10.1.1",
    "esbuild": "^0.28.1",
    "minimatch@^10.0.0": {
      "brace-expansion": "^5.0.6"
    }
  }
}
