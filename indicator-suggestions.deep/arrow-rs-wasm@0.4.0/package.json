{
  "name": "arrow-rs-wasm",
  "version": "0.4.0",
  "description": "High-performance WebAssembly library for Apache Arrow, Feather, and Parquet data with zero-copy semantics, LZ4 compression, and comprehensive model-based testing",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "import": "./web/arrow_rs_wasm.js",
        "types": "./web/arrow_rs_wasm.d.ts"
      },
      "node": {
        "import": "./node/arrow_rs_wasm.js",
        "types": "./node/arrow_rs_wasm.d.ts"
      },
      "import": "./bundler/arrow_rs_wasm.js",
      "types": "./bundler/arrow_rs_wasm.d.ts"
    },
    "./web": {
      "import": "./web/arrow_rs_wasm.js",
      "types": "./web/arrow_rs_wasm.d.ts"
    },
    "./bundler": {
      "import": "./bundler/arrow_rs_wasm.js",
      "types": "./bundler/arrow_rs_wasm.d.ts"
    },
    "./node": {
      "import": "./node/arrow_rs_wasm.js",
      "types": "./node/arrow_rs_wasm.d.ts"
    }
  },
  "files": [
    "web/",
    "bundler/",
    "node/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "clean": "rimraf web/ bundler/ node/",
    "build:web": "wasm-pack build --release --target web --out-dir web",
    "build:bundler": "wasm-pack build --release --target bundler --out-dir bundler",
    "build:node": "wasm-pack build --release --target nodejs --out-dir node",
    "build": "npm run clean && npm run build:web && npm run build:bundler && npm run build:node",
    "test": "npm run build && npm run test:browser",
    "test:browser": "cd browser && python3 server.py &",
    "test:e2e": "bash mbd_tests/e2e/scripts/run_e2e_local.sh",
    "test:e2e:ci": "bash mbd_tests/e2e/scripts/run_e2e_ci.sh",
    "prepare": "npm run build",
    "pack": "npm pack",
    "publish:npm": "npm publish --access public"
  },
  "keywords": [
    "arrow",
    "feather",
    "parquet",
    "webassembly",
    "wasm",
    "zero-copy",
    "ipc",
    "lz4",
    "model-based-testing",
    "cross-browser",
    "performance",
    "rust",
    "apache-arrow",
    "data-processing"
  ],
  "author": "Generated by Claude Code",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BectorVoom/arrow-rs-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/BectorVoom/arrow-rs-wasm/issues"
  },
  "homepage": "https://github.com/BectorVoom/arrow-rs-wasm#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0",
    "playwright": "^1.56.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
