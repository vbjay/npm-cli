{
  "name": "@agnostack/next-shopify",
  "version": "3.3.0",
  "author": "agnoStack Dev <developers@agnostack.com> (https://agnostack.com)",
  "owner": "agnoStack",
  "description": "Please contact agnoStack via info@agnostack.com for any questions",
  "homepage": "https://github.com/agnostack/next-shopify#readme",
  "repository": "github:agnostack/next-shopify",
  "keywords": [
    "nextjs",
    "shopify",
    "library",
    "typescript",
    "javascript",
    "agnostack"
  ],
  "license": "MIT",
  "main": "./dist/plugins/index.js",
  "types": "./dist/plugins/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugins/index.d.ts",
      "require": "./dist/plugins/index.js",
      "default": "./dist/plugins/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "require": "./dist/lib/index.js",
      "import": "./dist/lib/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "require": "./dist/runtime/index.js",
      "import": "./dist/runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "*.md"
  ],
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "tsc": "npx -p typescript tsc",
    "build": "yarn tsc -d",
    "watch": "yarn tsc -w",
    "clean": "npx rimraf@4.4.1 dist node_modules _storage",
    "clean:install": "yarn clean && yarn install --force",
    "lint": "eslint 'src/**' --fix",
    "test": "jest --passWithNoTests",
    "release": "npx semantic-release@22.0.12",
    "release:debug": "yarn release --debug",
    "prepare": "husky install"
  },
  "lint-staged": {
    "{src,test,types}/**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "peerDependencies": {
    "@agnostack/env": "*",
    "@agnostack/next-plugins": "*",
    "@agnostack/verifyd": "*",
    "firebase-admin": ">=8.10.0",
    "http-proxy": ">=1.18.1",
    "next": ">=12.1.0",
    "react": ">=17.0.2",
    "react-dom": ">=17.0.2",
    "react-is": ">=17.0.2",
    "prompts": ">=2.4.0"
  },
  "dependencies": {
    "@shopify/shopify-api": "11.8.1",
    "browser-monads-ts": "2.0.1",
    "chalk": "4.1.2",
    "cookies": "0.8.0",
    "isbot": "3.6.12",
    "isomorphic-webcrypto": "2.3.8",
    "js-base64": "3.1.0",
    "jsonwebtoken": "9.0.1",
    "jwt-decode": "3.1.2",
    "luxon": "3.2.1",
    "minimatch": "9.0.1",
    "mustache": "4.2.0",
    "nextjs-cors": "2.1.1",
    "node-http-proxy-json": "0.1.9",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@babel/core": "7.27.x",
    "@babel/eslint-parser": "7.27.x",
    "@commitlint/cli": "18.6.1",
    "@commitlint/config-conventional": "18.6.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "9.2.6",
    "@semantic-release/npm": "11.0.3",
    "@semantic-release/release-notes-generator": "12.1.0",
    "@types/jest": "26.0.24",
    "@types/node": "18.19.1",
    "@types/react": "17.0.2",
    "@types/react-dom": "17.0.2",
    "@typescript-eslint/eslint-plugin": "6.3.0",
    "@typescript-eslint/parser": "6.3.0",
    "chai": "4.3.10",
    "chai-as-promised": "7.1.1",
    "chalk": "4.1.2",
    "chance": "1.1.8",
    "eslint": "8.23.0",
    "eslint-plugin-import": "2.26.0",
    "husky": "6.0.0",
    "jest": "29.x",
    "lint-staged": "11.0.0",
    "rimraf": "4.4.1",
    "semantic-release": "22.0.12",
    "sinon": "10.0.0",
    "sinon-chai": "3.6.0",
    "ts-jest": "27.1.5",
    "typescript": "5.4.2"
  },
  "resolutions": {
    "**/npm": "10.8.2",
    "**/rimraf": "4.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
