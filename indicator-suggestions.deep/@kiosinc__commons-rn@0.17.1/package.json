{
  "name": "@kiosinc/commons-rn",
  "version": "0.17.1",
  "description": "Common Code",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "src/components",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @kiosinc/commons-rn-example",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it",
    "tsc": "tsc -p tsconfig.json",
    "clean-lib": "rm -rf ./lib",
    "pre-publish": "rm -rf ./lib && tsc",
    "yalc:publish": "yarn prepare && rm -rf ~/.yalc/packages && yalc publish --private",
    "test-in-remy": "yarn yalc:publish && (cd ../remy && yalc add @kiosinc/commons-rn)",
    "test-in-git": "yarn yalc:publish && (cd ../git && yalc add @kiosinc/commons-rn)",
    "test-in-gusteau": "yarn yalc:publish && (cd ../gusteau-mobile && yalc add @kiosinc/commons-rn)",
    "test-in-django": "yarn yalc:publish && (cd ../django && yalc add @kiosinc/commons-rn)"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kiosinc/@kiosinc/commons-rn"
  },
  "author": "jjc",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kiosinc/@kiosinc/commons-rn/issues"
  },
  "homepage": "https://github.com/kiosinc/@kiosinc/commons-rn#readme",
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/auth": "^20.3.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-navigation/native": "^7.1.17",
    "@release-it/conventional-changelog": "^5.0.0",
    "@shopify/flash-list": "^1.5.0",
    "@types/color": "^3.0.6",
    "@types/jest": "^28.1.2",
    "@types/react": "~17.0.21",
    "@types/react-native": "0.70.0",
    "@types/react-native-material-ripple": "^0",
    "@types/react-native-vector-icons": "^6.4.13",
    "@types/react-native-video": "^5.0.18",
    "@types/semver": "^7",
    "camelcase": "^8.0.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.0.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^28.1.1",
    "prettier": "^2.0.5",
    "react": "18.2.0",
    "react-native": "0.72.6",
    "react-native-builder-bob": "^0.23.1",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.13.4",
    "react-native-mmkv": "^2.10.2",
    "react-native-pager-view": "^6.5.1",
    "react-native-reanimated": "^3.5.4",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-square-in-app-payments": "^1.7.5",
    "react-native-vector-icons": "^10.0.0",
    "react-native-webview": "^13.10.2",
    "release-it": "^15.0.0",
    "typescript": "^5.0.2"
  },
  "resolutions": {
    "@types/react": "17.0.21",
    "react-native-reanimated": "3.3.0"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": "*",
    "@react-navigation/native": "^7.1.17",
    "@shopify/flash-list": "^1.5.0",
    "react": "*",
    "react-native": "*",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.13.4",
    "react-native-mmkv": "^2.10.2",
    "react-native-pager-view": ">=6.0.0",
    "react-native-reanimated": "^3.5.4",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-vector-icons": "*",
    "react-native-config": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": ">= 18.0.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "publishArgs": [
        "--access",
        "public"
      ]
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^4.6.1",
    "@hookform/resolvers": "^3.3.2",
    "@kiosinc/commons-types": "^0.2.0",
    "@material/material-color-utilities": "^0.3.0",
    "@react-native-firebase/firestore": "^20.3.0",
    "@react-native-firebase/messaging": "^20.3.0",
    "@react-native-firebase/storage": "^20.3.0",
    "@react-navigation/material-top-tabs": "^7.3.6",
    "@shopify/restyle": "^2.4.2",
    "@tanstack/react-query": "^4.32.6",
    "axios": "^1.4.0",
    "color": "^4.2.3",
    "i18next": "^23.7.6",
    "mixpanel-react-native": "^3.0.2",
    "react-content-loader": "^6.2.1",
    "react-hook-form": "^7.48.2",
    "react-i18next": "^13.5.0",
    "react-native-blob-util": "^0.19.9",
    "react-native-device-info": "^10.13.2",
    "react-native-international-phone-number": "^0.7.6",
    "react-native-material-ripple": "^0.9.1",
    "react-native-paper": "^5.11.1",
    "react-native-size-matters": "^0.4.2",
    "react-native-uuid": "^2.0.2",
    "react-native-video": "^6.16.1",
    "semver": "^7.6.3",
    "yup": "^1.3.2"
  }
}
