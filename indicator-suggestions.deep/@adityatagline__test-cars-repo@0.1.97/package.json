{
  "name": "@adityatagline/test-cars-repo",
  "version": "0.1.97",
  "description": "ui kit for react native applications",
  "main": "lib/module",
  "module": "lib/module",
  "types": "packages-types/index.d.ts",
  "react-native": ".",
  "source": ".",
  "files": [
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    ".",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/.*",
    "packages-types",
    "car-hire"
  ],
  "scripts": {
    "example": "yarn workspace evda-airframe-ui-example",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "spell-check": "cspell \"car-hire\"",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alifa20/airframe-ui.git"
  },
  "author": "12068482+alifa20@users.noreply.github.com <12068482+alifa20@users.noreply.github.com> (https://github.com/alifa20/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alifa20/airframe-ui/issues"
  },
  "homepage": "https://github.com/alifa20/airframe-ui#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/plugin-proposal-export-namespace-from": "7.18.9",
    "@commitlint/config-conventional": "17.8.1",
    "@evilmartians/lefthook": "1.6.10",
    "@gorhom/bottom-sheet": "4.6.1",
    "@ptomasroos/react-native-multi-slider": "2.2.2",
    "@react-native-community/clipboard": "1.5.1",
    "@react-native-community/datetimepicker": "7.7.0",
    "@react-native/babel-preset": "0.75.0-main",
    "@react-native/eslint-config": "0.74.80",
    "@release-it/conventional-changelog": "5.1.1",
    "@storybook/addon-react-native-web": "0.0.23",
    "@twotalltotems/react-native-otp-input": "1.3.11",
    "@types/jest": "29.5.12",
    "@types/react": "18.2.79",
    "chromatic": "11.3.0",
    "commitlint": "17.8.1",
    "cspell": "8.7.0",
    "del-cli": "5.1.0",
    "eslint": "8.51.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-prettier": "5.0.1",
    "expo-font": "11.10.3",
    "jest": "29.7.0",
    "prettier": "3.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-builder-bob": "0.23.2",
    "react-native-calendars": "1.1304.1",
    "react-native-country-picker-modal": "2.0.0",
    "react-native-gesture-handler": "2.16.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-paper": "5.12.3",
    "react-native-reanimated": "3.8.1",
    "react-native-safe-area-context": "4.9.0",
    "react-native-vector-icons": "10.0.3",
    "react-native-web": "0.19.11",
    "react-native-wheely": "0.6.0",
    "release-it": "15.11.0",
    "typescript": "5.4.5"
  },
  "resolutions": {
    "@types/react": "18.2.79"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": "4.6.1",
    "@ptomasroos/react-native-multi-slider": "2.2.2",
    "@react-native-community/clipboard": "1.5.1",
    "@twotalltotems/react-native-otp-input": "1.3.11",
    "expo-font": "11.10.3",
    "react": "*",
    "react-native": "*",
    "react-native-calendars": "1.1304.1",
    "react-native-country-picker-modal": "2.0.0",
    "react-native-gesture-handler": "2.16.0",
    "react-native-paper": "5.12.3",
    "react-native-reanimated": "3.8.1",
    "react-native-safe-area-context": "4.9.0",
    "react-native-svg": "15.1.0",
    "react-native-vector-icons": "10.0.3",
    "react-native-wheely": "0.6.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.8.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": ".",
    "output": "lib",
    "targets": [
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/{node_modules,example,*.md,*.json,*.yml,*.js,*.map,LICENSE,*.lock,*-lock.*}/**"
  },
  "dependencies": {
    "react-native-svg": "15.1.0"
  }
}
