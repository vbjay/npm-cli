{
  "name": "@beignet/cli",
  "version": "0.0.34",
  "type": "module",
  "description": "CLI for creating and maintaining Beignet apps.",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "bin": {
    "beignet": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test-d.ts",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepack": "bun run build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist coverage .turbo",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome check ."
  },
  "keywords": [
    "contract",
    "api",
    "typescript",
    "cli",
    "scaffold",
    "nextjs",
    "tanstack-intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taylorbryant/beignet.git",
    "directory": "packages/cli"
  },
  "author": "Taylor Bryant",
  "homepage": "https://github.com/taylorbryant/beignet#readme",
  "bugs": "https://github.com/taylorbryant/beignet/issues",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^20.10.0",
    "next-themes": "^0.4.6",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@beignet/core": "^0.0.34",
    "@clack/prompts": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stricli/core": "^1.2.7",
    "jiti": "^2.7.0",
    "zod": "^4.0.0"
  }
}
