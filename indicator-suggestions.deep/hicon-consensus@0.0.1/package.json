{
  "name": "hicon-consensus",
  "version": "0.0.1",
  "description": "Node.js bindings for HiCon hybrid consensus algorithm",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "install": "napi build --platform",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform --debug",
    "test": "jest"
  },
  "napi": {
    "name": "hicon-consensus",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "keywords": [
    "consensus",
    "blockchain",
    "distributed-systems",
    "rust",
    "napi-rs",
    "hybrid",
    "ccr",
    "ccc"
  ],
  "author": "Oscar Valois <osvaloismtz@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/osvalois/hicon"
  },
  "dependencies": {
    "@node-rs/helper": "^1.3.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.16.3",
    "@types/jest": "^29.5.1",
    "@types/node": "^18.16.3",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">= 14"
  }
}
