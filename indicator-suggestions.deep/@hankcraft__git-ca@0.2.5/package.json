{
  "artifactDownloadUrls": [
    "https://github.com/hankcraft/git-ca/releases/download/v0.2.5"
  ],
  "bin": {
    "git-ca": "run-git-ca.js"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "axios-proxy-builder": "^0.1.2",
    "console.table": "^0.10.0",
    "detect-libc": "^2.1.2",
    "rimraf": "^6.1.3"
  },
  "description": "git plugin that drafts commit messages using GitHub Copilot",
  "devDependencies": {
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=14",
    "npm": ">=6"
  },
  "glibcMinimum": {
    "major": 2,
    "series": 35
  },
  "homepage": "https://github.com/hankcraft/git-ca",
  "keywords": [
    "git",
    "cli",
    "copilot",
    "codex",
    "rust"
  ],
  "license": "MIT",
  "name": "@hankcraft/git-ca",
  "preferUnplugged": true,
  "repository": "https://github.com/hankcraft/git-ca",
  "scripts": {
    "fmt": "prettier --write **/*.js",
    "fmt:check": "prettier --check **/*.js",
    "postinstall": "node ./install.js"
  },
  "supportedPlatforms": {
    "aarch64-apple-darwin": {
      "artifactName": "git-ca-aarch64-apple-darwin.tar.xz",
      "bins": {
        "git-ca": "git-ca"
      },
      "zipExt": ".tar.xz"
    },
    "aarch64-unknown-linux-gnu": {
      "artifactName": "git-ca-aarch64-unknown-linux-gnu.tar.xz",
      "bins": {
        "git-ca": "git-ca"
      },
      "zipExt": ".tar.xz"
    },
    "x86_64-apple-darwin": {
      "artifactName": "git-ca-x86_64-apple-darwin.tar.xz",
      "bins": {
        "git-ca": "git-ca"
      },
      "zipExt": ".tar.xz"
    },
    "x86_64-unknown-linux-gnu": {
      "artifactName": "git-ca-x86_64-unknown-linux-gnu.tar.xz",
      "bins": {
        "git-ca": "git-ca"
      },
      "zipExt": ".tar.xz"
    }
  },
  "version": "0.2.5",
  "volta": {
    "node": "18.14.1",
    "npm": "9.5.0"
  }
}