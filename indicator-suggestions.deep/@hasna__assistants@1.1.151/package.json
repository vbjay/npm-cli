{
  "name": "@hasna/assistants",
  "version": "1.1.151",
  "description": "Personal AI assistant that runs in your terminal — powered by the AI SDK",
  "type": "module",
  "bin": {
    "assistants": "dist/index.js"
  },
  "exports": {
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run packages/terminal/src/index.tsx",
    "build": "bun run build.ts",
    "build:packages": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules dist",
    "prepublishOnly": "bun run build",
    "postinstall": "mkdir -p $HOME/.hasna/assistants/{logs,temp,messages,backups,connectors,workspaces,agents} 2>/dev/null || true"
  },
  "devDependencies": {
    "@hasna/assistants-core": "workspace:*",
    "@types/bun": "^1.3.8",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.13",
    "@types/unist": "^3.0.3",
    "bun-types": "^1.3.9",
    "chalk": "^5.6.2",
    "marked": "^17.0.1",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.4",
    "react-test-renderer": "^19.2.4",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/assistants-legacy.git"
  },
  "keywords": [
    "ai",
    "assistant",
    "cli",
    "terminal",
    "ai-sdk",
    "bun",
    "open-source"
  ],
  "author": "Hasna",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hasna/assistants-legacy/issues"
  },
  "homepage": "https://github.com/hasna/assistants-legacy#readme",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "bun": ">=1.3.9"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@hasna/logs": "^0.3.24",
    "@hasna/skills": "^0.1.41",
    "@hasna/todos": "^0.11.52",
    "ink": "7.0.3"
  }
}
