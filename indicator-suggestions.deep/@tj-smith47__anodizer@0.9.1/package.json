{
  "name": "@tj-smith47/anodizer",
  "version": "0.9.1",
  "description": "Anodizer — a Rust release-automation tool. This package installs the prebuilt anodizer binary for your platform from the matching GitHub release.",
  "bin": {
    "anodizer": "run.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "files": [
    "install.js",
    "run.js",
    "README.md"
  ],
  "keywords": [
    "anodizer",
    "release",
    "release-automation",
    "rust",
    "cli"
  ],
  "license": "MIT",
  "author": "TJ Smith",
  "homepage": "https://tj-smith47.github.io/anodizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tj-smith47/anodizer.git"
  },
  "bugs": {
    "url": "https://github.com/tj-smith47/anodizer/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "publishConfig": {
    "access": "public"
  }
}
