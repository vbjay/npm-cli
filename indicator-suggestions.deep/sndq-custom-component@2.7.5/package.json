{
  "name": "sndq-custom-component",
  "version": "2.7.5",
  "description": "A component used for SNDQ member",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "all": "rm -rf yarn.lock && rm -rf node_modules/ && rm -fr $TMPDIR/metro* && yarn install",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepack": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn install",
    "prepare": "husky install",
    "format": "prettier --write ."
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sndqapp/draftbit-custom-component"
  },
  "author": "binh.huynh@5gl.dev <binh.huynh@5gl.dev> (https://github.com/binhhuynh5gl)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/binhhuynh5gl/draftbit-custom-component/issues"
  },
  "homepage": "https://github.com/sndqapp/draftbit-custom-component",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.2.2",
    "@react-native-community/datetimepicker": "^6.7.3",
    "@react-native-community/eslint-config": "^3.0.2",
    "@react-native-picker/picker": "^2.4.8",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.35",
    "@types/react-native": "^0.71.5",
    "commitlint": "^17.0.2",
    "del-cli": "^5.0.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "expo-application": "^5.1.1",
    "expo-auth-session": "~4.0.3",
    "expo-crypto": "~12.2.1",
    "expo-localization": "^14.3.0",
    "expo-random": "^13.1.1",
    "expo-web-browser": "~12.1.1",
    "husky": "^8.0.0",
    "i18n-js": "^4.2.3",
    "install-peers": "^1.0.4",
    "jest": "^28.1.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "*",
    "react-native": "*",
    "react-native-builder-bob": "^0.20.4",
    "react-native-svg": "^13.4.0",
    "release-it": "^15.0.0",
    "typescript": "^4.5.2",
    "react-native-safe-area-context": "4.5.0",
    "@react-navigation/native": "^5.9.8"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": "^6.7.3",
    "@react-native-picker/picker": "^2.4.8",
    "expo-application": "^5.1.1",
    "expo-auth-session": "~4.0.3",
    "expo-crypto": "~12.2.1",
    "expo-random": "^13.1.1",
    "expo-web-browser": "~12.1.1",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "^13.4.0",
    "react-native-web": "~0.18.9",
    "@react-navigation/native": "^5.9.8"
  },
  "engines": {
    "node": ">= 16.0.0"
  },
  "packageManager": "^yarn@1.22.15",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false,
          "endOfLine": "auto"
        }
      ]
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "directories": {
    "example": "example"
  },
  "dependencies": {
    "@hookform/error-message": "^2.0.1",
    "@react-native-community/netinfo": "^9.4.1",
    "@react-native-seoul/masonry-list": "^1.4.2",
    "briicks-draftbit-icon": "0.1.9",
    "expo-linear-gradient": "~12.0.1",
    "expo-modules-core": "~1.0.4",
    "expo-sqlite-orm": "^2.0.3",
    "react-hook-form": "^7.43.9",
    "react-native-fullwidth-image": "^0.1.3",
    "react-native-google-places-autocomplete": "^2.5.1",
    "react-native-mask-input": "^1.2.3",
    "react-native-pager-view": "6.1.2",
    "react-native-progress": "^5.0.0",
    "react-native-reanimated": "^3.1.0",
    "react-native-smooth-pincode-input": "^1.0.9",
    "react-native-tab-view": "3.4.0",
    "react-native-text-link": "^1.0.0",
    "rxjs": "7.8.1",
    "usehooks-ts": "^2.9.1",
    "expo-file-system": "~15.2.2"
  }
}
