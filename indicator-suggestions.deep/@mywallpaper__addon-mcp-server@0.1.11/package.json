{
  "name": "@mywallpaper/addon-mcp-server",
  "version": "0.1.11",
  "description": "MCP server exposing MyWallpaper addon authoring and local dev tools to MCP-compatible agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mywallpaper-addon-mcp": "./dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "dist/index.js",
    "dist/types",
    "README.md"
  ],
  "scripts": {
    "build:assets": "pnpm -C ../docs-site build:api && node scripts/generate-assets.mjs",
    "build": "npm run build:assets && pnpm -C ../addon-schema build && pnpm -C ../addon-dev build && tsc --noEmit && node scripts/bundle.mjs && tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist-tests/test.js",
    "typecheck": "npm run build:assets && tsc --noEmit"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@mywallpaper/addon-dev": "^0.1.3",
    "typescript": "~5.8.3"
  },
  "devDependencies": {
    "@mywallpaper/addon-schema": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.25.0",
    "semver": "^7.7.2"
  },
  "keywords": ["mywallpaper", "mcp", "model-context-protocol", "addon", "llm"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0"
  }
}
