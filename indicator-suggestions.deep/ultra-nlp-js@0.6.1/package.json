{
  "name": "ultra-nlp-js",
  "version": "0.6.1",
  "description": "An ultra-nlp binding for Node.js.",
  "keywords": [
    "rust",
    "native"
  ],
  "files": [
    "lib",
    "src",
    "native/src",
    "native/Cargo.lock",
    "native/Cargo.toml"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": "git@github.com:BlackGlory/ultra-nlp-js.git",
  "author": "BlackGlory <woshenmedoubuzhidao@blackglory.me>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "ts-patch install -s",
    "install": "neon build --release && rimraf native/target",
    "lint": "eslint --quiet src __tests__",
    "test": "vitest --run",
    "prepublishOnly": "run-s prepare clean build",
    "clean": "run-p clean:*",
    "clean:rs": "neon clean",
    "clean:ts": "rimraf lib",
    "build": "run-p build:*",
    "build:rs": "neon build --release",
    "build:ts": "tsc --project tsconfig.build.json --target es2018",
    "bench": "run-s bench:*",
    "bench:substring-by-bytes": "tsx benches/substring-by-bytes.ts",
    "bench:segment": "tsx benches/segment.ts",
    "release": "standard-version"
  },
  "husky": {
    "hooks": {
      "pre-commit": "run-s prepare lint build test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "devDependencies": {
    "@blackglory/go": "^2.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.1",
    "@node-rs/jieba": "^2.0.1",
    "@types/node": "22",
    "eslint": "^9.30.1",
    "extra-benchmark": "^0.2.4",
    "extra-filesystem": "^0.5.2",
    "husky": "4",
    "iterable-operator": "^5.1.0",
    "npm-run-all": "^4.1.5",
    "pretty-bytes": "7.0.0",
    "return-style": "^3.0.1",
    "standard-version": "^9.5.0",
    "ts-patch": "^3.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "typescript-transform-paths": "^3.5.5",
    "vite": "^7.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@blackglory/prelude": "^0.4.0",
    "extra-lazy": "^2.0.2",
    "justypes": "^4.4.1",
    "neon-cli": "^0.10.1",
    "rimraf": "^6.0.1"
  }
}
