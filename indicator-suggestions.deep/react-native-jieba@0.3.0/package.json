{
  "name": "react-native-jieba",
  "version": "0.3.0",
  "description": "Native Chinese text segmentation for React Native, powered by cppjieba.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/generated",
    "android/src",
    "ios/OnLoad.mm",
    "ios/generated",
    "cpp/JiebaImpl.h",
    "cpp/JiebaImpl.cpp",
    "cpp/JiebaDictAndroid.h",
    "cpp/JiebaDictAndroid.cpp",
    "cpp/cppjieba/LICENSE",
    "cpp/cppjieba/include/cppjieba",
    "cpp/cppjieba/deps/limonp/LICENSE",
    "cpp/cppjieba/deps/limonp/include/limonp",
    "cpp/cppjieba/dict/jieba.dict.utf8",
    "cpp/cppjieba/dict/hmm_model.utf8",
    "cpp/cppjieba/dict/idf.utf8",
    "cpp/cppjieba/dict/stop_words.utf8",
    "cpp/cppjieba/dict/user.dict.utf8",
    "*.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-jieba-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version",
    "web": "vite",
    "build:web": "vite build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "turbo-module",
    "jieba",
    "cppjieba",
    "chinese",
    "segmentation",
    "tokenizer",
    "nlp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/react-native-jieba.git"
  },
  "author": "Leon Si <leon@leonsilicon.com> (https://github.com/leonsilicon)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leonsilicon/react-native-jieba/issues"
  },
  "homepage": "https://github.com/leonsilicon/react-native-jieba#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/react": "^19.2.0",
    "commitlint": "^20.5.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "jieba-wasm": "^2.4.0",
    "lefthook": "^2.1.4",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-web": "~0.21.1",
    "release-it": "^19.2.4",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "jieba-wasm": ">=2.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.85.0"
  },
  "peerDependenciesMeta": {
    "jieba-wasm": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ],
      "codegen"
    ]
  },
  "codegenConfig": {
    "name": "JiebaSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.jieba"
    },
    "includesGeneratedCode": true
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it",
      "vite"
    ],
    "version": "0.62.0"
  }
}
