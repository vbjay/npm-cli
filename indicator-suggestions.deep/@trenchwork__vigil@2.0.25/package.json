{
  "name": "@trenchwork/vigil",
  "version": "2.0.25",
  "description": "Vigil — a defensive-cyber terminal agent for Computer Network Defense. Asset discovery, vulnerability assessment, hardening, detection engineering, threat hunting, incident response — on the infrastructure you defend.",
  "deepseek": {
    "rulebookSchema": "src/contracts/schemas/agent-rules.schema.json"
  },
  "main": "dist/bin/vigil.js",
  "exports": {
    ".": "./dist/bin/vigil.js",
    "./lean": "./dist/leanAgent.js",
    "./capabilities": "./dist/capabilities/index.js",
    "./orchestration": "./dist/orchestration/index.js",
    "./tools": "./dist/tools/public/index.js",
    "./tools/exploit-chain": "./dist/tools/public/exploitChain.js",
    "./tools/anvilwing": "./dist/tools/public/anvilwing.js",
    "./tools/forge": "./dist/tools/public/forge.js",
    "./tools/glasshouse": "./dist/tools/public/glasshouse.js",
    "./tools/crucible": "./dist/tools/public/crucible.js",
    "./tools/chimera": "./dist/tools/public/chimera.js",
    "./tools/oculus": "./dist/tools/public/oculus.js",
    "./tools/lattice": "./dist/tools/public/lattice.js",
    "./tools/aegis": "./dist/tools/public/aegis.js"
  },
  "type": "module",
  "files": [
    "dist",
    "scripts/postinstall.cjs",
    "scripts/_ghidra-headless.mjs",
    "scripts/_vulnerability-discovery.mjs",
    "scripts/_regression-analysis.mjs",
    "scripts/_sbom-builder.mjs",
    "scripts/_kev-monitor.mjs",
    "scripts/_finding-enricher.mjs",
    "scripts/_secret-scan.mjs",
    "scripts/_nmap-cve-pipeline.mjs",
    "scripts/_dns-recon.mjs",
    "scripts/_threat-intel.mjs",
    "scripts/ghidra-mcp-server.mjs",
    "scripts/kali-tools-mcp.mjs",
    "scripts/network-defense-mcp.mjs",
    "scripts/threat-feed-mcp.mjs",
    "scripts/endpoint-defense-mcp.mjs",
    "scripts/cloud-security-mcp.mjs",
    "scripts/api-security-mcp.mjs",
    "scripts/vigil-sse-server.mjs",
    "scripts/vigil-autofix.mjs",
    "scripts/vigil-daemon.mjs",
    "scripts/vigil-run.mjs",
    "scripts/install-vigil.sh",
    "scripts/install-ghidra.ps1",
    "scripts/safe-validators",
    "tools/ghidra",
    "README.md",
    "agents",
    "LICENSE"
  ],
  "bin": {
    "vigil": "dist/bin/vigil.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "prebuild": "npm run clean",
    "clean": "node -e \"const { rmSync } = require('fs'); for (const target of ['dist', '.tsbuildinfo']) { try { rmSync(target, { recursive: true, force: true, maxRetries: 10 }); } catch (error) { console.warn('Clean warning:', error.code, 'for', target); } }\"",
    "build": "tsc -p tsconfig.json --skipLibCheck || true",
    "build:watch": "tsc --watch",
    "build:prod": "NODE_ENV=production MINIFY=true npm run build",
    "optimize": "node scripts/optimize-build.mjs",
    "release": "chmod +x scripts/create-release.sh && scripts/create-release.sh patch",
    "release:minor": "chmod +x scripts/create-release.sh && scripts/create-release.sh minor",
    "release:major": "chmod +x scripts/create-release.sh && scripts/create-release.sh major",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "postbuild": "node scripts/postbuild.mjs",
    "cli": "node dist/bin/vigil.js",
    "dev": "node --loader ts-node/esm src/bin/vigil.ts",
    "dev:watch": "node --watch --loader ts-node/esm src/bin/vigil.ts",
    "start": "node dist/bin/vigil.js",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "lint": "eslint src/**/*.ts --max-warnings 200",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "analyze": "node scripts/vigil-run.mjs scripts/security-analysis.mjs",
    "analyze:local": "node scripts/vigil-run.mjs scripts/security-analysis.mjs --local",
    "cve": "node scripts/vigil-run.mjs scripts/_cve-lookup.mjs --text",
    "cve:json": "node scripts/vigil-run.mjs scripts/_cve-lookup.mjs --json",
    "vuln:discover": "node scripts/vigil-run.mjs scripts/_vulnerability-discovery.mjs --emit-vigil-findings",
    "vuln:comprehensive": "node scripts/vigil-run.mjs scripts/_vigil-comprehensive.mjs",
    "vuln:poc": "node scripts/vigil-run.mjs scripts/_poc-engine.mjs",
    "vuln:eccn": "node scripts/vigil-run.mjs scripts/_eccn-classifier.mjs",
    "vuln:all": "node scripts/vigil-run.mjs scripts/_vigil-comprehensive.mjs && node scripts/vigil-run.mjs scripts/_poc-engine.mjs && node scripts/vigil-run.mjs scripts/_eccn-classifier.mjs",
    "regression:analysis": "node scripts/vigil-run.mjs scripts/_regression-analysis.mjs",
    "eccn:chain": "node scripts/eccn-capability-chain.mjs",
    "eccn:fix": "node scripts/_eccn-comprehensive-fix.mjs",
    "eccn:fix:offline": "node scripts/_eccn-comprehensive-fix.mjs --offline",
    "eccn:fix:report": "node scripts/_eccn-comprehensive-fix.mjs --out ./security-analysis/eccn-comprehensive-fix",
    "ghidra:probe": "node scripts/vigil-run.mjs scripts/_ghidra-headless.mjs --probe",
    "ghidra:analyze": "node scripts/vigil-run.mjs scripts/_ghidra-headless.mjs",
    "ghidra:mcp": "node scripts/vigil-run.mjs scripts/ghidra-mcp-server.mjs",
    "ghidra:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-ghidra.ps1",
    "kev:monitor": "node scripts/vigil-run.mjs scripts/_kev-monitor.mjs",
    "kev:new": "node scripts/vigil-run.mjs scripts/_kev-monitor.mjs --top 20",
    "sbom": "node scripts/vigil-run.mjs scripts/_sbom-builder.mjs --text --emit-vigil-findings",
    "sbom:json": "node scripts/vigil-run.mjs scripts/_sbom-builder.mjs --json",
    "sbom:ci": "node scripts/vigil-run.mjs scripts/_sbom-builder.mjs --json --no-vuln",
    "findings:enrich": "node scripts/vigil-run.mjs scripts/_finding-enricher.mjs",
    "findings:enrich:dry": "node scripts/vigil-run.mjs scripts/_finding-enricher.mjs --dry-run",
    "code:risky": "node scripts/vigil-run.mjs scripts/_risky-code-scan.mjs",
    "advisory": "node scripts/vigil-run.mjs scripts/_advisory-investigation.mjs",
    "inventory": "node scripts/vigil-run.mjs scripts/_cnd-inventory.mjs",
    "leaks": "node scripts/vigil-run.mjs scripts/_secret-scan.mjs --emit-vigil-findings",
    "leaks:json": "node scripts/vigil-run.mjs scripts/_secret-scan.mjs --json",
    "nmap": "node scripts/vigil-run.mjs scripts/_nmap-cve-pipeline.mjs --emit-vigil-findings",
    "nmap:json": "node scripts/vigil-run.mjs scripts/_nmap-cve-pipeline.mjs --json",
    "dns": "node scripts/vigil-run.mjs scripts/_dns-recon.mjs --emit-vigil-findings",
    "dns:json": "node scripts/vigil-run.mjs scripts/_dns-recon.mjs --json",
    "ti": "node scripts/vigil-run.mjs scripts/_threat-intel.mjs --emit-vigil-findings",
    "ti:json": "node scripts/vigil-run.mjs scripts/_threat-intel.mjs --json",
    "autofix": "node scripts/vigil-autofix.mjs",
    "autofix:apply": "node scripts/vigil-autofix.mjs --commit",
    "autofix:dry": "node scripts/vigil-autofix.mjs --dry-run",
    "daemon": "node scripts/vigil-daemon.mjs",
    "daemon:watch": "node scripts/vigil-daemon.mjs --interval 30",
    "kali:mcp": "node scripts/vigil-run.mjs scripts/kali-tools-mcp.mjs",
    "netdef:mcp": "node scripts/vigil-run.mjs scripts/network-defense-mcp.mjs",
    "threatfeed:mcp": "node scripts/vigil-run.mjs scripts/threat-feed-mcp.mjs",
    "threat:intel": "node scripts/threat-actor-intel.mjs",
    "unified:deploy": "node scripts/unified-deploy.mjs",
    "endpoint:mcp": "node scripts/vigil-run.mjs scripts/endpoint-defense-mcp.mjs",
    "install:universal": "bash scripts/install-vigil.sh",
    "docker:build": "docker build -t trenchwork/vigil:latest .",
    "docker:run": "docker run -it -v $(pwd):/workspace trenchwork/vigil:latest vigil",
    "cloud:mcp": "node scripts/vigil-run.mjs scripts/cloud-security-mcp.mjs",
    "cloud:k8s": "node scripts/vigil-run.mjs scripts/cloud-security-mcp.mjs",
    "cloud:aws": "node scripts/vigil-run.mjs scripts/cloud-security-mcp.mjs",
    "api:mcp": "node scripts/vigil-run.mjs scripts/api-security-mcp.mjs",
    "api:scan": "node scripts/vigil-run.mjs scripts/api-security-mcp.mjs",
    "sse:server": "node scripts/vigil-sse-server.mjs",
    "ec2:deploy": "bash aws/scripts/deploy-ec2-scheduler.sh",
    "ec2:run": "bash aws/scripts/deploy-ec2-scheduler.sh erosolar-api --run-now",
    "aws:deploy": "bash aws/scripts/deploy.sh",
    "health": "node scripts/health-check.mjs --update-site",
    "health:json": "node scripts/health-check.mjs"
  },
  "keywords": [
    "cnd",
    "computer-network-defense",
    "defensive-cyber",
    "blue-team",
    "detection-engineering",
    "incident-response",
    "vulnerability-assessment",
    "threat-hunting",
    "hardening",
    "sigma",
    "mitre-attack",
    "ai",
    "cli",
    "agent",
    "llm",
    "deepseek"
  ],
  "author": "Trenchwork <bo@trenchwork.org> (https://trenchwork.org)",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aroxora/deepseek-coder-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Aroxora/deepseek-coder-cli/issues"
  },
  "homepage": "https://github.com/Aroxora/deepseek-coder-cli#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.4",
    "@types/glob": "^8.1.0",
    "@types/gradient-string": "^1.1.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.3",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "@xterm/headless": "^6.0.0",
    "babel-jest": "^30.4.1",
    "eslint": "9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "firebase-tools": "^15.20.0",
    "ink-testing-library": "^4.0.0",
    "jest": "30.2.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^8.0.11",
    "ts-jest": "29.4.6",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "optionalDependencies": {
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-spinners": "^3.4.0",
    "gradient-string": "^3.0.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "nanospinner": "1.2.2",
    "open": "^11.0.0",
    "openai": "^6.42.0",
    "ora": "^9.4.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1",
    "typescript": "5.9.3",
    "zod": "^3.25.76"
  }
}
