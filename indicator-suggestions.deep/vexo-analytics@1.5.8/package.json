{
  "name": "vexo-analytics",
  "version": "1.5.8",
  "description": "The analytics tool for React Native.",
  "main": "lib/dist/index",
  "types": "lib/dist/index.d.ts",
  "react-native": "lib/dist/index",
  "source": "src",
  "files": [
    "android",
    "ios",
    "RNVexoAnalytics.podspec",
    "lib/dist",
    "!src/__tests__",
    "!src/asyncStorage",
    "!src/deviceInfo",
    "!src/vexo",
    "!src/viewShot",
    "!src/index",
    "!dependencies",
    "!lib/commonjs",
    "!lib/module",
    "!lib/typescript",
    "!lib/dist/index.js.LICENSE.txt",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build && node_modules/.bin/webpack",
    "release": "dotenv release-it -- --no-increment",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn && yarn example pods"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/vexotech/vexo-analytics.git",
  "author": "vexo <developer@vexo.co> (https://vexo.co)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vexotech/vexo-analytics.git/issues"
  },
  "homepage": "https://github.com/vexotech/vexo-analytics.git#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "async-mutex": "^0.4.0",
    "moment": "^2.24.0",
    "react-native-url-polyfill": "^1.3.0",
    "react-native-uuid": "^2.0.1"
  },
  "devDependencies": {
    "@arkweid/lefthook": "^0.7.7",
    "@babel/core": "^7.18.13",
    "@babel/eslint-parser": "^7.18.2",
    "@babel/preset-env": "^7.18.10",
    "@babel/preset-flow": "^7.18.6",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.21.5",
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native-community/eslint-config": "^3.0.2",
    "@react-navigation/native": "^5.1.5",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^28.1.2",
    "@types/react": "~18.2.6",
    "@types/react-native": "0.72.2",
    "babel-loader": "^8.2.5",
    "commitlint": "^17.0.2",
    "copy-webpack-plugin": "^11.0.0",
    "dotenv-cli": "^7.0.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.32.2",
    "jest": "^28.1.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-builder-bob": "^0.18.3",
    "release-it": "^15.0.0",
    "typescript": "^4.5.2",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "resolutions": {
    "@types/react": "17.0.21"
  },
  "peerDependencies": {
    "@react-navigation/native": ">= 5.1.5",
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/dependencies"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "never",
        [
          "upper-case",
          "pascal-case",
          "start-case"
        ]
      ]
    }
  },
  "release-it": {
    "git": {
      "commit": false,
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "requireConfigFile": false,
      "ecmaFeatures": {
        "jsx": true
      },
      "babelOptions": {
        "presets": [
          "@babel/preset-react"
        ]
      }
    },
    "extends": [
      "eslint:recommended",
      "@react-native-community",
      "prettier",
      "plugin:react/recommended"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false,
          "jsxBracketSameLine": true
        }
      ],
      "react-hooks/exhaustive-deps": "off",
      "react/prop-types": "off",
      "react/display-name": "off"
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "dependencies/",
    "src/asyncStorage",
    "src/deviceInfo",
    "src/viewShot"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
