{
  "name": "minovative-mind-cli",
  "description": "An automated AI agent powered by Vertex AI that helps you write software",
  "version": "2.2.5",
  "author": "Daniel Ward",
  "bin": {
    "minovative-mind-cli": "bin/run.js"
  },
  "bugs": "https://github.com/quarantiine/minovative-mind-cli/issues",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@google/generative-ai": "^0.21.0",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "dotenv": "^16",
    "fastest-levenshtein": "^1.0.16",
    "gradient-string": "^3.0.0",
    "marked": "^12.0.2",
    "marked-terminal": "^7.0.0",
    "picocolors": "^1",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/marked-terminal": "^6.1.1",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "@types/update-notifier": "^6.0.8",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/quarantiine/minovative-mind-cli",
  "keywords": [
    "oclif",
    "ai",
    "coding-agent",
    "gemini",
    "vertex-ai",
    "cli"
  ],
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "minovative-mind-cli",
    "dirname": "minovative-mind-cli",
    "default": "chat",
    "commands": "./dist/commands",
    "helpClass": "./dist/help.js",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quarantiine/minovative-mind-cli.git"
  },
  "scripts": {
    "build": "shx rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "prepare": "npm run build",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme --no-source-links",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "test:regression": "NODE_NO_WARNINGS=1 mocha --node-option loader=ts-node/esm test/regression/regression.test.ts",
    "version": "oclif readme --no-source-links && git add README.md"
  },
  "types": "dist/index.d.ts"
}
