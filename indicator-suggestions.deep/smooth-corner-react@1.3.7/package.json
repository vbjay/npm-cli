{
  "name": "smooth-corner-react",
  "version": "1.3.7",
  "description": "A React component for creating smooth rounded corners with configurable border radius, using WebAssembly for high-performance calculations.",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "cjs/",
    "esm/",
    "src/",        
    "src/wasm/",   
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "echo 'no tests in published package'",
    "postinstall": "echo 'smooth-corner-react (prebuilt) installed'"
  },
  "keywords": [
    "react",
    "component",
    "corner",
    "radius",
    "webassembly",
    "wasm",
    "ios",
    "continuous",
    "performance",
    "clip-path",
    "svg"
  ],
  "author": "Eason <eason@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jobsfield/smooth-corner.git"
  },
  "bugs": {
    "url": "https://github.com/jobsfield/smooth-corner/issues"
  },
  "homepage": "https://github.com/jobsfield/smooth-corner#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "rollup": "^4.9.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
