{
    "name": "centaurus-cli",
    "version": "3.3.1",
    "description": "A powerful command-line AI coding assistant with Google Gemini support",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "centaurus": "dist/index.js",
        "centaurus-cli": "dist/index.js"
    },
    "scripts": {
        "build": "tsc --noEmit && tsup && npm run build:vscode-ext",
        "build:vscode-ext": "node scripts/build-vscode-ext.cjs",
        "build:classifier-data": "node scripts/generate-classifier-data.cjs",
        "classify": "node scripts/classify.mjs",
        "typecheck": "tsc --noEmit",
        "dev": "tsup --watch",
        "start": "node dist/index.js",
        "prepublishOnly": "npm run build",
        "postinstall": "node postinstall.js || true",
        "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs",
        "test:ci": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --ci --forceExit"
    },
    "keywords": [
        "ai",
        "cli",
        "coding-assistant",
        "gemini",
        "agentic",
        "code-editor",
        "ai-assistant",
        "terminal",
        "developer-tools",
        "llm",
        "artificial-intelligence"
    ],
    "author": "Rohan Abhilash S",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0 <25.0.0"
    },
    "files": [
        "dist",
        "prompts",
        "models",
        "postinstall.js",
        "scripts/patch-fasttext-binary.cjs",
        "scripts/build-exit-addon.cjs",
        "scripts/install-shell-hook.cjs",
        "native/exit-addon/binding.gyp",
        "native/exit-addon/src/exit_addon.cc",
        "models-config.json",
        "README.md",
        "LICENSE",
        "CONFIG_GUIDE.md",
        "AUTH_FLOW.md"
    ],
    "dependencies": {
        "@anthropic-ai/sdk": "^0.74.0",
        "@crosscopy/clipboard": "^0.2.8",
        "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
        "@huggingface/transformers": "^3.8.1",
        "@modelcontextprotocol/sdk": "^1.24.2",
        "@types/sharp": "^0.31.1",
        "@xterm/headless": "^6.0.0",
        "axios": "^1.12.2",
        "better-sqlite3": "^12.11.1",
        "boxen": "^8.0.1",
        "chalk": "^5.6.2",
        "cheerio": "^1.1.2",
        "cli-highlight": "^2.1.11",
        "commander": "^14.0.1",
        "cross-spawn": "^7.0.6",
        "diff": "^8.0.2",
        "fast-glob": "^3.3.3",
        "ignore": "^7.0.5",
        "ink": "^4.4.1",
        "ink-select-input": "^5.0.0",
        "ink-spinner": "^5.0.0",
        "ink-text-input": "^5.0.1",
        "js-tiktoken": "^1.0.21",
        "marked": "^18.0.2",
        "open": "^10.1.0",
        "react": "^18.3.1",
        "sharp": "^0.34.5",
        "snowball-stemmers": "^0.6.0",
        "ssh2": "^1.15.0",
        "string-width": "^8.1.0",
        "strip-ansi": "^7.1.0",
        "tree-sitter-wasms": "^0.1.13",
        "typescript": "^5.9.3",
        "web-tree-sitter": "^0.25.10",
        "wrap-ansi": "^9.0.2",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/inquirer": "^9.0.9",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.7.2",
        "@types/react": "^18.3.26",
        "@types/ssh2": "^1.15.0",
        "@types/ws": "^8.18.1",
        "jest": "^30.2.0",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsup": "^8.5.1"
    },
    "optionalDependencies": {
        "clipboard-files": "^3.0.0",
        "fasttext": "^1.0.0"
    }
}
