{
  "name": "@squiz/dxp-cli-next",
  "version": "5.34.0",
  "repository": {
    "url": "https://gitlab.squiz.net/dxp/dxp-cli-next"
  },
  "files": [
    "bin/**/*",
    "dist/**/*"
  ],
  "bin": {
    "dxp-next": "./bin/dxp.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/bundle.js",
    "build:release": "npm run build && npm run bundle",
    "clean": "rm -rf ./lib/ ./dist/",
    "cm": "cz",
    "coverage": "codecov",
    "lint": "eslint ./src/ --fix",
    "prepare": "husky install",
    "semantic-release": "semantic-release",
    "test:watch": "jest --watch",
    "test": "jest --testPathIgnorePatterns=src/__tests__/smoke/validate.spec.ts",
    "test:smoke": "jest src/__tests__/smoke/validate.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@squiz/local-component-dev-ui": "0.6.21",
    "esbuild": "^0.21.5",
    "update-notifier": "5.1.0",
    "workerd": "^1.20250428.0"
  },
  "keywords": [
    "cli",
    "template",
    "typescript",
    "vscode",
    "jest",
    "husky",
    "commitizen",
    "semantic-release",
    "codecov"
  ],
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/gitlab": "9.4.2",
    "@semantic-release/npm": "9.0.1",
    "@squiz/component-cli-lib": "1.74.0",
    "@squiz/dx-logger-lib": "^1.65.1",
    "@squiz/dxp-porter-shared": "0.4.0",
    "@squiz/job-runner-lib": "2.3.0",
    "@types/cli-color": "2.0.2",
    "@types/inquirer": "8.2.6",
    "@types/jest": "29.5.14",
    "@types/node": "17.0.45",
    "@types/opener": "1.4.3",
    "@types/prompt": "^1.1.4",
    "@types/tough-cookie": "4.0.2",
    "@types/update-notifier": "5.1.0",
    "@typescript-eslint/eslint-plugin": "5.30.7",
    "@typescript-eslint/parser": "5.30.7",
    "@vercel/ncc": "^0.38.3",
    "axios": "1.11.0",
    "chalk": "4.1.2",
    "cli-color": "2.0.3",
    "codecov": "3.8.3",
    "commander": "9.4.0",
    "commitizen": "4.2.5",
    "cosmiconfig": "9.0.0",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "^16.3.1",
    "env-paths": "2.2.1",
    "esbuild": "^0.21.5",
    "eslint": "8.19.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "4.2.1",
    "execa": "5.1.1",
    "handlebars": "^4.7.8",
    "husky": "8.0.1",
    "inquirer": "8.2.5",
    "jest": "29.7.0",
    "lint-staged": "13.0.3",
    "nock": "^13.3.1",
    "opener": "1.5.2",
    "ora": "^5.4.1",
    "prettier": "2.7.1",
    "prompt": "^1.3.0",
    "semantic-release": "19.0.3",
    "supertest": "^6.3.4",
    "tough-cookie": "4.1.4",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.1",
    "typescript": "5.9.3",
    "update-notifier": "5.1.0",
    "yaml": "^2.3.4",
    "zod": "^3.23.8",
    "zod-validation-error": "^3.3.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.ts": "eslint --cache --cache-location .eslintcache --fix"
  },
  "release": {
    "branches": [
      "master",
      {
        "name": "develop",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "chore",
              "scope": "deps",
              "subject": "*@squiz/*",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "docs",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
