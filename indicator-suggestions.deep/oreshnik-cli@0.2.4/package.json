{
  "name": "oreshnik-cli",
  "version": "0.2.4",
  "description": "Git-native sprint management system — CLI-first, dashboard-optional",
  "keywords": [
    "sprint",
    "git",
    "project-management",
    "agile",
    "cli",
    "devtools",
    "team",
    "workflow",
    "zone-locking",
    "checkpoints"
  ],
  "homepage": "https://github.com/Cerberux77/oreshnik#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cerberux77/oreshnik"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "oreshnik": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "src/templates/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^1.5.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
