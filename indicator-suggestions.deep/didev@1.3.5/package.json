{
  "name": "didev",
  "version": "1.3.5",
  "description": "Professional AI-powered CLI for developers using DeepSeek API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "didev": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "templates",
    "README.md"
  ],
  "author": "neovaryag",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "setup-path": "bash scripts/setup-path.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "glob": "^13.0.6",
    "inquirer": "^9.2.20",
    "js-yaml": "^4.1.0",
    "ora": "^8.0.1",
    "undici": "^6.13.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "ai",
    "deepseek",
    "developer-tools",
    "code-review"
  ],
  "license": "MIT"
}
