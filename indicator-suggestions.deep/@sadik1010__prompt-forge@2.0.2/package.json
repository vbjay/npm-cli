{
  "name": "@sadik1010/prompt-forge",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.2",
  "description": "Universal prompt optimizer CLI — pipe any prompt through prompt-forge to get a compressed, structured ROLE/TASK/CONTEXT/RULES/OUTPUT version. Saves tokens, clarifies intent.",
  "bin": {
    "prompt-forge": "bin/prompt-forge"
  },
  "scripts": {
    "install-skill": "node scripts/install.js",
    "postinstall": "node scripts/install.js"
  },
  "files": [
    "bin/",
    "src/",
    "SKILL.md",
    "rules/",
    "scripts/",
    "commands/"
  ],
  "keywords": [
    "opencode",
    "skill",
    "prompt",
    "optimizer",
    "token-saver",
    "prompt-engineering",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadikbd/prompt-forge.git"
  },
  "engines": {
    "node": ">=14"
  }
}
