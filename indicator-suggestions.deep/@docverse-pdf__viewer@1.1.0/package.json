{
  "name": "@docverse-pdf/viewer",
  "version": "1.1.0",
  "description": "DocVerse — PDF viewer & editor SDK with WASM engine",
  "type": "module",
  "main": "dist/pdfre-viewer.cjs",
  "module": "dist/pdfre-viewer.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pdfre-viewer.js",
      "require": "./dist/pdfre-viewer.cjs"
    },
    "./wasm/*": "./wasm/*",
    "./setup": "./scripts/setup.mjs"
  },
  "bin": {
    "docverse-setup": "./scripts/setup.mjs"
  },
  "files": [
    "dist",
    "wasm",
    "scripts"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/setup.mjs --auto"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.1.2"
  },
  "license": "MIT",
  "keywords": [
    "pdf",
    "viewer",
    "editor",
    "annotations",
    "xfdf",
    "wasm",
    "webassembly",
    "docverse"
  ],
  "dependencies": {
    "jsqr": "^1.4.0",
    "tesseract.js": "^7.0.0"
  }
}
