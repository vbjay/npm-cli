{
  "name": "tyrion-git-mcp",
  "version": "0.0.1",
  "description": "Revolutionary Git MCP with Rust+WASM+TypeScript - 3x-10x performance boost vs traditional solutions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tyrion-git-mcp": "./dist/index.js"
  },
  "scripts": {
    "build:wasm": "wasm-pack build --target nodejs --out-dir pkg --release --scope tyrion",
    "build:ts": "tsc && chmod +x dist/index.js",
    "build": "npm run build:wasm && npm run build:ts",
    "dev:wasm": "wasm-pack build --target nodejs --out-dir pkg --dev --scope tyrion",
    "dev:ts": "tsc -w",
    "dev": "concurrently \"npm run dev:wasm\" \"npm run dev:ts\"",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "test:performance": "node benchmarks/run-benchmarks.js",
    "test:watch": "jest --watch",
    "lint": "eslint typescript/**/*.ts src/**/*.rs --ext .ts,.rs",
    "start": "node dist/index.js",
    "prepare": "echo 'Tyrion Git MCP v0.0.1 - Package prepared with Lannister precision'",
    "clean": "rm -rf dist pkg node_modules/.cache target",
    "package": "npm pack",
    "benchmark": "npm run test:performance",
    "validate": "npm run lint && npm run test && npm run test:integration"
  },
  "keywords": [
    "mcp",
    "git",
    "rust",
    "wasm", 
    "claude",
    "performance",
    "security",
    "typescript",
    "revolutionary",
    "tyrion",
    "lannister",
    "wine-enhanced",
    "3x-performance",
    "10x-performance",
    "cve-immunity",
    "memory-safety",
    "streaming",
    "zero-copy"
  ],
  "author": "cburtin",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.2",
    "wasm-pack": "^0.12.0"
  },
  "files": [
    "dist/",
    "pkg/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/house/tyrion-git-mcp-server"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}