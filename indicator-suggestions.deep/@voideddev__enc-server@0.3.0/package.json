{
  "name": "@voideddev/enc-server",
  "version": "0.3.0",
  "description": "Server-side hashing, compression, encryption, and fused artifact library backed by Rust",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "require": {
        "types": "./dist/native/index.d.cts",
        "default": "./dist/native/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "build:native": "node scripts/build-native.js",
    "build:all": "npm run build:native && npm run build",
    "copy:native": "node scripts/copy-native.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "node src/__tests__/run-all.mjs",
    "test:native": "node native/test-native.mjs",
    "test:integration": "node tests/integration.test.mjs",
    "test:all": "npm run test:native && npm run test:integration && npm run test",
    "dev": "tsup src/index.ts src/native/index.ts src/crypto-backend.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "npm run copy:native && npm run build"
  },
  "dependencies": {
    "hkdf": "^0.0.2"
  },
  "optionalDependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "fast-check": "^3.13.1",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "prebuilds",
    "scripts/postinstall.js"
  ],
  "keywords": [
    "encryption",
    "compression",
    "fused-shell",
    "security",
    "rust",
    "native"
  ],
  "license": "MIT"
}
