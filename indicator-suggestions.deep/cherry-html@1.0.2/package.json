{
  "name": "cherry-html",
  "version": "1.0.2",
  "description": "High-performance HTML parser and DOM manipulation library in Rust",
  "main": "index.js",
  "author": "dev.anurag.sah@gmail.com",
  "license": "MIT",
  "keywords": [
    "html",
    "parser",
    "dom",
    "cheerio",
    "napi-rs",
    "rust"
  ],
  "exports": {
    ".": "./index.js",
    "./cheerio": "./lib/cheerio.js",
    "./stream": "./lib/stream.js"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "lib/*.js",
    "lib/*.d.ts"
  ],
  "napi": {
    "binaryName": "cherry-html",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 14.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build:napi": "napi build --platform --release",
    "build:ts": "tsc",
    "build": "yarn build:napi && yarn build:ts",
    "build:debug": "napi build --platform && tsc",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "preversion": "napi build --platform && git add .",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@oxc-node/core": "^0.1.0",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "@types/node": "^26.0.0",
    "ava": "^8.0.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "mitata": "^1.0.34",
    "npm-run-all2": "^9.0.0",
    "oxlint": "^1.14.0",
    "parse5": "^8.0.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "yarn@4.17.0",
  "optionalDependencies": {
    "cherry-html-win32-x64-msvc": "1.0.2",
    "cherry-html-darwin-x64": "1.0.2",
    "cherry-html-linux-x64-gnu": "1.0.2",
    "cherry-html-darwin-arm64": "1.0.2"
  }
}