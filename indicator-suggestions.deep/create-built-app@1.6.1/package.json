{
  "name": "create-built-app",
  "version": "1.6.1",
  "description": "Node.js CLI for building Built.js themes, plugins and sites",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtjs/create-built-app.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "keywords": [
    "builtjs",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/builtjs/create-built-app.git"
  },
  "homepage": "https://github.com/builtjs/create-built-appi#readme",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "npm run build",
    "pretest": "npm run compile",
    "posttest": "npm run lint",
    "watch": "tsc --watch",
    "build": "NODE_ENV=production npm run compile",
    "build:dev": "NODE_ENV=development npm run compile && npm run obfuscate",
    "obfuscate": "find dist -type f -name '*.js' -exec sh -c 'tmpfile=$(mktemp /tmp/obfuscated.XXXXXX.js) && javascript-obfuscator \"$1\" --output \"$tmpfile\" && mv \"$tmpfile\" \"$1\"' _ {} \\;"
  },
  "author": "Richard Lovell",
  "dependencies": {
    "@ai-sdk/openai": "^1.3.7",
    "@babel/parser": "^7.24.8",
    "ai": "^4.3.2",
    "axios": "^0.26.0",
    "camel-to-kebab": "^1.1.2",
    "chalk": "^4.1.2",
    "cloudinary": "^2.5.1",
    "colors": "^1.4.0",
    "commander": "^9.0.0",
    "conf": "^10.1.1",
    "dotenv": "^16.4.5",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.1.0",
    "glob": "^7.2.0",
    "inquirer": "^10.0.4",
    "kebab-case": "^1.0.2",
    "lodash": "^4.17.21",
    "nanoid": "^5.0.9",
    "@sanity/client": "^6.15.0",
    "openai": "^4.77.0",
    "pluralize": "^8.0.0",
    "prettier": "^3.3.2",
    "ps-list": "^8.1.1"
  },
  "optionalDependencies": {
    "puppeteer": "^21.5.2"
  },
  "bin": {
    "create-built-app": "./dist/index.js"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/lodash": "^4.17.6",
    "@types/node": "^14.11.2",
    "@types/pluralize": "^0.0.33",
    "gts": "^3.1.1",
    "javascript-obfuscator": "^4.1.1",
    "terser": "^5.37.0",
    "typescript": "^5.5.3"
  }
}
