{
  "name": "tura-ai",
  "version": "0.1.30",
  "description": "Local AI coding system with Rust services, command packages, TUI, and GUI workspaces.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Tura",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "cli",
    "tui",
    "tauri",
    "rust"
  ],
  "homepage": "https://turaai.net/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tura-AI/tura.git"
  },
  "bugs": {
