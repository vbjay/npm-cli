  },
  "optionalDependencies": {
    "tura-darwin-arm64": "0.1.30",
    "tura-darwin-x64": "0.1.30",
    "tura-linux-x64": "0.1.30",
    "tura-win32-x64": "0.1.30"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
