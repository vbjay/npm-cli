{
  "name": "@rznet/rz-gamespace-sdk-react-native",
  "version": "0.6.2",
  "description": "Gamespace SDK for RN",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @rznet/react-native-gamespace-sdk-example",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "release": "npm publish --access public"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.rznet.com/gamespace/react-native-gamespace-sdk.git.git"
  },
  "author": "Aung Chan Oo <Aungchan.O@rznet.com> (https://gitlab.rznet.com/aung)",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.rznet.com/gamespace/react-native-gamespace-sdk.git/issues"
  },
  "homepage": "https://gitlab.rznet.com/gamespace/react-native-gamespace-sdk.git#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-native-community/netinfo": "^11.1.1",
    "@react-native-firebase/app": "^18.7.3",
    "@react-native-firebase/messaging": "^18.7.3",
    "@react-native/babel-preset": "^0.74.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-navigation/bottom-tabs": "^6.5.9",
    "@react-navigation/native": "^6.1.8",
    "@react-navigation/stack": "^6.3.18",
    "@reduxjs/toolkit": "^1.9.6",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^28.1.2",
    "@types/react-native-vector-icons": "^6.4.18",
    "aws-cloudwatch-log-browser": "^0.1.3",
    "axios": "^1.5.1",
    "commitlint": "^17.0.2",
    "dayjs": "^1.11.10",
    "del-cli": "^5.0.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^28.1.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "18.2.0",
    "react-native": "^0.72.5",
    "react-native-animatable": "^1.3.3",
    "react-native-builder-bob": "^0.23.2",
    "react-native-config": "^1.5.1",
    "react-native-device-info": "^10.11.0",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-gesture-handler": "^2.13.4",
    "react-native-google-mobile-ads": "^12.3.0",
    "react-native-localize": "^3.0.3",
    "react-native-pager-view": "^6.2.3",
    "react-native-permissions": "^4.0.4",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "^3.6.1",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "~3.22.0",
    "react-native-sensitive-info": "^6.0.0-alpha.9",
    "react-native-svg": "^13.14.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-vector-icons": "^10.0.2",
    "react-native-video": "^5.2.1",
    "react-native-webview": "^13.6.4",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.4.2",
    "release-it": "^15.0.0",
    "turbo": "^1.10.7",
    "typescript": "^5.0.2"
  },
  "peerDependencies": {
    "aws-cloudwatch-log-browser": "^0.1.3",
    "axios": "^1.5.1",
    "dayjs": "^1.11.10",
    "react": "*",
    "react-native": "*",
    "react-native-animatable": "^1.3.3",
    "react-native-progress": "^5.0.1",
    "react-native-responsive-fontsize": "^0.5.1"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": ">= 18.0.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "access": "public"
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ],
      "no-unused-vars": "warn",
      "@typescript-eslint/no-unused-vars": "warn",
      "react-hooks/exhaustive-deps": "warn",
      "react/react-in-jsx-scope": "warn",
      "react-native/no-inline-styles": "warn"
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
