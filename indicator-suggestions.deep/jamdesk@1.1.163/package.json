{
  "name": "jamdesk",
  "version": "1.1.163",
  "description": "CLI for Jamdesk — build, preview, and deploy documentation sites from MDX. Dev server with hot reload, 50+ components, OpenAPI support, AI search, and Mintlify migration",
  "keywords": [
    "jamdesk",
    "documentation",
    "documentation-generator",
    "documentation-platform",
    "documentation-tool",
    "docs",
    "docs-as-code",
    "docs-generator",
    "mdx",
    "markdown",
    "cli",
    "developer-tools",
    "api-documentation",
    "openapi",
    "api-reference",
    "static-site-generator",
    "nextjs",
    "react",
    "typescript",
    "technical-writing",
    "mintlify",
    "mintlify-alternative",
    "docusaurus-alternative",
    "gitbook-alternative",
    "documentation-hosting",
    "documentation-site",
    "developer-documentation",
    "api-docs",
    "docs-site-generator",
    "ai-search",
    "llms-txt"
  ],
  "homepage": "https://www.jamdesk.com",
  "bugs": {
    "url": "https://github.com/jamdesk/jamdesk-cli/issues",
    "email": "support@jamdesk.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamdesk/jamdesk-cli.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Jamdesk",
    "email": "support@jamdesk.com",
    "url": "https://www.jamdesk.com"
  },
  "type": "module",
  "bin": {
    "jamdesk": "bin/jamdesk.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "scripts/patch-openapi-schemas.js",
    "scripts/install-banner.js",
    "scripts/banner.txt",
    "templates/",
    "vendored/components/",
    "vendored/contexts/",
    "vendored/hooks/",
    "vendored/themes/",
    "vendored/lib/",
    "vendored/shared/",
    "vendored/scripts/",
    "vendored/app/",
    "vendored/public/_jd/fonts/fontawesome/",
    "vendored/public/_jd/branding/",
    "vendored/schema/",
    "vendored/next.config.js",
    "vendored/tailwind.config.ts",
    "vendored/postcss.config.mjs",
    "vendored/tsconfig.json",
    "vendored/workspace-package-lock.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "vendor": "node scripts/vendor.js",
    "generate-workspace-lockfile": "node scripts/generate-workspace-lockfile.js",
    "verify:workspace-lockfile": "node scripts/verify-workspace-lockfile.js",
    "security-check": "node scripts/security-check.js",
    "prepublishOnly": "npm run vendor && npm run build && npm run security-check",
    "publish:npm": "node scripts/publish.js npm",
    "publish:github": "node scripts/publish.js github",
    "publish:dry": "node scripts/publish.js npm --dry-run",
    "test": "vitest",
    "test:local": "node scripts/test-local.js",
    "lint": "eslint src/",
    "dev": "tsc --watch",
    "postinstall": "node scripts/patch-openapi-schemas.js && node scripts/install-banner.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@inquirer/prompts": "^8.4.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "dictionary-en": "^4.0.0",
    "estree-util-visit": "^2.0.0",
    "fastest-levenshtein": "^1.0.16",
    "fs-extra": "^11.2.0",
    "github-slugger": "^2.0.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.5",
    "json5": "^2.2.3",
    "nspell": "^2.1.5",
    "open": "^11.0.0",
    "ora": "^9.4.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tar": "^7.5.15",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
