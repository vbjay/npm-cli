{
  "name": "create-beignet",
  "version": "0.0.34",
  "type": "module",
  "description": "Create a new Beignet app with one command.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "create-beignet": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test-d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepack": "bun run build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist coverage .turbo",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome check ."
  },
  "keywords": [
    "contract",
    "api",
    "typescript",
    "cli",
    "scaffold",
    "create",
    "nextjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taylorbryant/beignet.git",
    "directory": "packages/create-beignet"
  },
  "author": "Taylor Bryant",
  "homepage": "https://github.com/taylorbryant/beignet#readme",
  "bugs": "https://github.com/taylorbryant/beignet/issues",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@beignet/cli": "^0.0.34"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
