{
  "name": "react-native-timacare",
  "version": "3.3.59-cccd",
  "description": "SDK Tima Care",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "test": "jest",
    "android": "yarn example android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepack": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "push": "git add . && git commit -m 'update' && git push origin sdk",
    "bootstrap": "yarn example && yarn install && yarn example pods",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/ducnq2398/react-native-timacare",
  "author": "Quang Duc <ducnq2398@gmail.com> (https://github.com/ducnq2398)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ducnq2398/react-native-timacare/issues"
  },
  "homepage": "https://github.com/ducnq2398/react-native-timacare#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@oguzhnatly/react-native-image-manipulator": "*",
    "@react-native-async-storage/async-storage": "*",
    "@react-native-camera-roll/camera-roll": "*",
    "@react-native-community/masked-view": "*",
    "@react-native-firebase/analytics": "*",
    "@react-native-ml-kit/text-recognition": "*",
    "@react-navigation/native": "*",
    "@react-navigation/native-stack": "*",
    "@types/react-native-snap-carousel": "*",
    "@types/uuid": "*",
    "apisauce": "*",
    "axios": "*",
    "i18n-js": "*",
    "immutable": "*",
    "jwt-decode": "*",
    "lodash.throttle": "*",
    "lottie-ios": "*",
    "lottie-react-native": "*",
    "mobx": "*",
    "mobx-react-lite": "*",
    "mobx-state-tree": "*",
    "moment": "*",
    "ramda": "*",
    "react": "*",
    "react-native": "*",
    "react-native-animatable": "*",
    "react-native-app-intro-slider": "*",
    "react-native-blob-util": "*",
    "react-native-circular-progress-indicator": "*",
    "react-native-communications": "*",
    "react-native-confirmation-code-field": "*",
    "react-native-create-thumbnail": "*",
    "react-native-date-picker": "*",
    "react-native-device-info": "*",
    "react-native-fast-image": "*",
    "react-native-fbsdk-next": "*",
    "react-native-fs": "*",
    "react-native-geolocation-service": "*",
    "react-native-gesture-handler": "*",
    "react-native-image-crop-picker": "*",
    "react-native-image-pan-zoom": "*",
    "react-native-image-picker": "*",
    "react-native-image-slider-box": "*",
    "react-native-image-viewing": "*",
    "react-native-keychain": "*",
    "react-native-linear-gradient": "*",
    "react-native-masked-text": "*",
    "react-native-modal": "*",
    "react-native-mrz-scanner": "*",
    "react-native-pager-view": "*",
    "react-native-pdf": "*",
    "react-native-permissions": "*",
    "react-native-public-ip": "^1.0.2",
    "react-native-render-html": "*",
    "react-native-safe-area-context": "*",
    "react-native-safe-area-view": "*",
    "react-native-screens": "*",
    "react-native-slack-webhook": "*",
    "react-native-svg": "*",
    "react-native-svg-transformer": "*",
    "react-native-vector-icons": "*",
    "react-native-video": "*",
    "react-native-vision-camera": "*",
    "react-native-webview": "*",
    "reactotron-mst": "*",
    "reactotron-react-native": "*",
    "rn-fetch-blob": "*",
    "rn-tourguide": "*",
    "validate.js": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.0.0",
    "@babel/plugin-proposal-optional-catch-binding": "^7.0.0",
    "@babel/plugin-syntax-decorators": "^7.22.5",
    "@babel/plugin-transform-class-properties": "^7.22.5",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.14.5",
    "@release-it/conventional-changelog": "^5.0.0",
    "@storybook/addon-storyshots": "5.3.19",
    "@storybook/react-native": "5.3.19",
    "@types/jest": "^25.2.3",
    "@types/minimatch": "^6.0.0",
    "@types/ramda": "0.26.44",
    "@types/react": "16.9.23",
    "@types/react-native": "^0.63.2",
    "@types/react-test-renderer": "^16.9.2",
    "@typescript-eslint/eslint-plugin": "^2.27.0",
    "@typescript-eslint/parser": "^2.27.0",
    "babel-jest": "^27.0.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.0.0",
    "eslint-config-standard": "^14.1.0",
    "formik": "^2.2.9",
    "ignite-bowser": "^5.4.1",
    "jest": "25.5.4",
    "jetifier": "^1.6.2",
    "metro-react-native-babel-preset": "^0.66.0",
    "minimatch": "^10.2.5",
    "npm-run-all": "4.1.5",
    "patch-package": "6.2.2",
    "postinstall-prepare": "1.0.1",
    "prettier": "^2.0.4",
    "react-devtools-core": "4.8.2",
    "react-native-builder-bob": "^0.21.3",
    "react-powerplug": "1.0.0",
    "react-test-renderer": "16.13.1",
    "rimraf": "3.0.2",
    "solidarity": "3.0.0",
    "typescript": "^4.5.2",
    "yup": "^0.32.9"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "globals": {
      "__DEV__": false,
      "jasmine": false,
      "beforeAll": false,
      "afterAll": false,
      "beforeEach": false,
      "afterEach": false,
      "test": false,
      "expect": false,
      "describe": false,
      "jest": false,
      "it": false
    },
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "configFile": true,
          "copyFlow": true
        }
      ],
      [
        "module",
        {
          "configFile": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
