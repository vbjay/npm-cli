{
  "name": "kapture-native-chat-sdk",
  "version": "3.0.7",
  "description": "React Native SDK for Kapture CRM Chat with full UI components",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "build": "bob build",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "kapture",
    "crm",
    "chat",
    "xmpp",
    "messaging",
    "sdk"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/kapture-native-chat-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/kapture-native-chat-sdk/issues"
  },
  "homepage": "https://github.com/yourusername/kapture-native-chat-sdk#readme",
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^1.19.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-builder-bob": "^0.23.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-webview": "^13.16.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.19.0",
    "react": ">=16.8.0",
    "react-native": ">=0.64.0",
    "react-native-image-picker": ">=5.0.0",
    "react-native-webview": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-image-picker": {
      "optional": false
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
