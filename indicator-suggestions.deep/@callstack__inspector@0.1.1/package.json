{
  "name": "@callstack/inspector",
  "version": "0.1.1",
  "description": "Profile React Native App in Release mode with React DevTools",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./metro": {
      "source": "./src/metro/index.ts",
      "types": "./lib/typescript/src/metro/index.d.ts",
      "default": "./lib/module/metro/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": "./bin/inspector.js",
  "files": [
    "bin",
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "clean": "del-cli android/build lib",
    "build": "yarn clean && bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest --watchman=false",
    "prepack": "cp ../../README.md ./README.md",
    "postpack": "rm ./README.md"
  },
  "keywords": [
    "react-native",
    "react-devtools",
    "profiling",
    "performance",
    "release-build",
    "release-mode",
    "metro",
    "inspector",
    "profiler",
    "devtools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callstackincubator/inspector.git"
  },
  "author": "Callstack",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/callstackincubator/inspector/issues"
  },
  "homepage": "https://github.com/callstackincubator/inspector#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@callstack/inspector-cli": "0.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@react-native/metro-config": "^0.85.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.41.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-devtools-core": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/../../apps/example/node_modules",
      "<rootDir>/lib/"
    ]
  }
}