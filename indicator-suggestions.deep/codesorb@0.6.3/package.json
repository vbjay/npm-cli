{
  "name": "codesorb",
  "version": "0.6.3",
  "description": "AST-powered architecture intelligence layer for AI coding agents. Multi-language structural analysis via tree-sitter.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "bin": {
    "codesorb": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:parallel": "npm run typecheck & npm run test & npm run build",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "release:version": "node scripts/sync-versions.js"
  },
  "keywords": [
    "ast",
    "tree-sitter",
    "code-analysis",
    "architecture",
    "dependency-graph",
    "refactoring",
    "mcp",
    "multi-language",
    "typescript",
    "python",
    "java",
    "go",
    "rust",
    "ruby",
    "kotlin"
  ],
  "author": "Piyush Mor",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piyushmor/codesorb.git"
  },
  "homepage": "https://github.com/piyushmor/codesorb#readme",
  "bugs": {
    "url": "https://github.com/piyushmor/codesorb/issues"
  },
  "peerDependenciesMeta": {},
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "chalk": "^5.6.2",
    "commander": "14.0.3",
    "escomplex": "^2.0.0-alpha",
    "esprima": "^4.0.1",
    "fast-glob": "3.3.3",
    "fast-xml-parser": "^5.4.2",
    "ignore": "7.0.5",
    "inquirer": "^9.3.8",
    "js-yaml": "^4.1.1",
    "lru-cache": "^11.0.0",
    "markdown-table": "^3.0.4",
    "msgpackr": "^1.11.0",
    "npm": "^11.6.0",
    "ora": "^7.0.1",
    "p-limit": "7.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prompts": "2.4.2",
    "smol-toml": "^1.6.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-go": "0.21.0",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-javascript": "0.21.4",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-ruby": "0.21.0",
    "tree-sitter-rust": "0.21.0",
    "tree-sitter-typescript": "0.23.2",
    "xxhash-wasm": "^1.0.2",
    "yaml": "^2.4.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/ora": "^3.2.0",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "proper-lockfile": "^4.1.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
