{
  "name": "@expofp/react-native-efp-sdk",
  "version": "0.8.20",
  "description": "ExpoFP React Native SDK",
  "keywords": [
    "react-native",
    "ios",
    "android",
    "expofp"
  ],
  "homepage": "https://expofp.github.io/react-native-efp-sdk/",
  "bugs": {
    "url": "https://github.com/expofp/react-native-efp-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expofp/react-native-efp-sdk.git"
  },
  "license": "MIT",
  "author": "ExpoFP Dev Team <dev-team@expofp.com> (https://developer.expofp.com)",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "docs:build": "vitepress build docs",
    "docs:build:all": "yarn docs:generate && yarn docs:changelog && yarn docs:build",
    "docs:changelog": "cp CHANGELOG.md docs/changelog.md",
    "docs:dev": "vitepress dev docs",
    "docs:generate": "typedoc",
    "docs:preview": "vitepress preview docs",
    "example": "yarn workspace react-native-efp-sdk-example",
    "ios:list": "xcrun simctl list devices",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release:ci": "release-it --ci",
    "test": "jest",
    "typecheck": "tsc"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "preset": "react-native"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@evilmartians/lefthook": "^1.12.3",
    "@react-native-community/cli": "20.0.1",
    "@react-native/babel-preset": "0.79.6",
    "@react-native/eslint-config": "^0.79.6",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "auto-changelog": "^2.5.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-builder-bob": "^0.40.13",
    "release-it": "^19.0.6",
    "turbo": "^2.5.6",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-vitepress-theme": "^1.0.0",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "yarn@3.6.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "codegenConfig": {
    "name": "ExpofpSdkRnSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.expofpsdkrn"
    }
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "version": "0.54.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
