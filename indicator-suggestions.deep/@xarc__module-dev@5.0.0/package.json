  "files": [
    "config",
    "dist",
    "install.js",
    "src"
  ],
  "keywords": [
    "node",
    "node.js",
    "npm",
    "module",
    "develop",
    "mocha",
    "eslint",
    "typescript"
  ],
  "dependencies": {
    "@xarc/run": "^1.0.4",
    "filter-scan-dir": "^1.0.10",
    "lodash": "^4.17.20",
    "tsconfig": "^7.0.0",
    "tslib": "^2.1.0",
    "xsh": "^0.4.5"
  },
  "engines": {
    "node": ">=10"
