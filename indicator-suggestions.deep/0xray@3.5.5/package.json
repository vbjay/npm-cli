{
  "name": "0xray",
  "version": "3.5.5",
  "description": "Multi-agent orchestration and Codex governance for OpenCode, Hermes, Grok Build, and OpenClaw",
  "readme": "README.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xRayAI/xray.git"
  },
  "homepage": "https://github.com/0xRayAI/xray#readme",
  "bugs": {
    "url": "https://github.com/0xRayAI/xray/issues"
  },
  "keywords": [
    "ai",
    "opencode",
    "hermes",
    "openclaw",
    "grok",
    "mcp",
    "agent",
    "orchestration",
    "codex",
    "error-prevention",
    "multi-agent",
    "framework",
    "governance",
    "cli",
    "tui",
    "hallucination-prevention",
    "ai-slop-prevention",
    "terminal-ai",
    "ai-assistant",
    "plugin-system"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./nucleus/*": {
      "import": "./dist/nucleus/*.js",
      "types": "./dist/nucleus/*.d.ts"
    }
  },
  "bin": {
    "0xray": "dist/cli/index.js",
    "0xray-integration": "dist/scripts/integration.js"
  },
  "opencode": {
    "plugin": "./dist/plugin/xray-codex-injection.js",
    "mcps": "./dist/mcps/"
  },
  "xray": {
    "dist": "dist",
    "mcpServersPath": "dist/mcps"
  },
  "scripts": {
    "prepublishOnly": "node scripts/node/reconcile-version.mjs --check && npm run prepare-consumer && npm run build:all && find dist -name '*.js.map' -o -name '*.d.ts.map' | xargs rm -f 2>/dev/null || true",
    "version:bump": "node scripts/node/version-manager.mjs",
    "version": "node scripts/node/version-manager.mjs",
    "prebuild": "rm -rf dist tsconfig.tsbuildinfo tsconfig.*.tsbuildinfo",
    "build": "tsc && chmod +x dist/cli/index.js && mkdir -p dist/public dist/scripts && cp -r public/* dist/public/ && cp scripts/hooks/pre-command dist/scripts/ && cp scripts/hooks/pre-command.mjs dist/scripts/ && cp README.md AGENTS.md SKILLS.md CHANGELOG.md LICENSE .gitignore.default dist/ && find src -name '*.mjs' ! -path '*/__tests__/*' | while read f; do tgt=\"dist/${f#src/}\"; mkdir -p \"$(dirname $tgt)\"; cp \"$f\" \"$tgt\"; done && for dir in skills integrations mcps; do find src/$dir -type f ! -name '*.ts' ! -path '*/.pytest_cache/*' | while read f; do tgt=\"dist/${f#src/}\"; mkdir -p \"$(dirname $tgt)\"; cp \"$f\" \"$tgt\"; done; done && mkdir -p dist/plugin && (find dist/plugin -name '*codex-injection*.js' -exec cp {} dist/plugin/xray-codex-injection.js \\; 2>/dev/null || true) && cp -r src/opencode/ .opencode/ && mkdir -p .xray && for f in codex.json features.json features.schema.json config.json; do cp xray/$f .xray/$f 2>/dev/null || true; done",
    "build:all": "npm run build",
    "ci-install": "npm ci",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.*.tsbuildinfo",
    "test": "vitest run",
    "test:batch": "npm test",
    "test:unit": "npm test -- src/__tests__/unit/config-loader.test.ts src/__tests__/unit/state-manager.test.ts src/__tests__/unit/state-manager-persistence.test.ts src/__tests__/unit/context-loader.test.ts src/__tests__/unit/pattern-analyzer.test.ts src/__tests__/unit/complexity-calibrator.test.ts",
    "test:core-framework": "npm test -- src/__tests__/unit/self-direction-activation.test.ts src/__tests__/unit/ast-code-parser.test.ts src/__tests__/unit/v2-deletion-protection.test.ts",
    "test:security": "npm test -- src/__tests__/unit/security/security-hardener.test.ts src/__tests__/unit/security/security-headers.test.ts src/__tests__/unit/security/security-auditor.test.ts",
    "test:performance": "npm test -- src/__tests__/unit/monitoring.test.ts src/__tests__/unit/benchmark.test.ts src/__tests__/unit/analytics.test.ts",
    "test:session-management": "npm test -- src/__tests__/unit/session-state-manager.test.ts src/__tests__/unit/session-security-validator.test.ts src/__tests__/unit/session-coordination-validator.test.ts src/__tests__/unit/session-migration-validator.test.ts src/__tests__/unit/session-migration-logic.test.ts",
    "test:code-analysis": "npm test -- src/__tests__/unit/codebase-context-analyzer.test.ts src/__tests__/unit/dependency-graph-builder.test.ts src/__tests__/unit/rule-enforcer.test.ts src/__tests__/unit/codex-parser.test.ts src/__tests__/unit/codex-injector.test.ts",
    "test:processors": "npm test -- src/__tests__/unit/processor-activation.test.ts src/__tests__/unit/typescript-compilation-processor.test.ts",
    "test:miscellaneous": "npm test -- src/__tests__/unit/blocked-test.test.ts",
    "test:quick": "npm test -- src/__tests__/integration/boot-orchestrator.integration.test.ts src/__tests__/unit/config-loader.test.ts src/__tests__/unit/state-manager.test.ts",
    "test:comprehensive": "npm run typecheck && npm run test:unit && npm run test:core-framework && npm run test:security && npm run test:performance && npm run test:session-management && npm run test:code-analysis && npm run test:processors && npm run test:miscellaneous",
    "test:integration-all": "npm test -- src/__tests__/integration/",
    "test:performance-all": "npm test -- src/__tests__/performance/ src/__tests__/unit/performance-system.test.ts src/__tests__/unit/benchmark.test.ts src/__tests__/unit/analytics.test.ts",
    "test:agents-all": "echo 'Legacy agents test entry retired'",
    "test:infrastructure": "npm test -- src/__tests__/infrastructure/",
    "test:root": "npm test -- src/__tests__/integration/server.test.ts src/__tests__/framework-enforcement-integration.test.ts",
    "test:pipelines": "node src/__tests__/pipeline/run-all-pipelines.mjs",
    "test:full-suite": "npm run typecheck && npm run test:integration-all && npm run test:performance-all && npm run test:infrastructure && npm run test:root",
    "postinstall": "node scripts/node/postinstall.cjs",
    "setup-dev": "node scripts/node/setup-dev.cjs",
    "prepare-consumer": "node scripts/node/prepare-consumer.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint -c tests/config/eslint.config.js src",
    "lint:fix": "eslint src --fix",
    "security-audit": "npm audit || true",
    "test:security-audit": "npm run test:security",
    "test:dependency-scan": "npm run security-audit",
    "test:integration": "node scripts/mjs/test-consumer-readiness.mjs && node scripts/mjs/test-mcp-functionality.mjs",
    "test:e2e": "node scripts/node/validate-mcp-connectivity.js && node scripts/node/validate-external-processes.js",
    "live-feedback-session": "npx --yes tsx scripts/live-taskhandler-feedback-session.ts",
    "validate": "echo \"[xray] Use 'npm test' or 'npm run test:comprehensive'.\"",
    "validate:quick": "npm run validate",
    "debug:inference:force": "XRAY_FORCE_MCP_GOVERNANCE=true XRAY_DEV_PATH=dist node dist/cli/index.js inference:run --force",
    "validate:full": "npm run validate",
    "test:unified": "node scripts/test/test-unified-framework.mjs",
    "test:consumer": "node scripts/test/test-consumer-readiness.cjs",
    "config:setup": "node scripts/config/utils.js setup-dev",
    "monitoring:start": "node scripts/monitoring/daemon.js start",
    "monitoring:stop": "node scripts/monitoring/daemon.js stop",
    "monitoring:report": "node scripts/monitoring/daemon.js report",
    "build:run": "node scripts/build/utils.js build",
    "build:clean": "node scripts/build/utils.js clean",
    "build:verify": "node scripts/build/utils.js verify",
    "enforce:versions": "bash scripts/node/enforce-version-compliance.sh",
    "version:sync": "node scripts/node/version-manager.mjs --artifacts-only",
    "release": "node scripts/node/release.mjs patch",
    "release:minor": "node scripts/node/release.mjs minor",
    "release:major": "node scripts/node/release.mjs major",
    "release:dry": "node scripts/node/release.mjs patch --dry-run",
    "version:reconcile": "node scripts/node/reconcile-version.mjs",
    "consumer:smoke": "node scripts/node/consumer-install-smoke.mjs",
    "release:gate": "node scripts/node/release-gate.mjs",
    "release:docs-check": "node scripts/node/validate-release-docs.mjs",
    "pre-publish-guard": "node scripts/node/pre-publish-guard.js",
    "safe-publish": "npm run prepare-consumer && npm run build",
    "publish": "npm run release:gate && npm run safe-publish && npm publish --access public",
    "release:patch": "node scripts/node/release.mjs patch",
    "verify:orchestrator-behavior": "npm run build && node scripts/mjs/verify-orchestrator-behavior.mjs",
    "verify:grok-delegation-gate": "npm run build && node scripts/mjs/verify-grok-delegation-gate.mjs && node scripts/mjs/verify-grok-synthesis-gate.mjs",
    "verify:grok-synthesis-gate": "npm run build && node scripts/mjs/verify-grok-synthesis-gate.mjs",
    "verify:hermes-delegation-gate": "npm run build && node scripts/mjs/verify-hermes-delegation-gate.mjs && node scripts/mjs/verify-hermes-session-start.mjs",
    "verify:delegation-gate": "npm run build && node scripts/mjs/verify-delegation-gate-core.mjs --host=grok && node scripts/mjs/verify-delegation-gate-core.mjs --host=hermes && node scripts/mjs/verify-delegation-gate-core.mjs --host=opencode && node scripts/mjs/verify-grok-delegation-gate.mjs && node scripts/mjs/verify-grok-synthesis-gate.mjs && node scripts/mjs/verify-hermes-delegation-gate.mjs",
    "verify:synthesis": "npm run build && node scripts/mjs/verify-synthesis-core.mjs && node scripts/mjs/verify-synthesis-gate-core.mjs && node scripts/mjs/verify-synthesis-outcome-core.mjs && node scripts/mjs/verify-synthesis-p2-core.mjs && node scripts/mjs/verify-synthesis-e2e-core.mjs && node scripts/mjs/verify-confer-core.mjs",
    "verify:confer": "npm run build && node scripts/mjs/verify-confer-core.mjs",
    "verify:user-aside": "npm run build && node scripts/mjs/verify-user-aside-core.mjs",
    "verify:pipeline-facets": "npm run build && node scripts/mjs/verify-pipeline-facets.mjs",
    "verify:find-project-root": "node scripts/mjs/verify-find-project-root-core.mjs",
    "verify:consumer-gitignore": "node scripts/mjs/verify-consumer-gitignore-core.mjs",
    "verify:pre-commit-diff": "node scripts/mjs/verify-pre-commit-diff-core.mjs",
    "verify:pre-push-diff": "node scripts/mjs/verify-pre-push-diff-core.mjs"
  },
  "files": [
    "dist/",
    "scripts/node/",
    "scripts/integrations/",
    "scripts/helpers/",
    "scripts/hooks/",
    "scripts/mjs/test-consumer-readiness.mjs",
    "scripts/mjs/test-mcp-functionality.mjs",
    "scripts/mjs/validate-mcp-connectivity.cjs",
    "scripts/mjs/validate-postinstall-config.mjs",
    "scripts/mjs/verify-orchestrator-behavior.mjs",
    "scripts/mjs/verify-grok-delegation-gate.mjs",
    "scripts/mjs/verify-grok-synthesis-gate.mjs",
    "scripts/mjs/verify-hermes-delegation-gate.mjs",
    "scripts/mjs/verify-hermes-session-start.mjs",
    "scripts/mjs/verify-pre-push-diff-core.mjs",
    "scripts/mjs/verify-confer-core.mjs",
    "scripts/mjs/verify-user-aside-core.mjs",
    "scripts/mjs/verify-delegation-gate-core.mjs",
    "scripts/mjs/delegation-gate-fixture.mjs",
    "src/opencode/",
    "src/opencode/codex.codex",
    "src/opencode/commands/",
    "src/opencode/enforcer-config.json",
    "src/opencode/openclaw/",
    "src/opencode/workflows/",
    "src/integrations/grok/plugin/0xray/",
    "src/skills/",
    "src/mcps/",
    ".plugin/",
    ".opencode/agents/",
    ".opencode/commands/",
    ".opencode/hooks/",
    ".opencode/skills/",
    ".opencode/init.sh",
    ".opencode/workflows/",
    ".opencode/codex.codex",
    ".opencode/enforcer-config.json",
    "opencode.json",
    "README.md",
    ".mcp.json",
    "AGENTS.md",
    "AGENTS-consumer.md",
    "SKILLS.md",
    "xray/agents_template.md",
    "xray/codex.json",
    "xray/features.json",
    "xray/features.schema.json",
    "xray/config.json",
    ".xray/codex.json",
    ".xray/features.json",
    ".xray/features.schema.json",
    ".xray/config.json",
    ".gitignore.default",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^11.1.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
