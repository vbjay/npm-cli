{
  "name": "@willh/oracode",
  "version": "0.1.2",
  "description": "Database-as-code CLI for exporting clean, Git-friendly Oracle DDL.",
  "bin": {
    "oracode": "npm/cli.cjs"
  },
  "scripts": {
    "postinstall": "node npm/postinstall.cjs",
