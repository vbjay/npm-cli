  },
  "files": [
    "npm/cli.cjs",
    "npm/postinstall.cjs",
    "npm/prepublish-check.cjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doggy8088/oracode.git"
  },
  "keywords": [
    "oracle",
    "ddl",
    "database-as-code",
    "rust",
    "cli"
