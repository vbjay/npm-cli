{
  "name": "@circlehq/push-react-native",
  "version": "1.4.3",
  "description": "CircleHQ Push React Native SDK — register device push tokens, identify users, and report notification events.",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "react-native": "./dist/commonjs/index.js",
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "require": "./dist/commonjs/index.js",
      "import": "./dist/module/index.js"
    },
    "./background": {
      "types": "./dist/typescript/background.d.ts",
      "require": "./dist/commonjs/background.js",
      "import": "./dist/module/background.js"
    },
    "./plugin": "./plugin/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/commonjs/background.js",
    "./dist/module/background.js"
  ],
  "bin": {
    "circle-push-setup": "./scripts/setup.js"
  },
  "files": [
    "dist",
    "plugin",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "bob build",
    "prepare": "bob build"
  },
  "keywords": [
    "circle",
    "push",
    "notifications",
    "fcm",
    "react-native",
    "sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "@expo/config-plugins": ">=7.0.0"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=7.0.0",
    "@notifee/react-native": ">=7.0.0",
    "@react-native-async-storage/async-storage": ">=1.19.0",
    "@react-native-firebase/app": ">=20.0.0",
    "@react-native-firebase/messaging": ">=20.0.0",
    "react-native": ">=0.71.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "@notifee/react-native": {
      "optional": true
    },
    "@react-native-firebase/app": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-typescript": "^7.20.0",
    "@expo/config-plugins": "^56.0.8",
    "@types/jest": "^29.0.0",
    "@types/react-native": "^0.73.0",
    "babel-jest": "^29.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "jest": "^29.0.0",
    "react-native": "^0.73.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "commonjs",
        {
          "copyFlow": false
        }
      ],
      "module",
      "typescript"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
