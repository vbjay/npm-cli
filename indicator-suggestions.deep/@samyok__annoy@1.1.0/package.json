{
  "name": "@samyok/annoy",
  "version": "1.1.0",
  "description": "Native Node.js bindings for Spotify's Annoy — fast approximate nearest neighbor search",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "install": "node-gyp rebuild",
    "build:native": "node-gyp rebuild",
    "build:ts": "tsup",
    "build": "npm run build:native && npm run build:ts",
    "test": "npm run build:ts && node dist/test.js && node --input-type=module -e \"import('./dist/test.mjs')\"",
    "prepublishOnly": "npm run build:ts"
  },
  "keywords": [
    "annoy",
    "approximate-nearest-neighbors",
    "nearest-neighbor",
    "knn",
    "vector-search",
    "similarity-search",
    "embeddings",
    "native",
    "n-api",
    "node-addon"
  ],
  "author": "samyok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samyok/annoy.git"
  },
  "bugs": {
    "url": "https://github.com/samyok/annoy/issues"
  },
  "homepage": "https://github.com/samyok/annoy#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "node-addon-api": "^8.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "node-gyp": "^11.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "src/addon.cc",
    "deps/annoy/src/annoylib.h",
    "deps/annoy/src/kissrandom.h",
    "deps/annoy/src/mman.h",
    "binding.gyp",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0"
}
