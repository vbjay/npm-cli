{
  "name": "@halfagiraf/clawx",
  "version": "0.9.65",
  "description": "Terminal-first coding agent — runs locally with Ollama, DeepSeek, OpenAI, or any OpenAI-compatible endpoint",
  "type": "module",
  "bin": {
    "clawx": "bin/clawx.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    ".env.example",
    "clawx.json.example"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/core/grpc/clawx.proto','dist/core/grpc/clawx.proto')\"",
    "dev": "tsc --watch",
    "start": "node dist/cli/main.js",
    "test": "vitest --run",
    "lint": "tsc --noEmit",
    "postinstall": "node -e \"try{require('fs').chmodSync('bin/clawx.js',0o755)}catch{}\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevenmcsorley/clawx.git"
  },
  "homepage": "https://github.com/stevenmcsorley/clawx#readme",
  "bugs": {
    "url": "https://github.com/stevenmcsorley/clawx/issues"
  },
  "keywords": [
    "coding-agent",
    "ai-agent",
    "terminal",
    "cli",
    "ollama",
    "deepseek",
    "openai",
    "local-llm",
    "code-generation",
    "tool-calling",
    "ssh",
    "automation"
  ],
  "author": "Steven McSorley",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@aws-sdk/client-bedrock-runtime": "^3.983.0",
    "@google/genai": "^1.40.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.8.0",
    "@mariozechner/jiti": "^2.6.2",
    "@earendil-works/pi-agent-core": "^0.79.0",
    "@earendil-works/pi-ai": "^0.79.0",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "^0.79.0",
    "@mistralai/mistralai": "1.14.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sinclair/typebox": "^0.34.0",
    "@swc/core": "^1.15.18",
    "@types/mime-types": "^2.1.4",
    "@types/ws": "^8.18.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bonjour-service": "^1.3.0",
    "chalk": "^5.4.0",
    "cli-highlight": "^2.1.11",
    "commander": "^13.0.0",
    "diff": "^8.0.2",
    "dotenv": "^16.4.0",
    "eventsource": "^4.1.0",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "file-type": "^21.1.1",
    "get-east-asian-width": "^1.3.0",
    "glob": "^13.0.1",
    "google-protobuf": "^3.21.0",
    "hosted-git-info": "^9.0.2",
    "ignore": "^7.0.5",
    "ink": "^6.8.0",
    "marked": "^15.0.12",
    "mime-types": "^3.0.1",
    "minimatch": "^10.2.3",
    "openai": "6.26.0",
    "ora": "^8.1.0",
    "partial-json": "^0.1.7",
    "proper-lockfile": "^4.1.2",
    "proxy-agent": "^6.5.0",
    "react": "^19.2.4",
    "ssh2": "^1.16.0",
    "strip-ansi": "^7.1.0",
    "table": "^6.9.0",
    "undici": "^7.19.1",
    "uuid": "^11.1.0",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.6"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "^0.3.2",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "koffi": "^2.9.0",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ink": "^0.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/ssh2": "^1.15.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
