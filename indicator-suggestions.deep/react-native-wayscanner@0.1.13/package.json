{
  "name": "react-native-wayscanner",
  "version": "0.1.13",
  "description": "Super-sensitive barcode & QR scanner for React Native — Vision Camera + C++ preprocess + MLKit + ZXing fallback",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "nitrogen",
    "cpp",
    "android",
    "ios",
    "scripts",
    "nitro.json",
    "react-native.config.js",
    "react-native-wayscanner.podspec",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build lib nitrogen/generated",
    "build": "tsc",
    "specs": "nitrogen",
    "postspecs": "node scripts/patch-kotlin-spec-tags.js",
    "example:setup": "node scripts/setup-example.js",
    "prepare": "npm run build && npm run specs",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "barcode",
    "qrcode",
    "qr-code",
    "scanner",
    "vision-camera",
    "opencv",
    "mlkit",
    "zxing",
    "frame-processor",
    "nitro",
    "wayscanner"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anwar1909/react-native-wayscanner.git"
  },
  "bugs": {
    "url": "https://github.com/anwar1909/react-native-wayscanner/issues"
  },
  "homepage": "https://github.com/anwar1909/react-native-wayscanner#readme",
  "author": "anwar1909",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "nitrogen": "^0.35.9",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-vision-camera": "^5.0.0",
    "react-native-vision-camera-worklets": "^5.0.0",
    "react-native-worklets": "^0.1.0",
    "release-it": "^17.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-nitro-image": "*",
    "react-native-vision-camera": ">=5.0.0",
    "react-native-vision-camera-worklets": "*",
    "react-native-worklets": "*"
  }
}
