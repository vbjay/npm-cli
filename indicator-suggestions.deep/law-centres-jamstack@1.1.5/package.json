{
  "name": "law-centres-jamstack",
  "version": "1.1.5",
  "description": "A set of React and Node utilities for interfacing with LCN JAMStack services.",
  "author": "andrewflett",
  "license": "NPOSL-3.0",
  "repository": "https://github.com/thelawcentresnetwork/lcn-jamstack-utilities",
  "babel": {
    "presets": [
      "@babel/preset-react",
      "@babel/preset-env"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && mkdir dist && ./node_modules/.bin/babel src/ -d dist --extensions \".js,.jsx,.tsx\" --copy-files",
    "yalc:release": "yarn build && yalc publish --push",
    "dev:build": "chokidar 'src/**/*' 'node_modules/law-centres-design-system/dist/**/*' -c 'yarn build'",
    "yalc:dev": "yarn yalc:release && concurrently -k \"yarn dev:build\" \"chokidar dist --initial --silent --delay 150 -c 'yalc push'\"",
    "reset": "rm -rf .yalc yalc.lock node_modules dist && yarn install",
    "reset-and-dev": "yarn reset && yarn yalc:dev",
    "prepare": "husky install",
    "release": "standard-version --no-verify",
    "postinstall": "node scripts/postinstall.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "react",
    "npm"
  ],
  "peerDependencies": {
    "@contentful/rich-text-react-renderer": "^15.17.0",
    "algoliasearch": "^4.8.5",
    "auth0": "^2.35.0",
    "axios": "^0.21.1",
    "contentful": "^8.1.7",
    "contentful-management": "^7.31.0",
    "html-react-parser": "^1.2.8",
    "law-centres-design-system": "^3.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.12.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.11.5",
    "@babel/core": "^7.14.6",
    "@babel/plugin-transform-runtime": "^7.15.0",
    "@babel/preset-env": "^7.14.7",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.15.0",
    "@commitlint/cli": "^17.6.5",
    "@commitlint/config-conventional": "^17.6.5",
    "@commitlint/cz-commitlint": "^17.5.0",
    "@types/react": "^17.0.3",
    "babel-core": "^6.26.3",
    "babel-loader": "^8.2.2",
    "babel-runtime": "^6.26.0",
    "chokidar": "^4.0.3",
    "chokidar-cli": "^3.0.0",
    "commitizen": "^4.3.0",
    "concurrently": "^9.2.0",
    "css-loader": "^6.2.0",
    "eslint": "^8.43.0",
    "eslint-plugin-react": "^7.32.2",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "loader-utils": "^2.0.0",
    "prettier": "2.8.8",
    "react": "^18.2.0",
    "source-map-loader": "^3.0.0",
    "standard-version": "^9.5.0",
    "ts-loader": "^8.3.0",
    "typescript": "^4.3.5",
    "webpack": "^5.86.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "inquirer": "^8.2.5"
  }
}
