    "claude",
    "claude-code",
    "anthropic",
    "agentskills",
    "everything-claude-code",
    "ecc",
    "cli",
    "agents",
    "mcp"
  ],
  "author": "AncoderAI",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "bin/skill-cli.js",
    "bin/targets",
    "scripts/install.sh",
    "scripts/install.ps1",
    "scripts/make-install-bundle.js",
    "scripts/check-install-host.js",
    "scripts/postinstall.js",
    "scripts/check-bin.js",
    "README.md",
    "LICENSE"
