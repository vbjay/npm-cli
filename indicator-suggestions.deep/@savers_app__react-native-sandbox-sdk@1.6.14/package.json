{
  "name": "@savers_app/react-native-sandbox-sdk",
  "version": "1.6.14",
  "description": "Cross-platform React Native SDK exposing native features (maps, dial pad, browser), device ID/location and session utilities, a URL generator, and a WebView message bridge to trigger actions from web content.",
  "main": "./lib/module/index.js",
  "react-native": "./src/index.tsx",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example:android:yarn": "yarn workspace @saversapp/react-native-sdk-example android",
    "example:ios:yarn": "yarn workspace @saversapp/react-native-sdk-example ios",
    "example:android:npm": "npm run -w @saversapp/react-native-sdk-example android",
    "example:ios:npm": "npm run -w @saversapp/react-native-sdk-example ios",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "set:sandbox": "cross-env SDK_ENV=sandbox SDK_PACKAGE=@savers_app/react-native-sandbox-sdk node scripts/replace-config.js",
    "set:production": "cross-env SDK_ENV=production SDK_PACKAGE=@savers_app/react-native-sdk node scripts/replace-config.js",
    "prepare:sandbox:yarn": "del-cli package-lock.json && cross-env PKG_MGR=yarn yarn set:sandbox && yarn install && yarn prepare",
    "prepare:production:yarn": "del-cli package-lock.json && cross-env PKG_MGR=yarn yarn set:production && yarn install && yarn prepare",
    "prepare:sandbox:npm": "cross-env PKG_MGR=npm npm run set:sandbox && npm install && npm run prepare && del-cli package-lock.json && cross-env PKG_MGR=yarn npm run set:sandbox",
    "prepare:production:npm": "cross-env PKG_MGR=npm npm run set:production && npm install && npm run prepare && del-cli package-lock.json && cross-env PKG_MGR=yarn npm run set:production",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pm-code/savers-react-native-sdk.git"
  },
  "author": "Faisal Wahab <faisalwahab@live.com> (https://github.com/pm-code)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pm-code/savers-react-native-sdk/issues"
  },
  "homepage": "https://github.com/pm-code/savers-react-native-sdk#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-navigation/native": "^7.0.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.12",
    "commitlint": "^19.8.1",
    "cross-env": "^7.0.3",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "lefthook": "^2.1.4",
    "prettier": "^3.8.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.40.13",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.1",
    "react-native-webview": "^13.16.0",
    "release-it": "^19.0.4",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@react-native-community/geolocation": "*",
    "@react-native-community/netinfo": "*",
    "@react-navigation/native": "*",
    "react": "*",
    "react-native": "*",
    "react-native-aes-gcm-crypto": "*",
    "react-native-device-info": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "react-native-webview": "*"
  },
  "workspaces": [
    "example",
    "."
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "moduleNameMapper": {
      "^@savers_app/react-native-sdk$": "<rootDir>/src/index.tsx",
      "^@savers_app/react-native-sandbox-sdk$": "<rootDir>/src/index.tsx",
      "^react-native-device-info$": "<rootDir>/src/__mocks__/react-native-device-info.ts",
      "^@react-native-community/geolocation$": "<rootDir>/src/__mocks__/@react-native-community__geolocation.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/src/__mocks__/@react-native-async-storage__async-storage.ts"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.56.1"
  }
}
