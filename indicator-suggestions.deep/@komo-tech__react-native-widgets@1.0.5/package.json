{
  "name": "@komo-tech/react-native-widgets",
  "version": "1.0.5",
  "description": "Embed Komo content in your React Native applications.",
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.9.2",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib",
    "example": "yarn workspace react-native-widgets-example",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "version-bump": "npm --no-git-tag-version version $0",
    "preversion-bump": "npm --no-git-tag-version version pre$0 --preid alpha",
    "prepare": "bob build",
    "prerelease:base": "yarn preversion-bump $0 && yarn build && npm publish --tag alpha",
    "prerelease:patch": "yarn prerelease:base patch",
    "prerelease:minor": "yarn prerelease:base minor",
    "prerelease:major": "yarn prerelease:base major",
    "prerelease:increment": "yarn prerelease:base release",
    "release:base": "yarn version-bump $0 && yarn build && npm publish",
    "release:patch": "yarn release:base patch",
    "release:minor": "yarn release:base minor",
    "release:major": "yarn release:base major",
    "test": "jest",
    "type-check": "tsc --pretty --noEmit"
  },
  "keywords": [
    "komo",
    "komo-embed",
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://www.komo.tech/",
  "author": "Komo <support@komo.tech> (https://www.komo.tech/)",
  "license": "MIT",
  "bugs": {
    "email": "support@komo.tech"
  },
  "homepage": "https://developers.komo.tech/embedding/react-native",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@react-native/babel-preset": "0.79.4",
    "@react-native/eslint-config": "^0.79.4",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.8",
    "del-cli": "^6.0.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.3",
    "prettier": "^3.6.2",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-builder-bob": "^0.40.12",
    "react-native-webview": "^13.15.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-webview": "^13.0.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.50.3"
  }
}
