{
  "name": "be-components",
  "version": "7.7.4",
  "description": "Components for BettorEdge Apps",
  "main": "src/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace be-components-example",
    "web-build": "yarn workspace be-components-example expo export -p web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "echo 'skipping bob build - lib already built'",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://www.bettoredge.com.git"
  },
  "author": "BettorEdge <james@bettoredge.com> (https://www.bettoredge.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://www.bettoredge.com/issues"
  },
  "homepage": "https://www.bettoredge.com#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/plugin-syntax-export-default-from": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/eslint-config": "^0.73.1",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/draft-js": "^0.11.18",
    "@types/is-url": "^1.2.32",
    "@types/jest": "^29.5.5",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.23.2",
    "release-it": "^15.0.0",
    "typescript": "~5.9.2"
  },
  "resolutions": {
    "@types/react": "~19.1.10"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.6.0",
    "@giphy/react-components": "^10.0.1",
    "@giphy/react-native-sdk": "^4.0.1",
    "@microsoft/clarity": "^1.0.0",
    "@microsoft/react-native-clarity": "^4.3.1",
    "@paypal/react-paypal-js": "^8.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-spring/web": "^9.7.3",
    "@types/uuid": "^9.0.8",
    "axios": "^1.6.8",
    "buffer": "^6.0.3",
    "draft-js": "^0.11.7",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.12",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.10",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-sharing": "~14.0.8",
    "expo-sms": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "install-expo-modules": "latest",
    "is-url": "^1.2.4",
    "moment-mini": "^2.29.4",
    "posthog-js": "^1.245.0",
    "posthog-react-native": "^3.15.3",
    "posthog-react-native-session-replay": "^1.0.6",
    "react-datepicker": "^8.7.0",
    "react-datetime-picker": "^6.0.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.1.0",
    "react-gifted-charts": "^0.0.12",
    "react-native-base64": "^0.2.1",
    "react-native-gifted-charts": "^1.4.65",
    "react-native-svg": "15.12.1",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "^0.21.0",
    "react-native-web-linear-gradient": "^1.1.2",
    "react-native-web-swiper": "^2.2.4",
    "react-native-webview": "13.15.0",
    "react-qr-code": "^2.0.15",
    "styled-components": "^6.1.16",
    "us-bank-account-validator": "^1.0.0",
    "uuid": "^9.0.1"
  },
  "directories": {
    "example": "example"
  }
}
