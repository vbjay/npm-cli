{
  "name": "defarm-sdk",
  "version": "3.0.3",
  "description": "DeFarm SDK - Git for traceability with multi-role permissions and global item discovery for agriculture supply chain",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "defarm": "cli.js"
  },
  "scripts": {
    "build:wasm": "wasm-pack build ./processor --target nodejs --out-dir ../pkg",
    "build": "node scripts/build.js",
    "build:production": "NODE_ENV=production npm run build",
    "dashboard": "node lib/dashboard/server.js",
    "setup": "node cli.js setup",
    "setup:quick": "node cli.js setup:quick",
    "db:status": "node cli.js db:status",
    "db:reset": "node cli.js db:reset",
    "test": "jest",
    "test:modules": "node -e \"require('./examples/test-modules').runTests()\"",
    "docs:generate": "node cli.js docs generate",
    "docs:serve": "bash scripts/docs-dev.sh serve",
    "docs:dev": "bash scripts/docs-dev.sh watch",
    "docs:clean": "node cli.js docs clean",
    "prepublishOnly": "npm run build:production",
    "postinstall": "node -e \"console.log('\\n🚀 Run \\\"npx defarm setup\\\" to configure DeFarm SDK\\n')\""
  },
  "keywords": [
    "defarm",
    "blockchain",
    "agriculture",
    "supply-chain",
    "tokenization",
    "wasm",
    "rust",
    "traceability",
    "sustainability",
    "multi-role",
    "dfid",
    "alias-mapping",
    "sisbov",
    "gta",
    "permissions"
  ],
  "author": "DeFarm Team",
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js",
    "lib/",
    "pkg/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@defarm/types": "file:../shared/types",
    "@docusaurus/core": "^3.8.1",
    "@docusaurus/preset-classic": "^3.8.1",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.21.2",
    "ipfs-http-client": "^60.0.1",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stellar-sdk": "^11.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "mssql": "^10.0.1",
    "mysql2": "^3.6.0",
    "oracledb": "^6.3.0",
    "pg": "^8.11.0",
    "redis": "^4.6.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.3",
    "wasm-pack": "^0.12.1"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "lib": "lib",
    "test": "tests"
  }
}
