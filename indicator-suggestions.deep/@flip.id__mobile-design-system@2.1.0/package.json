{
  "name": "@flip.id/mobile-design-system",
  "version": "2.1.0",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "prepare": "bob build",
    "prepublish": "pkgfiles",
    "release": "NODE_DEBUG=release-it:* release-it"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@babel/runtime": "^7.25.9",
    "@d11/react-native-fast-image": "8.9.2",
    "@faker-js/faker": "^8.2.0",
    "@flip.id/ui-kit": "^2.0.46",
    "@gorhom/bottom-sheet": "^4.5.1",
    "@react-native-community/bob": "^0.17.1",
    "@react-native-community/eslint-config": "^2.0.0",
    "@react-native/typescript-config": "0.78.0",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "@shopify/flash-list": "^1.4.0",
    "@tsconfig/react-native": "^2.0.2",
    "@types/jest": "^29.5.13",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.72.3",
    "pkgfiles": "^2.3.2",
    "react": "19.0.0",
    "react-native": "0.78.0",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-modalbox": "^2.0.2",
    "react-native-reanimated": "^3.17.1",
    "react-native-safe-area-context": "^5.2.0",
    "react-native-screens": "^4.10.0",
    "react-native-svg": "^15.11.2",
    "react-test-renderer": "19.0.0",
    "release-it": "^15.5.0",
    "typescript": "5.4.3"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "@react-native-community/bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "configFile": true
        }
      ],
      [
        "module",
        {
          "configFile": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src",
  "source": "src",
  "files": [
    "src",
    "lib",
    "README.md",
    "!**/example",
    "!**/fonts",
    "!**/svg-icons",
    "!**/webp-icons",
    "!**/_legacy",
    "!**/stack/flashlist.**"
  ],
  "description": "Flip UI Kit Version 2",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/flip-id/flip-ui-kit-v2.git"
  },
  "keywords": [
    "@flip.id/mobile-design-system",
    "flip-ui-kit",
    "ui-kit",
    "react-native",
    "android",
    "ios"
  ],
  "author": "flipmobile",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/flip-id/flip-ui-kit-v2/issues"
  },
  "homepage": "https://gitlab.com/flip-id/flip-ui-kit-v2#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lodash.debounce": "^4.0.8"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@3.6.4"
}
