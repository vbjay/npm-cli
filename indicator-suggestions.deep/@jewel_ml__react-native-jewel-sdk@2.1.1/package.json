{
  "name": "@jewel_ml/react-native-jewel-sdk",
  "version": "2.1.1",
  "description": "React Native SDK for JewelML product recommendations and analytics",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --maxWorkers=2",
    "prepare:example": "cd example && npm install && cd ios && pod install && cd ../..",
    "start": "cd example && npx expo start --clear",
    "start:android": "cd example && npx expo start --android --clear",
    "start:ios": "cd example && npx expo start --ios --clear",
    "e2e:build:ios": "cd example && npm run e2e:build:ios",
    "e2e:test:ios": "cd example && npm run e2e:test:ios",
    "e2e:build:android": "cd example && ANDROID_SDK_ROOT=\"$HOME/Android/Sdk\" npm run e2e:build:android",
    "e2e:test:android": "cd example && ANDROID_SDK_ROOT=\"$HOME/Android/Sdk\" npm run e2e:test:android",
    "e2e:android": "npm run build && npm run e2e:build:android && npm run e2e:test:android",
    "e2e:ios": "npm run build && npm run e2e:build:ios && npm run e2e:test:ios",
    "e2e:all": "npm run e2e:android && npm run e2e:ios",
    "test:all": "npm test && npm run e2e:all",
    "setup": "npm install && npm run prepare:example",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pack": "npm run build && npm pack",
    "version": "npm run build"
  },
  "keywords": [
    "react-native",
    "jewel",
    "recommendations",
    "e-commerce",
    "analytics",
    "machine-learning"
  ],
  "author": "JewelML",
  "license": "PROPRIETARY",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "@react-native-community/netinfo": ">=9.0.0",
    "crypto-js": "^4.2.0",
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-svg": ">=12.0.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/crypto-js": "^4.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "crypto-js": "^4.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^30.2.0",
    "prettier": "^3.5.3",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-svg": "^15.15.1",
    "react-test-renderer": "^18.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.8.0"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jewelml/react-native-sdk-sandbox.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
