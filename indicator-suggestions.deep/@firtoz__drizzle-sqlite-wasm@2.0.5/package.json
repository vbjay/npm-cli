{
	"name": "@firtoz/drizzle-sqlite-wasm",
	"version": "2.0.5",
	"description": "Drizzle SQLite WASM bindings",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./drizzle-sqlite-wasm-worker": {
			"types": "./dist/drizzle/worker.d.ts",
			"import": "./dist/drizzle/worker.js"
		},
		"./sqlite-wasm-migrator": {
			"types": "./dist/migration/migrator.d.ts",
			"import": "./dist/migration/migrator.js"
		},
		"./sqliteCollectionOptions": {
			"types": "./dist/collections/sqlite-collection.d.ts",
			"import": "./dist/collections/sqlite-collection.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup",
		"prepack": "bun run build",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write"
	},
	"keywords": [
		"typescript",
		"sqlite",
		"wasm",
		"drizzle"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/drizzle-sqlite-wasm"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@firtoz/collection-sync": "^7.0.3",
		"@firtoz/db-helpers": "^2.2.4",
		"@firtoz/drizzle-utils": "^1.3.4",
		"@firtoz/maybe-error": "^1.6.2",
		"@firtoz/worker-helper": "^1.6.2",
		"@sqlite.org/sqlite-wasm": "^3.53.0-build1",
		"@tanstack/db": "^0.6.14",
		"drizzle-orm": "^0.45.2",
		"drizzle-valibot": "^0.4.2",
		"react": "^19.2.7",
		"valibot": "^1.4.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@standard-schema/spec": "^1.1.0",
		"@types/react": "^19.2.17"
	}
}
