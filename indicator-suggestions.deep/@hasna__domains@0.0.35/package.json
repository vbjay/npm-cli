{
  "name": "@hasna/domains",
  "version": "0.0.35",
  "description": "Domain portfolio, registrar, marketplace, and DNS management for AI agents — CLI + MCP + HTTP API + SDK, local SQLite or cloud Postgres",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "domains": "dist/cli/index.js",
    "domains-mcp": "dist/mcp/index.js",
    "domains-serve": "dist/server/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capability": {
      "types": "./dist/lib/capability.d.ts",
      "import": "./dist/lib/capability.js"
    },
    "./cloudflare": {
      "types": "./dist/lib/cloudflare.d.ts",
      "import": "./dist/lib/cloudflare.js"
    },
    "./cloudflare-auth": {
      "types": "./dist/lib/cloudflare-auth.d.ts",
      "import": "./dist/lib/cloudflare-auth.js"
    },
    "./delegate": {
      "types": "./dist/lib/delegate.d.ts",
      "import": "./dist/lib/delegate.js"
    },
    "./registrar": {
      "types": "./dist/lib/registrar.d.ts",
      "import": "./dist/lib/registrar.js"
    },
    "./route53": {
      "types": "./dist/lib/route53.d.ts",
      "import": "./dist/lib/route53.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build src/cli/index.ts --outdir dist/cli --target bun --external ink --external react --external chalk --external ink-text-input --external @modelcontextprotocol/sdk --external @hasna/contacts --external pg && bun build src/mcp/index.ts --outdir dist/mcp --target bun --external @modelcontextprotocol/sdk --external pg && bun build src/server/index.ts --outdir dist/server --target bun --external pg && bun build src/sdk/index.ts --outdir dist/sdk --target bun && bun build src/index.ts --outdir dist --target bun --external pg && bun build src/lib/capability.ts src/lib/cloudflare.ts src/lib/cloudflare-auth.ts src/lib/delegate.ts src/lib/registrar.ts src/lib/route53.ts --outdir dist/lib --target node --packages external && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "sdk:gen": "bun run scripts/gen-sdk.ts",
    "kit:check": "contracts vendor-kit --check",
    "dev:cli": "bun run src/cli/index.ts",
    "dev:mcp": "bun run src/mcp/index.ts",
    "dev:serve": "bun run src/server/index.ts",
    "prepublishOnly": "bun run build",
    "postinstall": "mkdir -p ${XDG_DATA_HOME:-$HOME/.local/share}/open-domains ${XDG_CONFIG_HOME:-$HOME/.config}/open-domains 2>/dev/null || true"
  },
  "keywords": [
    "domains",
    "dns",
    "mcp",
    "ai",
    "coding-agent",
    "claude",
    "cli",
    "namecheap",
    "godaddy",
    "registrar"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/domains.git"
  },
  "homepage": "https://github.com/hasna/domains",
  "bugs": {
    "url": "https://github.com/hasna/domains/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": "Andrei Hasna <andrei@hasna.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-route-53": "^3.1067.0",
    "@aws-sdk/client-route-53-domains": "^3.1067.0",
    "@aws-sdk/credential-provider-ini": "3.972.53",
    "@hasna/contracts": "^0.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@hasna/events": "^0.1.7"
  },
  "peerDependencies": {
    "@hasna/contacts": "^0.6.19"
  },
  "peerDependenciesMeta": {
    "@hasna/contacts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hasna/mcp-harness": "0.1.0",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
