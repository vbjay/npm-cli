{
  "version": "0.1.13",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "avif",
    "wasm",
    "libavif",
    "libavif-wasm",
    "image processing",
    "typescript",
    "image compress"
  ],
  "description": "Library for encode and decode avif image with libavif & wasm",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build --transpileOnly",
    "wasm-init": "node --loader ts-node/esm ./script/init.ts",
    "wasm-build": "node --loader ts-node/esm ./script/build.ts",
    "wasm": "npm run wasm-init && npm run wasm-build",
    "test": "npm run build && tsdx test",
    "lint": "tsdx lint",
    "lint-fix": "tsdx lint --fix",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "name": "libavif-wasm",
  "author": "ahaoboy",
  "module": "dist/libavif-wasm.esm.js",
  "size-limit": [
    {
      "path": "dist/libavif-wasm.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/libavif-wasm.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^6.0.3",
    "husky": "^7.0.4",
    "size-limit": "^6.0.3",
    "ts-node": "^10.4.0",
    "tsdx": "^0.14.1",
    "tslib": "^2.3.1",
    "typescript": "^4.4.4",
    "zx": "^4.2.0"
  },
  "dependencies": {
    "@types/emscripten": "^1.39.5",
    "check-image-type": "^0.1.4",
    "e-emscripten": "^0.1.2",
    "regenerator-runtime": "^0.13.9"
  }
}
