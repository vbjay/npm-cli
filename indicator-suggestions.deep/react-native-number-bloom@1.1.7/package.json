{
  "name": "react-native-number-bloom",
  "version": "1.1.7",
  "description": "Smooth animated numbers for React Native. Digits roll, fade, and blur as the value changes. Skia-rendered with full Intl.NumberFormat support.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react-native",
    "expo",
    "skia",
    "react-native-skia",
    "animation",
    "animated",
    "number",
    "numbers",
    "number-flow",
    "numberflow",
    "number-flow-react-native",
    "react-native-number-flow",
    "animated-number",
    "animated-numbers",
    "animated-counter",
    "counter",
    "ticker",
    "odometer",
    "flip",
    "flip-number",
    "rolling-number",
    "currency",
    "price",
    "intl",
    "number-format",
    "bloom",
    "reanimated",
    "new-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlshehriAli0/react-native-number-bloom.git"
  },
  "homepage": "https://github.com/AlshehriAli0/react-native-number-bloom#readme",
  "bugs": {
    "url": "https://github.com/AlshehriAli0/react-native-number-bloom/issues"
  },
  "author": "Ali Alshehri",
  "license": "MIT",
  "scripts": {
    "prepack": "cp ../README.md ./README.md",
    "postpack": "rm -f ./README.md",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "release": "release-it",
    "start": "cd ../example && bun start",
    "example:prebuild": "cd ../example && bunx expo prebuild --clean",
    "bootstrap": "cd .. && bun install && cd example && bunx expo prebuild",
    "clean": "rm -rf lib coverage",
    "clean:native": "cd ../example && rm -rf ios android",
    "clean:all": "bun clean && bun clean:native && rm -rf node_modules ../example/node_modules"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "@types/react": ">=19.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.0",
    "@shopify/react-native-skia": "^2.6.2",
    "@types/react": "~19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "^4.3.1",
    "react-native-worklets": "^0.8.3",
    "release-it": "^19.0.0",
    "typescript": "~5.9.2"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true,
      "publishArgs": [
        "--provenance",
        "--access",
        "public"
      ]
    },
    "github": {
      "release": true
    },
    "hooks": {
      "before:init": "bun run build"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "refactor",
              "section": "Refactors"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "style",
              "section": "Styles"
            },
            {
              "type": "chore",
              "section": "Chores"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "ci",
              "section": "CI"
            },
            {
              "type": "build",
              "section": "Build"
            }
          ]
        },
        "infile": "../CHANGELOG.md"
      }
    }
  }
}
