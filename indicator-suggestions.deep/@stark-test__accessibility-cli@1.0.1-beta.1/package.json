{
  "name": "@stark-test/accessibility-cli",
  "version": "1.0.1-beta.1",
  "description": "Starks accessibility checks brought to a command line interface.",
  "author": "People At Stark <dev@getstark.co> (https://getstark.co)",
  "contributors": [
    "Abhiraj <abhiraj@getstark.co> (https://github.com/abcdefghiraj"
  ],
  "bin": {
    "stark-accessibility-test": "./bin/run"
  },
  "homepage": "https://getstark.co",
  "license": "None",
  "main": "dist/index.js",
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "^2",
    "@oclif/plugin-help": "^5",
    "@oclif/plugin-plugins": "^2.3.2",
    "@puppeteer/browsers": "2.1.0",
    "@stark-contrast/rule-engine": "^0.7.0",
    "axios": "^1.4.0",
    "config": "^3.3.11",
    "memory-fs": "^0.5.0",
    "puppeteer-core": "22.2.0",
    "puppeteer-extra": "3.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "webpack": "^5.84.1"
  },
  "devDependencies": {
    "@oclif/test": "^2.5.6",
    "@types/chai": "^4",
    "@types/config": "^3.3.3",
    "@types/memory-fs": "^0.3.6",
    "@types/mocha": "^9.0.0",
    "@types/node": "^16.18.14",
    "chai": "^4",
    "eslint": "^7.32.0",
    "eslint-config-oclif": "^4",
    "eslint-config-oclif-typescript": "^1.0.3",
    "jsdom": "^22.1.0",
    "jsdom-global": "^3.0.2",
    "mocha": "^9",
    "oclif": "^3",
    "shx": "^0.3.3",
    "ts-node": "^10.9.1",
    "tslib": "^2.5.0",
    "typescript": "^4.9.5"
  },
  "bundleDependencies": [
    "@stark-contrast/rule-engine"
  ],
  "oclif": {
    "bin": "stark-accessibility",
    "dirname": "stark-accessibility",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {},
    "macos": {
      "identifier": "co.getstark.www"
    }
  },
  "scripts": {
    "prebuild": "node -p \"'export const CLI_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "shx rm -rf dist && shx rm -f tsconfig.tsbuildinfo && tsc -b",
    "postbuild": "shx mkdir -p dist/resources/scripts && shx cp src/resources/scripts/* dist/resources/scripts && shx mkdir -p dist/config && cp config/* dist/config && shx rm dist/config/development.json",
    "lint": "eslint . --ext .ts --config .eslintrc",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "fullname": "node package_name.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "accessibility",
    "stark",
    "cli"
  ],
  "types": "dist/index.d.ts"
}
