{
  "name": "arrow2-wasm",
  "version": "0.2.0",
  "description": "WebAssembly library for Arrow/Feather/Parquet data with zero-copy ownership semantics and LZ4 compression",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pkg": {
      "import": "./pkg/arrow_wasm.js",
      "types": "./pkg/arrow_wasm.d.ts"
    }
  },
  "files": [
    "dist/",
    "pkg/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:ts",
    "dev": "tsc --watch",
    "test": "npm run build && npm run test:node",
    "test:node": "node --test dist/test.js",
    "test:browser": "cd mdb_tests && npm test",
    "clean": "rimraf dist/ pkg/",
    "prepare": "npm run build",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "arrow",
    "feather", 
    "parquet",
    "webassembly",
    "wasm",
    "zero-copy",
    "ipc",
    "lz4"
  ],
  "author": "Generated by Claude Code",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BectorVoom/arrow2-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/BectorVoom/arrow2-wasm/issues"
  },
  "homepage": "https://github.com/BectorVoom/arrow2-wasm#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}