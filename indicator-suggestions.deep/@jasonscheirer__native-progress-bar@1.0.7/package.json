{
  "name": "@jasonscheirer/native-progress-bar",
  "version": "1.0.7",
  "description": "This module allows your Electron app to display native dialogs with progress bars in them on Windows and macOS.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "npm run build-ts && npm run build-native",
    "build-ts": "tsc",
    "build-native": "node-gyp clean && node-gyp configure && node-gyp build",
    "test": "cd test && npm run start && cd -",
    "prettier": "npx prettier --write .",
    "prepack": "npm run build-ts",
    "install": "node-gyp-build || node-gyp rebuild",
    "prebuild": "prebuildify"
  },
  "keywords": [
    "progress",
    "progressbar",
    "bar",
    "dialog",
    "cocoa",
    "native",
    "macos",
    "windows",
    "win32",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonbot/native-progress-bar.git"
  },
  "author": "Felix Rieseberg <felix@felixrieseberg.com> (http://www.felixrieseberg.com)",
  "license": "MIT",
  "dependencies": {
    "bindings": "^1.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/bindings": "^1.5.5",
    "prebuildify": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "gypfile": true,
  "bugs": {
    "url": "https://github.com/jasonbot/native-progress-bar/issues"
  },
  "homepage": "https://github.com/jasonbot/native-progress-bar#readme"
}
