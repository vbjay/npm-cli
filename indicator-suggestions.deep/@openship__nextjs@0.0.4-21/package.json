{
    "name": "@openship/nextjs",
    "version": "0.0.4-21",
    "description": "An implementation of the openship protocol for Next.js",
    "scripts": {
      "build": "cargo build --target wasm32-wasip1 --release",
      "cp-js": "mkdir -p dist && cp swc_plugin/src/openship_route.js dist/",
      "cp-wasm": "mkdir -p wasm && cp target/wasm32-wasip1/release/openship_nextjs_swc.wasm wasm/ && cp target/wasm32-wasip1/release/openship_render.wasm wasm/",
      "prepare": "npm run build && npm run cp-wasm && npm run cp-js"
    },
    "files": [
      "wasm/openship_nextjs_swc.wasm",
      "wasm/openship_render.wasm",
      "dist/openship_route.js"
    ],
    "exports": {
      ".": {
        "import": "./dist/openship_route.js",
        "require": "./dist/openship_route.js"
      },
      "./wasm-openship-next-swc": "./wasm/openship_nextjs_swc.wasm",
      "./wasm/openship_nextjs_swc.wasm": "./wasm/openship_nextjs_swc.wasm",
      "./wasm-openship-next-render": "./wasm/openship_render.wasm",
      "./wasm/openship_render.wasm": "./wasm/openship_render.wasm"
    },
    "keywords": ["swc", "plugin", "nextjs", "wasm", "openship"],
    "author": "Gilles Pirio",
    "license": "MIT",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/gip/openship"
    },
    "devDependencies": {
      "@swc/core": "^1.3.0"
    },
    "peerDependencies": {
      "next": "^15.0.0"
    }
  }
