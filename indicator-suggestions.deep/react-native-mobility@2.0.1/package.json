{
  "name": "react-native-mobility",
  "version": "2.0.1",
  "description": "react-native-mobility",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "iOS-Dependencies",
    "cpp",
    "react-native-mobility.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "android:lint": "ktlint --editorconfig=.editorconfig 'android/**/*.kt'",
    "android:lint:fix": "ktlint -F --editorconfig=.editorconfig 'android/**/*.kt'",
    "ios:lint": "swiftlint lint --reporter json --config ./example/.swiftlint.yml ./ios",
    "ios:lint:fix": "swiftlint lint --autocorrect json --config ./example/.swiftlint.yml ./ios",
    "ios:format": "swiftformat --dry-run --config ./example/.swiftformat ./ios/**/*.swift ",
    "ios:format:fix": "swiftformat --config ./example/.swiftformat ./ios/ ",
    "ios": "cd example && yarn run ios",
    "android": "cd example && yarn run android",
    "code_quality": "yarn run test && yarn run lint && yarn run prettier && yarn run android:lint && yarn run ios:lint",
    "build": "yarn run build:clean && yarn run tsc",
    "build:clean": "rm -rf ./lib",
    "prepare": "yarn run build && unzip -o iOS-Dependencies.zip && sudo chmod 755 './scripts/post-install.sh' && ./scripts/post-install.sh;",
    "precommit": "yarn run prettier:fix && yarn run lint:fix && yarn run tsc",
    "test": "TZ=UTC node_modules/.bin/jest --coverage --forceExit",
    "testu": "TZ=UTC node_modules/.bin/jest --updateSnapshot --maxWorkers=50%",
    "tsc": "tsc",
    "prettier": "prettier --config ./.prettierrc --check \"src*/**/*.tsx\" ",
    "prettier:fix": "prettier --config ./.prettierrc --write --check \"src/**/*.tsx\"  --check \"example/**/*.tsx\" ",
    "lint": "tslint -p tsconfig.json 'src/*.tsx' 'src/**/*.tsx' 'src/**/*.ts'",
    "lint:fix": "tslint -p tsconfig.json --fix 'src/**/*.tsx' 'src/**/*.ts'",
    "android:test": "cd example/android; ./gradlew react-native-mobility:jacocoDebugTestReport --stacktrace"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pxs-Corporate/react-native-mobility.git"
  },
  "author": "Imran MENTESE <imran.mentese@arhs-spikeseed.com> (https://github.com/imranMnts)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Pxs-Corporate/react-native-mobility/issues"
  },
  "homepage": "https://github.com/Pxs-Corporate/react-native-mobility#readme",
  "devDependencies": {
    "@arkweid/lefthook": "^0.7.7",
    "@babel/core": "^7.20.12",
    "@babel/eslint-parser": "^7.18.2",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.12.16",
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native-community/eslint-config": "^3.0.2",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/enzyme": "^3.10.12",
    "@types/enzyme-adapter-react-16": "^1.0.6",
    "@types/jest": "^28.1.2",
    "@types/react": "~17.0.21",
    "@types/react-native": "0.68.0",
    "babel-jest": "^26.6.3",
    "commitlint": "^17.0.2",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.6",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^26.6.3",
    "jest-html-reporters": "^3.0.9",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^2.0.5",
    "react": "18.1.0",
    "react-dom": "18.2.0",
    "react-native": "0.75.4",
    "ts-jest": "^27.0.5",
    "tslint": "^6.1.3",
    "tslint-config-airbnb-base": "^0.3.0",
    "tslint-config-prettier": "^1.18.0",
    "tslint-react": "^5.0.0",
    "typescript": "4.2.3"
  },
  "resolutions": {
    "@types/react": "17.0.21"
  },
  "peerDependencies": {
    "lottie-ios": "*",
    "react": "*",
    "react-native": "*",
    "lottie-react-native": "*"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "collectCoverage": true,
    "verbose": true,
    "setupFiles": [
      "./config/jest.setup.js"
    ],
    "reporters": [
      "default",
      "jest-html-reporters"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "modulePaths": [
      "."
    ],
    "preset": "react-native",
    "testResultsProcessor": "jest-sonar-reporter",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "./example/"
    ],
    "modulePathIgnorePatterns": [
      "./example/"
    ],
    "coveragePathIgnorePatterns": [
      "./assets/*",
      "./example/*"
    ],
    "testMatch": [
      "**/__tests__/**/*.spec.(js|ts|tsx)"
    ],
    "transform": {
      "\\.(js|jsx|ts|tsx)$": "./node_modules/babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!react-native|react-navigation|react-native-mmkv-storage)/"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    },
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
