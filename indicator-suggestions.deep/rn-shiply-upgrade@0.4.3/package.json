{
  "name": "rn-shiply-upgrade",
  "version": "0.4.3",
  "description": "shiply rn upgrade",
  "main": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "harmony",
    "cpp",
    "*.podspec",
    "*.md",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!harmony/example"
  ],
  "scripts": {
    "example": "yarn workspace rn-shiply-upgrade-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib android/generated ios/generated example/android/app/build/generated  yarn.lock",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "harmony",
    "harmonyos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymond-shiply/rn-shiply-upgrade.git"
  },
  "author": "raymondhu <raymondhu@tencent.com> (https://github.com/raymond-shiply)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/raymond-shiply/rn-shiply-upgrade/issues"
  },
  "homepage": "https://github.com/raymond-shiply/rn-shiply-upgrade#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.27.1",
    "@babel/preset-env": "^7.0.0",
    "@react-native/babel-preset": "^0.73.21",
    "@react-native/eslint-config": "^0.73.2",
    "@react-native/typescript-config": "^0.74.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.11",
    "del-cli": "^5.1.0",
    "detox": "^20.27.3",
    "eslint": "^8.57.0",
    "eslint-plugin-ft-flow": "^3.0.7",
    "expect": "^29.0.0",
    "firebase-tools": "^13.22.1",
    "fs-extra": "^11.2.0",
    "hermes-eslint": "latest",
    "jest": "^29.7.0",
    "pod-install": "^0.2.2",
    "prettier": "^2",
    "react": "18.2.0",
    "react-native": "0.73",
    "react-native-builder-bob": "^0.40.6",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.59.0"
  },
  "workspaces": [
    "example",
    "rn72Example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNShiplyReactNativeUpgradeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "android": "./android/build/generated/source/codegen"
    },
    "android": {
      "javaPackageName": "com.rnshiplyupgrade"
    }
  }
}
