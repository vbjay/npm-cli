{
  "name": "@billingbear/purchases",
  "version": "0.9.5",
  "description": "Cross-platform subscription management SDK for React Native \u2014 with remote-configured paywalls",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@noble)"
    ]
  },
  "keywords": [
    "react-native",
    "subscriptions",
    "in-app-purchases",
    "stripe",
    "apple",
    "google",
    "entitlements"
  ],
  "author": "BillingBear",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^19.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "lib",
    "src",
    "android",
    "ios",
    "BillingBearPurchases.podspec",
    "react-native.config.js"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./revenuecat": {
      "types": "./lib/revenuecat.d.ts",
      "default": "./lib/revenuecat.js"
    }
  },
  "codegenConfig": {
    "name": "BillingBearPaywallViewSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "ios": {
      "componentProvider": {
        "BillingBearPaywallView": "BillingBearPaywallComponentView"
      }
    },
    "android": {
      "javaPackageName": "io.billingbear.rn"
    }
  },
  "dependencies": {
    "@noble/curves": "^2.2.0"
  }
}
