{
	"name": "@j2inn/podify",
	"version": "3.0.3",
	"description": "Build a POD file",
	"main": "dist/index.js",
	"directories": {
		"test": "test"
	},
	"scripts": {
		"build": "rimraf ./dist && tsc --project ./tsconfig.build.json && copyfiles -u 1 ./src/pod.config.js ./dist",
		"format": "prettier-eslint \"src/**/*.ts\" \"spec/**/*.ts\" --write",
		"lint": "eslint --fix --ext ts,tsx,js,jsx src/",
		"pod": "node ./dist/bundlePod.js",
		"test": "jest",
		"prepack": "npm run lint && npm test && npm run build",
		"watch": "jest --watchAll",
		"doc": "typedoc"
	},
	"bin": {
		"podify": "dist/index.js"
	},
	"keywords": [
		"pod",
		"build"
	],
	"files": [
		"dist/**/*"
	],
	"author": "Gareth Johnson",
	"license": "UNLICENSED",
	"devDependencies": {
		"@types/adm-zip": "^0.5.0",
		"@types/archiver": "^6.0.2",
		"@types/colors": "^1.2.1",
		"@types/fs-extra": "^11.0.1",
		"@types/jest": "^29.5.0",
		"@types/node": "^18.15.11",
		"@types/yargs": "^17.0.24",
		"@typescript-eslint/eslint-plugin": "^5.57.1",
		"@typescript-eslint/parser": "^5.57.1",
		"copyfiles": "^2.4.1",
		"eslint": "^8.37.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-jest": "^27.2.1",
		"eslint-plugin-prettier": "^4.2.1",
		"jest": "^29.5.0",
		"lint-staged": "^13.2.0",
		"prettier": "^2.8.7",
		"prettier-eslint": "^15.0.1",
		"prettier-eslint-cli": "^7.1.0",
		"rimraf": "^4.4.1",
		"ts-jest": "^29.1.0",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3"
	},
	"dependencies": {
		"adm-zip": "^0.5.14",
		"archiver": "^7.0.1",
		"colors": "^1.4.0",
		"fs-extra": "^11.1.1",
		"merge": "^2.1.1",
		"typedoc": "^0.23.28",
		"yargs": "^17.7.1"
	},
	"lint-staged": {
		"**/*.[jt]s?(x)": [
			"prettier-eslint --write",
			"eslint . --fix",
			"git add"
		]
	}
}
