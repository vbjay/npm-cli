{
  "name": "@vreko/cli",
  "version": "3.3.5",
  "description": "Vreko CLI — AI-aware developer intelligence for the command line",
  "homepage": "https://vreko.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/vreko-dev/vreko-cli.git"
  },
  "bugs": {
    "url": "https://github.com/vreko-dev/vreko-cli/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Vreko Team",
    "url": "https://vreko.dev"
  },
  "keywords": [
    "vreko",
    "ambient-codebase-intelligence",
    "codebase-intelligence",
    "ai-codebase-intelligence",
    "ai-coding-mistakes-prevention",
    "fragile-files",
    "cursor-companion",
    "claude-code-companion",
    "copilot-companion",
    "ai-agent-context",
    "cli",
    "snapshots",
    "intelligence"
  ],
  "bin": {
    "vreko": "dist/index.js",
    "vr": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@babel/parser": "7.28.5",
    "@babel/traverse": "7.28.5",
    "@better-auth/passkey": "1.6.19",
    "@better-auth/sso": "1.6.19",
    "@clack/prompts": "^1.1.0",
    "@electric-sql/pglite": "0.2.0",
    "@hubspot/api-client": "13.0.0",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "1.28.0",
    "@neondatabase/serverless": "0.10.4",
    "@opentelemetry/exporter-metrics-otlp-http": "0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.208.0",
    "@opentelemetry/instrumentation-pino": "0.51.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-trace-node": "2.2.0",
    "@react-email/components": "0.5.7",
    "@react-email/render": "1.1.4",
    "@sentry/node": "10.32.1",
    "@sindresorhus/slugify": "3.0.0",
    "better-auth": "1.6.19",
    "boxen": "8.0.1",
    "chalk": "4.1.2",
    "chokidar": "4.0.3",
    "cli-table3": "0.6.5",
    "commander": "9.5.0",
    "conf": "13.0.1",
    "cookie": "1.1.1",
    "dotenv": "17.2.2",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.7.1",
    "glob": "11.1.0",
    "minimatch": "10.2.5",
    "nanoid": "5.1.5",
    "neverthrow": "8.2.0",
    "p-retry": "6.2.0",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0",
    "better-sqlite3": "12.11.1",
    "posthog-node": "3.6.3",
    "quick-lru": "7.0.0",
    "typescript": "5.9.2",
    "eventemitter2": "6.4.9",
    "execa": "9.5.2",
    "ink": "^6.8.0",
    "ky": "1.7.2",
    "listr2": "10.2.1",
    "llm-guard": "^0.1.8",
    "log-update": "6.1.0",
    "opossum": "9.0.0",
    "ora": "5.4.1",
    "oxc-parser": "0.112.0",
    "p-queue": "9.0.0",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "redis": "4.7.1",
    "resend": "6.2.2",
    "stripe": "19.1.0",
    "ts-pattern": "5.7.1",
    "zod": "3.25.76",
    "@vreko/contracts": "1.1.1"
  },
  "optionalDependencies": {
    "keytar": "7.9.0"
  },
  "bundledDependencies": [
    "@vreko/auth",
    "@vreko/claims-ledger",
    "@vreko/intelligence",
    "@vreko/local-service",
    "@vreko/local-service-client",
    "@vreko/mcp",
    "@vreko/mcp-client",
    "@vreko/mcp-config",
    "@vreko/sentry-privacy"
  ],
  "devDependencies": {
    "@types/react": "19.1.13",
    "@vitest/coverage-v8": "3.2.6",
    "ink-gradient": "^4.0.0",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^6.1.2",
    "tsup": "8.5.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.6",
    "@types/react-dom": "19.1.9"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./dist/index.js",
    "./services/vreko-dir": "./dist/services/vreko-dir.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=8.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "preuninstall": "node scripts/preuninstall.mjs",
    "build": "tsup && tsc --build tsconfig.build.json --emitDeclarationOnly && node scripts/verify-jsx-transform.mjs",
    "check": "biome check .",
    "check:banned-words": "tsx scripts/check-banned-words.ts",
    "dev": "tsup --watch",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "publish:clean": "node scripts/publish-clean.mjs",
    "cli:install": "pnpm build && pnpm link --global && echo '✅ CLI installed globally. Run: vreko --help or vr --help'",
    "cli:uninstall": "pnpm unlink --global && echo '✅ CLI uninstalled globally'",
    "cli:reinstall": "pnpm run cli:uninstall && pnpm run cli:install",
    "mcp:configure": "node dist/index.js tools configure --yes",
    "mcp:configure:dev": "node dist/index.js tools configure --yes --dev",
    "mcp:status": "node dist/index.js tools configure --list"
  }
}
