{
  "name": "vibemaster-mcp",
  "version": "8.0.2",
  "description": "The only MCP that makes Claude think like a senior engineer — memory, GSD planning, auto-review, quality scoring, GitHub Action CI. 58 tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vibemaster-mcp": "dist/index.js",
    "vibemaster-mcp-setup": "dist/setup-wizard.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    ".env.example",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc",
    "build:action": "esbuild src/action/index.ts --bundle --platform=node --target=node20 --outfile=dist/action.js --external:@actions/core --external:@actions/github",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "postinstall": "node dist/setup-wizard.js || echo Setup skipped. Run: npx vibemaster-mcp-setup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "vscode",
    "claude-code",
    "ai",
    "orchestrator",
    "security",
    "typescript",
    "rust",
    "tauri"
  ],
  "author": "SnaiilyDevelopment",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnaiilyDevelopment/VibemasterMCP.git"
  },
  "bugs": {
    "url": "https://github.com/SnaiilyDevelopment/VibemasterMCP/issues"
  },
  "homepage": "https://github.com/SnaiilyDevelopment/VibemasterMCP#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "engineStrict": true,
  "dependencies": {
    "@actions/core": "1.10.1",
    "@actions/github": "6.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xenova/transformers": "2.17.2",
    "axios": "^1.15.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "16.0.0",
    "glob": "11.0.0",
    "ws": "8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "30.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "20.0.0",
    "@types/ws": "8.18.1",
    "esbuild": "^0.25.12",
    "tsx": "4.0.0",
    "typescript": "5.3.3",
    "vitest": "^1.6.1"
  }
}
