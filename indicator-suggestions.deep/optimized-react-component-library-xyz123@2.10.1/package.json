{
  "name": "optimized-react-component-library-xyz123",
  "version": "2.10.1",
  "description": "A modern React component library using TypeScript with React 19 support.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./css/darkMode.css": "./src/css/darkMode.css",
    "./css/mobileView.css": "./src/css/mobileView.css",
    "./css/styles.css": "./src/css/styles.css",
    "./css/questions.css": "./src/css/questions.css",
    "./css/e-tjanst-root.css": "./src/css/e-tjanst-root.css"
  },
  "files": [
    "dist",
    "src/css/darkMode.css",
    "src/css/mobileView.css",
    "src/css/styles.css",
    "src/css/questions.css",
    "src/css/e-tjanst-root.css"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest",
    "prepare": "husky install",
    "release": "standard-version",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/optimized-react-component-library-xyz123-ch-react19.git"
  },
  "keywords": [
    "react",
    "react19",
    "component-library",
    "typescript",
    "npm",
    "modern-react",
    "boilerplate",
    "storybook"
  ],
  "author": "YOUR NAME",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-docs": "^8.6.15",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0",
    "standard-version": "^9.5.0",
    "storybook": "^8.6.15",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.10.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^7.13.0"
  }
