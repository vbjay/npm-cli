{
  "name": "@datadog/ai-setup-cli",
  "version": "2.0.22",
  "description": "Interactive tool for Datadog setup",
  "license": "MIT",
  "author": "Aaron Joyce <aaron.joyce@datadoghq.com>",
  "keywords": [
    "datadog",
    "cli",
    "setup-cli",
    "monitoring",
    "observability",
    "agentic",
    "onboarding",
    "ai"
  ],
  "main": "dist/app.js",
  "exports": {
    ".": "./dist/app.js",
    "./lib": {
      "types": "./dist/lib-entry.d.ts",
      "default": "./dist/lib-entry.js"
    },
    "./types": {
      "types": "./dist/lib-types.d.ts",
      "default": "./dist/lib-types.js"
    },
    "./config": "./dist/config.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "ai-setup-cli": "bin/cli.cjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/strip-empty-exports.js && cp -R src/services/oauth-success-assets dist/services/ && cp -R src/vendor dist/vendor",
    "dev": "node scripts/watch-dev.js",
    "test": "prettier --check . && xo && ava",
    "test:flicker": "node node_modules/.bin/ava dist/__tests__/flicker/synchronized-output.test.js --verbose",
    "test:flicker:manual": "node node_modules/.bin/tsx src/__tests__/flicker/manual-rendering-test.tsx",
    "preflight": "bash scripts/preflight.sh",
    "prepack": "npm run build"
  },
  "files": [
    "bin",
    "dist",
    "products",
    "readme.md"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.116",
    "@clack/prompts": "^1.1.0",
    "@datadog/datadog-api-client": "^1.56.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "ink": "^7.0.1",
    "ink-spinner": "^5.0.0",
    "js-yaml": "^4.1.1",
    "meow": "^14.0.0",
    "open": "^11.0.0",
    "react": "^19.2.5",
    "safe-regex2": "^5.1.1",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "chokidar": "^5.0.0",
    "@sindresorhus/tsconfig": "^3.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.14",
    "@vdemedes/prettier-config": "^2.0.1",
    "ava": "^7.0.0",
    "eslint-config-xo-react": "^0.27.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.0.3",
    "xo": "^0.53.1"
  },
  "ava": {
    "extensions": {
      "ts": "module",
      "tsx": "module"
    },
    "workerThreads": false,
    "nodeArguments": [
      "--import=tsx/esm"
    ],
    "files": [
      "src/**/*.test.ts",
      "src/**/*.test.tsx",
      "src/**/*.test.js",
      "dist/**/*.test.js"
    ]
  },
  "xo": {
    "extends": "xo-react",
    "prettier": true,
    "rules": {
      "react/prop-types": "off",
      "unicorn/expiring-todo-comments": "off",
      "unicorn/escape-case": "off",
      "unicorn/no-hex-escape": "off"
    }
  },
  "prettier": "@vdemedes/prettier-config",
  "overrides": {
    "xo": {
      "picomatch": "^2.3.2",
      "braces": "^3.0.3",
      "semver": "^7.8.4",
      "micromatch": "^4.0.8"
    },
    "ava": {
      "semver": "^7.8.4"
    },
    "supertap": {
      "js-yaml": "^3.15.0"
    }
  }
}
