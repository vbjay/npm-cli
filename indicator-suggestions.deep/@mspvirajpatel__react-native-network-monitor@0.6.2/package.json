{
  "name": "@mspvirajpatel/react-native-network-monitor",
  "version": "0.6.2",
  "engines": {
    "node": ">=18"
  },
  "description": "A powerful, production-ready debug monitor for React Native apps. Intercepts network requests (fetch & XHR), captures console logs, and provides a beautiful in-app debug UI with password protection, environment switching, and log export.",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "prepare": "npm run build",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "release": "npm run build && npm publish --access public",
    "publish-package": "npm publish --access public"
  },
  "keywords": [
    "react-native",
    "network-monitor",
    "debug",
    "debugger",
    "network",
    "interceptor",
    "fetch",
    "xhr",
    "console",
    "logger",
    "debug-monitor",
    "react-native-debug",
    "network-inspector",
    "api-monitor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mspvirajpatel/react-native-network-monitor.git"
  },
  "author": "Viraj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mspvirajpatel/react-native-network-monitor/issues"
  },
  "homepage": "https://github.com/mspvirajpatel/react-native-network-monitor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-native": "^0.73.0",
    "react": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-safe-area-context": "^5.8.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": false
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-sharing": {
      "optional": true
    },
    "react-native-fs": {
      "optional": true
    }
  }
}
