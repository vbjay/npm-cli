{
  "name": "@velion-la/onboarding-sdk-react-native",
  "version": "1.0.0",
  "description": "Native React Native SDK for the Velion Onboarding (KYC) flow: ID document OCR, passive + active liveness, device fingerprint, OTP verification, address picker, and personal / legal information forms.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "app.plugin.js",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo 'eslint not configured yet'",
    "test": "jest",
    "clean": "del-cli lib",
    "prepack": "bob build",
    "build": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "expo",
    "kyc",
    "onboarding",
    "liveness",
    "ocr",
    "velion"
  ],
  "homepage": "https://developers.velion.la",
  "bugs": {
    "email": "dev@velion.la"
  },
  "author": "Velion <dev@velion.la>",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "expo-application": "~7.0.0",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.0",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.0",
    "expo-image-manipulator": "~14.0.0",
    "expo-keep-awake": "~15.0.0",
    "expo-location": "~19.0.0",
    "react-native-sse": "^1.2.1"
  },
  "peerDependencies": {
    "@fingerprintjs/fingerprintjs-pro-react-native": ">=3.0.0",
    "expo": ">=54.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-maps": ">=1.20.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=15.0.0",
    "react-native-vision-camera": ">=4.6.0"
  },
  "peerDependenciesMeta": {
    "@fingerprintjs/fingerprintjs-pro-react-native": {
      "optional": true
    },
    "react-native-maps": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "del-cli": "^6.0.0",
    "jest": "^29.7.0",
    "react-native-builder-bob": "^0.40.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
