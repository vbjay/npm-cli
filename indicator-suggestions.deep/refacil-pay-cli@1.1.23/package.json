{
  "name": "refacil-pay-cli",
  "version": "1.1.23",
  "description": "Refácil Pay CLI",
  "keywords": ["refacil", "refacil-pay", "fintech", "colombia", "pse", "bre-b", "pagos", "cash-in", "cash-out", "payments", "cli", "ai-agent"],
  "type": "module",
  "bin": {
    "refacil-pay-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "postinstall": "node ./scripts/install-skills.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^12.0.0",
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.0.0",
    "ora": "^8.0.0",
    "@napi-rs/keyring": "^1.1.4",
    "conf": "^13.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist",
    "scripts",
    "skills",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
