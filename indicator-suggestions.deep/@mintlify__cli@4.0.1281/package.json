{
  "name": "@mintlify/cli",
  "version": "4.0.1281",
  "description": "The Mintlify CLI",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Mintlify, Inc.",
  "bugs": {
    "url": "https://github.com/mintlify/docs/issues"
  },
  "license": "Elastic-2.0",
  "keywords": [
    "mintlify",
    "mint",
    "cli"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mintlify/mint",
    "directory": "packages/cli"
  },
  "exports": "./bin/index.js",
  "bin": {
    "mint": "bin/index.js",
    "mintlify": "bin/index.js"
  },
  "scripts": {
    "dev": "yarn build && NODE_NO_WARNINGS=1 node bin/index.js",
    "prepare": "npm run build",
    "build": "tsc --project tsconfig.build.json",
    "clean:build": "rimraf bin",
    "clean:all": "rimraf node_modules .eslintcache && yarn clean:build",
    "watch": "tsc --watch",
    "lint": "oxlint src",
    "test": "vitest run",
    "type": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@inquirer/prompts": "7.9.0",
    "@mintlify/common": "1.0.996",
    "@mintlify/link-rot": "3.0.1184",
    "@mintlify/models": "0.0.335",
    "@mintlify/prebuild": "1.0.1143",
    "@mintlify/previewing": "4.0.1209",
    "@mintlify/validation": "0.1.776",
    "adm-zip": "0.5.16",
    "chalk": "5.2.0",
    "color": "4.2.3",
    "detect-port": "1.5.1",
    "front-matter": "4.0.2",
    "fs-extra": "11.2.0",
    "ink": "6.3.0",
    "inquirer": "12.3.0",
    "js-yaml": "4.1.1",
    "mdast-util-mdx-jsx": "3.2.0",
    "open": "8.4.2",
    "openid-client": "6.8.2",
    "posthog-node": "5.17.2",
    "react": "19.2.3",
    "semver": "7.7.2",
    "unist-util-visit": "5.0.0",
    "yargs": "17.7.1",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "keytar": "7.9.0"
  },
  "devDependencies": {
    "@mintlify/ts-config": "2.0.2",
    "@tsconfig/recommended": "1.0.2",
    "@types/adm-zip": "0.5.7",
    "@types/detect-port": "1.3.2",
    "@types/keytar": "4.4.2",
    "@types/mdast": "4.0.4",
    "@types/node": "18.15.0",
    "@types/yargs": "17.0.22",
    "openapi-types": "12.1.3",
    "oxfmt": "^0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "5.0.1",
    "sharp": "^0.33.1",
    "typescript": "5.5.3",
    "vitest": "2.1.9",
    "vitest-mock-process": "1.0.4"
  },
  "gitHead": "ae989357ac3fe0988d04e5918194fdff149d722f"
}
