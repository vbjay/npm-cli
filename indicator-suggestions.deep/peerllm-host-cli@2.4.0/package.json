{
  "name": "peerllm-host-cli",
  "version": "2.4.0",
  "description": "Command-line PeerLLM host: serve decentralized AI compute from a headless machine.",
  "author": {
    "name": "Hassan Habib",
    "email": "hassan@bestbytes.ai",
    "url": "https://peerllm.com"
  },
  "license": "UNLICENSED",
  "homepage": "https://peerllm.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeerLLM/PeerLLM.Experimental.Apps.Cli.git"
  },
  "bugs": {
    "url": "https://github.com/PeerLLM/PeerLLM.Experimental.Apps.Cli/issues",
    "email": "hassan@bestbytes.ai"
  },
  "keywords": [
    "peerllm",
    "llm",
    "host",
    "headless",
    "cli",
    "ai",
    "gguf",
    "llama-cpp",
    "decentralized",
    "inference"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "peerllm-host": "dist/cli/index.js",
    "peerllm-hostd": "dist/daemon/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.17",
    "commander": "^12.1.0",
    "node-llama-cpp": "^3.18.1",
    "systeminformation": "^5.31.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
