{
  "name": "@esauml/rust-nodejs-lib",
  "version": "0.1.3",
  "description": "a simple js lib written in rust",
  "main": "index.node",
  "scripts": {
    "build": "cargo-cp-artifact -nc index.node -- cargo build --message-format=json-render-diagnostics",
    "build:debug": "npm run build --",
    "build:release": "npm run build -- --release",
    "install": "npm run build-release",
    "test": "cargo test"
  },
  "author": "Esau Martinez <esaumtz4722@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "cargo-cp-artifact": "^0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esauml/learning-rust"
  },
  "keywords": [
    "rust",
    "js",
    "node",
    "npm",
    "lib"
  ]
}