{
  "name": "@payrails/react-native-sdk",
  "version": "2.10.0",
  "description": "Payrails React Native SDK",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "lib/module/index",
  "source": "lib/module/index",
  "files": [
    "assets",
    "lib",
    "android",
    "ios",
    "cpp",
    "LICENSE",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest --collectCoverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint-fix": "eslint --fix && prettier --ignore-unknown --write .",
    "build": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn install && yarn example pods",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build",
    "prepare": "husky install"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "payrails",
    "sdk"
  ],
  "repository": "https://github.com/payrails/react-native-sdk",
  "author": "Nikita Gubchenko <nikita@payrails.com> (https://github.com/ngub)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/payrails/react-native-sdk/issues"
  },
  "homepage": "https://github.com/payrails/react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.23.3",
    "@expo/config-plugins": "7.8.4",
    "@react-native-community/eslint-config": "^3.0.2",
    "@testing-library/react-native": "12.5.0",
    "@types/base64-js": "1.3.0",
    "@types/jest": "29.5.12",
    "@types/react": "17.0.21",
    "@types/react-native": "0.70.0",
    "@types/react-native-vector-icons": "6.4.13",
    "@typescript-eslint/eslint-plugin": "5.48.0",
    "@typescript-eslint/parser": "5.48.0",
    "commitlint": "17.0.2",
    "del-cli": "5.0.0",
    "eslint": "8.31.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-plugin-react": "7.31.11",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-security": "1.5.0",
    "eslint-plugin-simple-import-sort": "8.0.0",
    "eslint-plugin-unused-imports": "2.0.0",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "jest-fetch-mock": "3.0.3",
    "lint-staged": "13.1.0",
    "metro-react-native-babel-preset": "0.77.0",
    "pod-install": "0.1.0",
    "prettier": "2.0.5",
    "react": "18.1.0",
    "react-native": "0.70.5",
    "react-native-builder-bob": "0.20.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-uuid": "2.0.3",
    "react-native-webview": "13.16.0",
    "react-test-renderer": "18.1.0",
    "typescript": "4.9.5"
  },
  "resolutions": {
    "@types/react": "17.0.21",
    "cross-spawn": "7.0.5",
    "react-devtools-core": "4.28.4"
  },
  "peerDependencies": {
    "base64-js": "*",
    "react": "*",
    "react-native": "*",
    "react-native-uuid": "*",
    "react-native-webview": "^11.26.1 || ^12.0.0 || ^13.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-background-actions": ">=4.0.0",
    "lean-react-native": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-background-actions": {
      "optional": true
    },
    "lean-react-native": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "jest": {
    "automock": false,
    "preset": "react-native",
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "coverageReporters": [
      "json-summary",
      "json",
      "lcov",
      "text"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "lint-staged": {
    "**/*": [
      "npm run lint-fix"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ],
      [
        "aar",
        {
          "androidBundleName": "android-release.aar"
        }
      ]
    ]
  },
  "dependencies": {
    "jwt-decode": "^3.1.2",
    "set-value": "^4.1.0"
  },
  "overrides": {
    "cross-spawn": "7.0.5",
    "react-devtools-core": "4.28.4",
    "brace-expansion": "1.1.13",
    "on-headers": "1.1.0",
    "@babel/helpers@7.25.6": "7.26.10",
    "picomatch": "2.3.2",
    "yaml": "2.8.3",
    "diff": "4.0.4",
    "flatted": "3.4.2",
    "lodash": "4.18.1",
    "@xmldom/xmldom": "0.8.13",
    "uuid": "11.1.1",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "fast-uri": "3.1.2",
    "shell-quote": "1.8.4",
    "ajv": "8.18.0",
    "@eslint/eslintrc": {
      "ajv": "6.14.0"
    },
    "eslint": {
      "ajv": "6.14.0"
    },
    "js-yaml": "4.1.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.14.2"
    },
    "@react-native-community/cli-config": {
      "js-yaml": "3.14.2"
    },
    "metro-config": {
      "js-yaml": "3.14.2"
    },
    "minimatch": "3.1.5",
    "react-native-builder-bob": {
      "brace-expansion": "2.0.3",
      "minimatch": "5.1.9"
    }
  }
}
