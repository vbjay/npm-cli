{
  "name": "@testrelic/appium-analytics",
  "version": "1.1.0",
  "description": "Appium test analytics reporter with device log capture, command tracking, network interception, and interactive HTML reports for Android and iOS",
  "keywords": [
    "appium",
    "webdriverio",
    "wdio",
    "test",
    "analytics",
    "reporter",
    "mobile-testing",
    "android",
    "ios",
    "html-report",
    "test-results",
    "device-logs",
    "logcat",
    "test-automation",
    "appium-reporter"
  ],
  "author": "TestRelic AI <hello@testrelic.ai>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./service": {
      "import": {
        "types": "./dist/service.d.ts",
        "default": "./dist/service.js"
      },
      "require": {
        "types": "./dist/service.d.cts",
        "default": "./dist/service.cjs"
      }
    },
    "./merge": {
      "import": {
        "types": "./dist/merge.d.ts",
        "default": "./dist/merge.js"
      },
      "require": {
        "types": "./dist/merge.d.cts",
        "default": "./dist/merge.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "testrelic-appium": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "peerDependencies": {
    "@wdio/reporter": ">=9.0.0",
    "webdriverio": ">=9.0.0"
  },
  "dependencies": {
    "@testrelic/core": "2.4.11"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/reporter": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "@wdio/types": "^9.27.0",
    "mockttp": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "webdriverio": "^9.27.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "homepage": "https://testrelic.ai",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "postinstall": "node scripts/postinstall.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node_modules\\.bin\\wdio run wdio.smoke.conf.ts",
    "test:smoke:mydemoapp": "node_modules\\.bin\\wdio run wdio.mydemoapp.conf.ts",
    "test:e2e:android": "npx wdio run wdio.android.conf.ts",
    "test:e2e:ios": "npx wdio run wdio.ios.conf.ts",
    "download-apps": "node scripts/download-apps.mjs"
  }
}