{
  "name": "wasm-chunkwise",
  "version": "1.0.1",
  "description": "Browser-friendly ChunkWise wrapper (Pyodide + WASM) for Arabic/English text chunking in the browser.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pyodide-wheels/*": "./pyodide-wheels/*"
  },
  "files": [
    "pyodide-wheels/**",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "start": "npx serve",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "backpack": "npm pack",
    "un-old": "npm un wasm-chunkwise --prefix ./examples/wasm-chunkwise-consumer",
    "i-new": "npm i ./wasm-chunkwise-0.1.0.tgz --prefix ./examples/wasm-chunkwise-consumer",
    "try": "npm run dev --prefix ./examples/wasm-chunkwise-consumer",
    "use": "npm run backpack && npm run un-old && npm run i-new && npm run try"
  },
  "keywords": [
    "chunkwise",
    "arabic",
    "english",
    "text-chunking",
    "wasm",
    "pyodide",
    "rag",
    "browser"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "bundleDependencies": [
    "pyodide"
  ],
  "dependencies": {
    "pyodide": "^0.29.0"
  }
}
