{
  "name": "@nuskin/ns-login-react-native",
  "version": "11.0.3",
  "description": "Nu Skin Login Module for React Native",
  "repository": {
    "type": "git",
    "url": "https://code.tls.nuskin.io/ns-am/mobile/applications/luna-and-sol/stela.git",
    "directory": "packages/login-module"
  },
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "ns-login-react-native.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "author": {
    "name": "Mahesh Parmar",
    "email": "mparmar@nuskin.com",
    "url": "https://code.tls.nuskin.io/mparmar"
  },
  "license": "MIT",
  "homepage": "https://code.tls.nuskin.io/ns-am/accounts/mobile/login-module#readme",
  "scripts": {
    "typescript": "tsc --noEmit",
    "prepare": "if [ ! -f 'src/Configuration.ts' ]; then cp src/DefaultConfiguration.ts src/Configuration.ts; fi && npx bob build",
    "mobiledeploy": "../../uberscripts/mobiledeploy ${npm_package_name}",
    "clean": "rm -rf lib",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods",
    "changelog": "../../uberscripts/changelog ${npm_package_name}"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-native": "^0.68.5",
    "react-native-secure-key-store": "2.0.9"
  },
  "dependencies": {
    "@nuskin/mobile-logging": "^1.0.3",
    "@nuskin/utils-module": "^2.0.3",
    "@okta/okta-react-native": "^2.7.0",
    "axios": "^0.27.2",
    "events": "^3.3.0",
    "jwt-decode": "3.1.2",
    "react-native-encrypted-storage": "^4.0.2",
    "tslib": "^2.3.1",
    "zustand": "^3.7.1"
  },
  "devDependencies": {
    "@nuskin/docdash": "1.0.1",
    "jest": "^26.6.3",
    "jest-junit": "12.2.0",
    "jest-sonar-reporter": "2.0.0",
    "jsdoc": "3.6.7",
    "react-native-builder-bob": "0.18.3",
    "typescript": "^4.8.3",
    "patch-package": "^6.4.7"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier",
      "@nuskin/eslint-config-mobile"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ],
      "react-hooks/exhaustive-deps": "off"
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "example/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "commithash": "dd38adc41a6cd7b5d4229f97495250054ba6a15d"
}
