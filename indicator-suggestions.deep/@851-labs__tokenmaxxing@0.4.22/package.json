{
  "name": "@851-labs/tokenmaxxing",
  "version": "0.4.22",
  "description": "CLI for tokenmaxxing — sync your LLM token usage to the leaderboard.",
  "keywords": [
    "ccusage",
    "claude-code",
    "cli",
    "leaderboard",
    "llm",
    "tokens"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/851-labs/tokenmaxxing.git",
    "directory": "apps/cli"
  },
  "bin": {
    "tokenmaxxing": "./bin/tokenmaxxing.exe"
  },
  "scripts": {
    "preinstall": "bun ./install-native.mjs || node ./install-native.mjs"
  },
  "files": [
    "bin",
    "native-bin-launcher.cjs",
    "install-native.mjs",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@851-labs/tokenmaxxing-linux-arm64": "0.4.22",
    "@851-labs/tokenmaxxing-linux-x64": "0.4.22",
    "@851-labs/tokenmaxxing-linux-x64-baseline": "0.4.22",
    "@851-labs/tokenmaxxing-linux-arm64-musl": "0.4.22",
    "@851-labs/tokenmaxxing-linux-x64-musl": "0.4.22",
    "@851-labs/tokenmaxxing-linux-x64-baseline-musl": "0.4.22",
    "@851-labs/tokenmaxxing-darwin-arm64": "0.4.22",
    "@851-labs/tokenmaxxing-darwin-x64": "0.4.22",
    "@851-labs/tokenmaxxing-darwin-x64-baseline": "0.4.22",
    "@851-labs/tokenmaxxing-windows-arm64": "0.4.22",
    "@851-labs/tokenmaxxing-windows-x64": "0.4.22",
    "@851-labs/tokenmaxxing-windows-x64-baseline": "0.4.22"
  }
}
