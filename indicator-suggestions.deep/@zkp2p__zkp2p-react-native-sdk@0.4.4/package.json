{
  "name": "@zkp2p/zkp2p-react-native-sdk",
  "version": "0.4.4",
  "description": "React Native SDK for ZKP2P",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!**/CLAUDE.md"
  ],
  "scripts": {
    "example": "bun run --cwd example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:strict": "eslint \"**/*.{js,ts,tsx}\" --max-warnings=0",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md,yml,yaml}\"",
    "check:all": "bun run typecheck && bun run lint:strict && bun run format:check",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build dist",
    "postinstall": "rm -f node_modules/@zkp2p/indexer-schema/dist/types.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "tsup",
    "release": "release-it",
    "start:dev": "bun run example start",
    "ios:dev": "bun run example ios",
    "android:dev": "bun run example android",
    "build:ios": "bun run example build:ios",
    "build:android": "bun run example build:android"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkp2p/zkp2p-react-native-sdk.git"
  },
  "author": "Richard <richard@zkp2p.xyz> (https://github.com/richardliang)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zkp2p/zkp2p-react-native-sdk/issues"
  },
  "homepage": "https://github.com/zkp2p/zkp2p-react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/compat": "1.4.1",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@evilmartians/lefthook": "2.1.9",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/cli": "20.1.3",
    "@preeternal/react-native-cookie-manager": "6.3.3",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/jest": "29.5.14",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.17",
    "@types/xmldom": "0.1.34",
    "del-cli": "7.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "29.7.0",
    "prettier": "3.8.4",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-webview": "13.16.1",
    "release-it": "20.2.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "viem": "2.52.2"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@preeternal/react-native-cookie-manager": "6.3.3",
    "expo-crypto": "*",
    "expo-web-browser": "*",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-webview": "13.16.1",
    "viem": "2.52.2"
  },
  "peerDependenciesMeta": {
    "expo-crypto": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "bun@1.2.20",
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/dist/"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage/jest/async-storage-mock$": "<rootDir>/src/__mocks__/async-storage-mock.js",
      "^@zkp2p/contracts-v2/abis/(.+)\\.json$": "<rootDir>/node_modules/@zkp2p/contracts-v2/abis/$1.json",
      "^@zkp2p/contracts-v2/abis/(.*)$": "<rootDir>/node_modules/@zkp2p/contracts-v2/abis/$1.cjs",
      "^@zkp2p/contracts-v2/addresses/(.*)$": "<rootDir>/node_modules/@zkp2p/contracts-v2/_cjs/addresses/$1.js",
      "^@zkp2p/contracts-v2/constants/(.*)$": "<rootDir>/node_modules/@zkp2p/contracts-v2/_cjs/constants/$1.js",
      "^@zkp2p/contracts-v2/constants$": "<rootDir>/node_modules/@zkp2p/contracts-v2/_cjs/constants/index.js",
      "^@zkp2p/contracts-v2/paymentMethods/(.+)\\.json$": "<rootDir>/node_modules/@zkp2p/contracts-v2/paymentMethods/$1.json",
      "^@zkp2p/contracts-v2/paymentMethods/(.*)$": "<rootDir>/node_modules/@zkp2p/contracts-v2/_cjs/paymentMethods/$1.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|@noble/curves|@noble/hashes)/)"
    ],
    "watchman": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {}
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "codegenConfig": {
    "name": "Zkp2pReactNativeSdkSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.zkp2preactnativesdk"
    }
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "version": "0.50.2"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@zkp2p/contracts-v2": "0.2.4",
    "@zkp2p/sdk": "0.6.3",
    "@zkp2p/zkp2p-attestation": "1.6.3",
    "ethers": "6.17.0",
    "fast-text-encoding": "1.0.6",
    "jsonpath-plus": "10.4.0",
    "node-forge": "1.4.0",
    "ox": "0.14.29",
    "xmldom": "0.6.0",
    "xpath": "0.0.34",
    "xpath-html": "1.0.3"
  },
  "trustedDependencies": [
    "@evilmartians/lefthook",
    "@zkp2p/zkp2p-react-native-sdk",
    "esbuild",
    "koffi",
    "protobufjs",
    "re2"
  ]
}
