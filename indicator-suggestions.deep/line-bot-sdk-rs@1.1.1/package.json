{
  "name": "line-bot-sdk-rs",
  "version": "1.1.1",
  "description": "High-performance LINE Messaging API SDK built with Rust and NAPI-RS",
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./native": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "license": "MIT",
  "keywords": [
    "line",
    "line-bot",
    "line-messaging-api",
    "line-sdk",
    "napi-rs",
    "rust"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "dist"
  ],
  "napi": {
    "binaryName": "line-bot-sdk-rs",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "app:dev": "yarn --cwd app dev",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:js": "tsc -p tsconfig.publish.json",
    "publish:npm": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-npm.ps1",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "prepublishOnly": "yarn build:js && napi prepublish -t npm",
    "test": "ava",
    "preversion": "napi build --platform && git add .",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@oxc-node/core": "^0.1.0",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "@types/node": "^25.9.3",
    "ava": "^8.0.0",
    "chalk": "^5.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.14.0",
    "prettier": "^3.6.2",
    "tinybench": "^6.0.0",
    "typescript": "^6.0.0"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "app"
  ],
  "author": "Panudet Ingai",
  "optionalDependencies": {
    "line-bot-sdk-rs-darwin-arm64": "1.1.1",
    "line-bot-sdk-rs-darwin-x64": "1.1.1",
    "line-bot-sdk-rs-linux-x64-gnu": "1.1.1",
    "line-bot-sdk-rs-win32-x64-msvc": "1.1.1"
  }
}