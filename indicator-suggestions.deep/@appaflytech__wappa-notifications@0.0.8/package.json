{
  "name": "@appaflytech/wappa-notifications",
  "version": "0.0.8",
  "description": "Drop-in push notifications for Expo / React Native apps, powered by the Wappa panel. One env variable, one function call.",
  "keywords": [
    "expo",
    "react-native",
    "push-notifications",
    "notifications",
    "wappa",
    "expo-notifications"
  ],
  "license": "MIT",
  "author": "Wappa",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "app.plugin.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@expo/config-plugins": "^9.0.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "@react-native-firebase/app": ">=17.0.0",
    "@react-native-firebase/messaging": ">=17.0.0",
    "expo-device": ">=5.0.0",
    "expo-notifications": ">=0.20.0",
    "react": ">=17.0.0",
    "react-native": ">=0.68.0"
  },
  "peerDependenciesMeta": {
    "expo-constants": {
      "optional": true
    },
    "@react-native-firebase/app": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}