{
    "name": "bureau-core",
    "version": "3.0.0",
    "description": "Bureau Core - Shared interface for Bureau SDKs",
    "main": "lib/commonjs/index.js",
    "module": "lib/module/index.js",
    "types": "lib/typescript/index.d.ts",
    "react-native": "src/index.ts",
    "source": "src/index.ts",
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "bureau-core.podspec",
        "!lib/typescript/example",
        "!android/build",
        "!ios/build",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/android/**/build",
        "!**/ios/**/build"
    ],
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:ci": "jest --ci --coverage --watchAll=false",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
        "typecheck": "tsc --noEmit",
        "build": "bob build",
        "prepare": "bob build",
        "release": "release-it",
        "example": "yarn --cwd example"
    },
    "keywords": [
        "react-native",
        "ios",
        "android",
        "bureau",
        "core",
        "interfaces",
        "types"
    ],
    "repository": "https://github.com/bureau-id/bureau-fraud-intelligence-monorepo",
    "author": "Bureau <support@bureau.id>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/bureau-id/bureau-fraud-intelligence-monorepo/issues"
    },
    "homepage": "https://github.com/bureau-id/bureau-fraud-intelligence-monorepo#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@types/jest": "^29.5.5",
        "@types/react": "^18.0.24",
        "@types/react-native": "0.72.6",
        "@typescript-eslint/eslint-plugin": "^5.0.0",
        "@typescript-eslint/parser": "^5.0.0",
        "eslint": "^8.4.1",
        "eslint-plugin-prettier": "^4.0.0",
        "jest": "^29.2.1",
        "prettier": "^2.0.5",
        "react": "18.2.0",
        "react-native": "0.72.7",
        "react-native-builder-bob": "^0.20.0",
        "ts-jest": "^29.1.0",
        "typescript": "4.8.4"
    },
    "peerDependencies": {
        "react": "*",
        "react-native": "*"
    },
    "eslintConfig": {
        "root": true,
        "extends": [
            "eslint:recommended"
        ],
        "parser": "@typescript-eslint/parser",
        "plugins": [
            "@typescript-eslint"
        ],
        "env": {
            "node": true,
            "es2021": true,
            "jest": true
        },
        "parserOptions": {
            "ecmaVersion": "latest",
            "sourceType": "module"
        },
        "rules": {
            "no-unused-vars": "off",
            "@typescript-eslint/no-unused-vars": "warn",
            "no-console": "warn"
        }
    },
    "eslintIgnore": [
        "node_modules/",
        "lib/",
        "jest.config.js"
    ],
    "prettier": {
        "quoteProps": "consistent",
        "singleQuote": true,
        "tabWidth": 2,
        "trailingComma": "es5",
        "useTabs": false
    },
    "engines": {
        "node": ">=16"
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            "commonjs",
            "module",
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    },
    "gitHead": "eead79dc03aaef786463ce33bce556fc767573b5"
}
