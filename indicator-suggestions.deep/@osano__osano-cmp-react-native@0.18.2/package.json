{
	"name": "@osano/osano-cmp-react-native",
	"version": "0.18.2",
	"description": "Package and example for the react-native Osano CMP SDK",
	"main": "lib/commonjs/index",
	"module": "lib/module/index",
	"types": "lib/typescript/src/index.d.ts",
	"react-native": "src/index",
	"source": "src/index",
	"files": [
		"src",
		"lib",
		"android",
		"ios",
		"cpp",
		"*.podspec",
		"!ios/build",
		"!android/build",
		"!android/gradle",
		"!android/gradlew",
		"!android/gradlew.bat",
		"!android/local.properties",
		"!**/__tests__",
		"!**/__fixtures__",
		"!**/__mocks__",
		"!**/.*",
		"!lib/typescript/webdriverio-appium/**",
		"!lib/typescript/webdriverio-appium/common/**",
		"!lib/typescript/webdriverio-appium/config/**",
		"!lib/typescript/webdriverio-appium/test/**"
	],
	"scripts": {
		"example": "yarn workspace osano-cmp-sdk-example",
		"test": "jest src/services/__tests__/consent.test.ts src/services/__tests__/fetchConfig.test.ts src/__tests__/index.test.tsx src/services/__tests__/google-consent-mode.test.ts src/__tests__/OsanoLogger.test.ts src/__tests__/constants.test.ts src/__tests__/reducer.test.ts src/__tests__/selectors.test.ts src/__tests__/ConsentManager.test.ts src/__tests__/ConsentUiBuilder.test.tsx src/utils/__tests__/WebStorage.test.ts src/native/__tests__/OsanoCmp.test.ts",
		"test:legacy": "REACT_NATIVE_NEW_ARCH_ENABLED=false jest src/services/__tests__/consent.test.ts src/services/__tests__/fetchConfig.test.ts src/__tests__/index.test.tsx src/services/__tests__/google-consent-mode.test.ts src/__tests__/OsanoLogger.test.ts src/__tests__/constants.test.ts src/__tests__/reducer.test.ts src/__tests__/selectors.test.ts src/__tests__/ConsentManager.test.ts src/__tests__/ConsentUiBuilder.test.tsx src/utils/__tests__/WebStorage.test.ts src/native/__tests__/OsanoCmp.test.ts",
		"test:newarch": "REACT_NATIVE_NEW_ARCH_ENABLED=true jest src/services/__tests__/consent.test.ts src/services/__tests__/fetchConfig.test.ts src/__tests__/index.test.tsx src/services/__tests__/google-consent-mode.test.ts src/__tests__/OsanoLogger.test.ts src/__tests__/constants.test.ts src/__tests__/reducer.test.ts src/__tests__/selectors.test.ts src/__tests__/ConsentManager.test.ts src/__tests__/ConsentUiBuilder.test.tsx src/utils/__tests__/WebStorage.test.ts src/native/__tests__/OsanoCmp.test.ts",
		"test:google-consent-mode": "jest src/services/__tests__/google-consent-mode.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
		"clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
		"update:locale": "node ./scripts/updateLocalization.js",
		"prepare": "bob build",
		"verify-build": "node scripts/verify-build.js",
		"verify-integration": "bash scripts/verify-integration.sh",
		"release": "release-it",
		"release:prod": "release-it --no-increment --no-git --ci -VV",
		"doc:start": "docusaurus start ./documentation",
		"doc:build": "docusaurus build ./documentation",
		"doc:clear": "docusaurus clear ./documentation",
		"doc:serve": "docusaurus serve ./documentation"
	},
	"keywords": [
		"react-native",
		"ios",
		"android"
	],
	"repository": {
		"type": "git",
		"url": ""
	},
	"author": "Osano (A Public Benefit Company) <engineering@osano.com> (https://www.osano.com)",
	"license": "UNLICENSED",
	"bugs": {
		"url": "https://github.com/osano/osano-consentmgr-react-native/issues"
	},
	"homepage": "https://developers.osano.com/cmp/mobile-sdks/",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.2",
		"@commitlint/config-conventional": "^17.0.2",
		"@docusaurus/core": "3.5.2",
		"@docusaurus/module-type-aliases": "3.5.2",
		"@docusaurus/preset-classic": "3.5.2",
		"@mdx-js/react": "^3.0.1",
		"@react-native-community/cli": "^20.1.3",
		"@react-native/babel-preset": "0.85.0",
		"@react-native/jest-preset": "^0.85.2",
		"@testing-library/react-native": "^13.3.3",
		"@types/jest": "^29.5.5",
		"@types/react": "^19.1.1",
		"@types/text-encoding": "^0.0.39",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"commitlint": "^17.0.2",
		"del-cli": "^5.1.0",
		"eslint": "^10.1.0",
		"jest": "^29.7.0",
		"prettier": "^3.0.3",
		"prism-react-renderer": "^2.4.0",
		"react": "19.2.3",
		"react-native": "0.85.0",
		"react-native-builder-bob": "^0.40.18",
		"react-test-renderer": "19.2.3",
		"release-it": "^17.11.0",
		"turbo": "^1.10.7",
		"typescript": "^5.2.2"
	},
	"resolutions": {
		"@types/react": "^19.1.1"
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*"
	},
	"overrides": {
		"axios": "^1.6.4",
		"trim": "^1.0.1",
		"inflight": "^1.0.6",
		"glob": "^9.3.5"
	},
	"workspaces": [
		"example",
		"documentation"
	],
	"packageManager": "yarn@3.6.4",
	"jest": {
		"preset": "@react-native/jest-preset",
		"setupFilesAfterEnv": [
			"<rootDir>/src/__tests__/setup.ts"
		],
		"modulePathIgnorePatterns": [
			"<rootDir>/example/node_modules",
			"<rootDir>/lib/"
		],
		"transformIgnorePatterns": [
			"node_modules/(?!(react-native|@react-native|react-native-svg|@testing-library/react-native)/)"
		],
		"collectCoverageFrom": [
			"src/**/*.{ts,tsx}",
			"!src/**/__tests__/**",
			"!src/**/*.test.{ts,tsx}",
			"!src/**/types.ts"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"release-it": {
		"git": {
			"requireBranch": false,
			"commit": false,
			"tag": false,
			"push": false
		},
		"npm": {
			"publish": true,
			"versionArgs": "--no-git-tag-version"
		},
		"github": {
			"release": false
		},
		"hooks": {
			"before:init": "echo 'Using version from package.json: ${version}'"
		}
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"targets": [
			"commonjs",
			"module",
			[
				"typescript",
				{
					"project": "tsconfig.build.json"
				}
			]
		]
	},
	"codegenConfig": {
		"name": "RNOsanoCmpSdkSpec",
		"type": "modules",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "com.osano.cmp.sdk"
		}
	},
	"dependencies": {
		"corepack": "^0.34.6",
		"js-sha512": "^0.9.0",
		"react-native-picker-modal-view": "^1.3.2",
		"react-native-svg": "^15.11.0",
		"text-encoding": "^0.7.0"
	}
}
