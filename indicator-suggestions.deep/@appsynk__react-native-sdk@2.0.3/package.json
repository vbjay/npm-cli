{
  "name": "@appsynk/react-native-sdk",
  "version": "2.0.3",
  "description": "AppSynk Mobile Attribution SDK for React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "expo",
    "app.plugin.js",
    "react-native.config.js",
    "AppSynkBridge.podspec",
    "!lib/commonjs/__tests__",
    "!lib/module/__tests__",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typescript": "tsc --noEmit",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "mobile",
    "attribution",
    "analytics",
    "mmp"
  ],
  "author": "AppSynk",
  "license": "MIT",
  "expo": {
    "name": "@appsynk/react-native-sdk",
    "plugin": "./expo/withAppSynk"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^56.0.8",
    "@react-native-community/eslint-config": "^3.0.0",
    "@types/react": "^18.2.79",
    "react": "^18.2.0",
    "react-native": "^0.74.5",
    "react-native-builder-bob": "^0.42.1",
    "typescript": "^5.9.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
