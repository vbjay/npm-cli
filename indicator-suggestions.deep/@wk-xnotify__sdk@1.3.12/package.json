{
  "name": "@wk-xnotify/sdk",
  "version": "1.3.12",
  "description": "Official XNotify SDK — web push client + management API + React Native (FCM)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react-entry.d.ts",
      "import": "./dist/react-entry.mjs",
      "require": "./dist/react-entry.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.mjs",
      "require": "./dist/react-native.js"
    }
  },
  "files": [
    "dist/**/*",
    "android/**/*",
    "react-native.config.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test:react-native": "node ./scripts/test-react-native.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run type-check && npm run build"
  },
  "keywords": [
    "xnotify",
    "push-notifications",
    "web-push",
    "notifications",
    "sdk",
    "typescript",
    "react",
    "react-native"
  ],
  "author": "XNotify Team",
  "license": "MIT",
  "homepage": "https://xnotify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webknot-cenomi/xnotify.git"
  },
  "bugs": {
    "url": "https://github.com/webknot-cenomi/xnotify/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.8",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@react-native-firebase/messaging": ">=18.0.0",
    "react": ">=16.8.0",
    "react-native": ">=0.71.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
