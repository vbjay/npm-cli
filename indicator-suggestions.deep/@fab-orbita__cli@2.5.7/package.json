{
  "name": "@fab-orbita/cli",
  "version": "2.5.7",
  "description": "Fab Orbita CLI — Российский реестр пакетов",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fab": "./bin/fab.js",
    "фаб": "./bin/fab.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const pkg=require('./package.json'); const fs=require('fs'); const path=require('path'); const files=['./dist/index.js','./dist/index.d.ts']; files.forEach(file=>{ const p=path.join(__dirname, file); if(fs.existsSync(p)){ let content=fs.readFileSync(p,'utf8'); content=content.replace(/__VERSION__/g, pkg.version); fs.writeFileSync(p, content); }});\"",
    "build:all": "npm run build && npm run build:bin && npm run build:exe",
    "build:bin": "chmod +x bin/fab.js",
    "build:exe": "pkg package.json --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output bin/",
    "build:exe:win": "pkg package.json --targets node18-win-x64 --output bin/fab-windows.exe",
    "build:exe:linux": "pkg package.json --targets node18-linux-x64 --output bin/fab-linux",
    "build:exe:mac": "pkg package.json --targets node18-macos-x64 --output bin/fab-macos",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist bin/*.exe bin/*-linux bin/*-macos",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "fab",
    "registry",
    "cli",
    "package-manager",
    "npm-alternative",
    "russian-registry",
    "devorbit"
  ],
  "author": {
    "name": "ООО \"ДЕВОРБИТ\"",
    "email": "support@devorbit.ru"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "conf": "^15.1.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1",
    "inquirer": "^8.2.5",
    "open": "^11.0.0",
    "ora": "^5.4.1",
    "qrcode": "^1.5.4",
    "semver": "^7.5.4",
    "tmp": "^0.2.1",
    "which": "^3.0.1",
    "yaml": "^2.3.2",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/chalk": "^2.2.0",
    "@types/fs-extra": "^11.0.1",
    "@types/inquirer": "^8.2.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.17.15",
    "@types/open": "^6.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.5.1",
    "@types/tar": "^6.1.5",
    "@types/tmp": "^0.2.3",
    "@types/which": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.1",
    "minimatch": "^9.0.8",
    "pkg": "^5.8.1",
    "prettier": "^3.0.3",
    "tar": "^7.5.19",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}