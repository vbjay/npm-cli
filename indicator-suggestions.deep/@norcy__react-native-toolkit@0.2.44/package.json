{
  "name": "@norcy/react-native-toolkit",
  "version": "0.2.44",
  "private": false,
  "description": "My Toolkit",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "postinstall": "husky || true",
    "build": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/Norcy/react-native-toolkit",
  "author": "Norcy <chenyg32@gmail.com> (https://github.com/Norcy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Norcy/react-native-toolkit/issues"
  },
  "homepage": "https://github.com/Norcy/react-native-toolkit#readme",
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@react-native/babel-preset": "0.74.88",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@invertase/react-native-apple-authentication": "^2.1.2",
    "@leancloud/platform-adapters-react-native": "^0.7.0",
    "@react-native-async-storage/async-storage": "^1.19.0",
    "@react-native-camera-roll/camera-roll": "^5.0.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native-masked-view/masked-view": "^0.3.0",
    "@release-it/conventional-changelog": "^8.0.2",
    "@sentry/cli": "^2.58.0",
    "@sentry/react-native": "^6.12.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.2.0",
    "baseline-browser-mapping": "^2.10.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "i18n-js": "^4.2.2",
    "jest": "^29.7.0",
    "js-sha1": "^0.7.0",
    "leancloud-storage": "^4.15.2",
    "pod-install": "^0.1.0",
    "prettier": "^3.3.3",
    "query-string": "^8.0.0",
    "react": "18.2.0",
    "react-native": "0.74.6",
    "react-native-blob-util": "^0.19.11",
    "react-native-builder-bob": "^0.30.2",
    "react-native-device-info": "^11.1.0",
    "react-native-gesture-handler": "^2.0.0",
    "react-native-in-app-review": "^4.4.2",
    "react-native-mmkv": "^3.3.3",
    "react-native-purchases": "^7.28.1",
    "react-native-safe-area-context": "^4.0.0",
    "react-native-screens": "^3.0.0",
    "react-native-simple-toast": "^1.1.3",
    "react-native-splash-screen": "^3.3.0",
    "react-native-wechat-lib": "^1.1.26",
    "release-it": "^17.7.0",
    "semver": "^7.3.7",
    "typescript": "~5.1.6"
  },
  "peerDependencies": {
    "@invertase/react-native-apple-authentication": "*",
    "@leancloud/platform-adapters-react-native": "*",
    "@react-native-async-storage/async-storage": "*",
    "@react-native-camera-roll/camera-roll": "*",
    "@react-native-clipboard/clipboard": "*",
    "@react-native-masked-view/masked-view": "*",
    "@sentry/react-native": "*",
    "i18n-js": "*",
    "js-sha1": "*",
    "leancloud-storage": "*",
    "query-string": "^8.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-blob-util": "*",
    "react-native-device-info": "*",
    "react-native-gesture-handler": "^2.0.0",
    "react-native-in-app-review": "*",
    "react-native-mmkv": "^3.3.3",
    "react-native-purchases": "*",
    "react-native-safe-area-context": "^4.0.0",
    "react-native-screens": "^3.0.0",
    "react-native-simple-toast": "*",
    "react-native-splash-screen": "*",
    "react-native-wechat-lib": "*",
    "semver": "*"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "resolutions": {
    "@types/react": "18.2.0",
    "del": "^5.1.0",
    "glob": "^8.1.0",
    "rimraf": "^3.0.2",
    "uuid": "^9.0.0",
    "superagent": "^8.1.2",
    "minimatch": "^9.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
