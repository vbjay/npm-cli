{
  "name": "@retray-dev/ui-kit",
  "version": "14.2.1",
  "description": "Personal UI Kit for React Native / Expo",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.mjs",
      "require": "./dist/fonts.js"
    },
    "./curatedIcons": {
      "types": "./dist/curatedIcons.d.ts",
      "import": "./dist/curatedIcons.mjs",
      "require": "./dist/curatedIcons.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "CONSUMER.md",
    "EXAMPLES.md",
    "FONTS.md",
    "DESIGN.md",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-fonts.js",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint:all": "pnpm lint && pnpm --filter retray-ui-kit-example lint",
    "format:all": "pnpm format && pnpm --filter retray-ui-kit-example format",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:fonts": "./scripts/test-consumer-fonts.sh",
    "deploy": "pnpm typecheck && pnpm build && npm publish --access public"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui-kit",
    "components"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lucide-react-native": ">=1.23.0",
    "@gorhom/bottom-sheet": ">=5.2.0",
    "@react-native-community/slider": ">=4.0.0",
    "@react-native-community/datetimepicker": ">=8.0.0",
    "@react-native-picker/picker": ">=2.0.0",
    "@shopify/react-native-skia": ">=1.0.0",
    "expo-font": ">=14.0.0",
    "expo-haptics": ">=14.0.0",
    "expo-image": ">=3.0.0",
    "expo-linear-gradient": ">=13.0.0",
    "expo-modules-core": ">=3.0.0",
    "expo-sensors": ">=13.0.0",
    "pressto": ">=0.6.0",
    "react": ">=17",
    "react-native": ">=0.76",
    "react-native-ease": ">=0.7.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-image-picker": ">=7.0.0",
    "react-native-reanimated": ">=4.0.0 <5.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-screens": ">=3.0.0",
    "react-native-size-matters": ">=0.4.0",
    "react-native-svg": ">=15.0.0",
    "react-native-worklets": ">=0.5.1",
    "sonner-native": ">=0.22.0"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    },
    "react-native-ease": {
      "optional": false
    },
    "pressto": {
      "optional": false
    },
    "react-native-image-picker": {
      "optional": true
    },
    "@react-native-community/datetimepicker": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "^5.5.7",
      "react": "19.1.0",
      "react-native": "0.81.5",
      "react-native-worklets": "0.5.1",
      "@types/react": "19.1.17",
      "react-native-safe-area-context": "5.6.2",
      "@gorhom/bottom-sheet": "5.2.14",
      "expo": "54.0.35"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "lucide-react-native": "^1.23.0",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-community/slider": "5.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@shopify/react-native-skia": "2.2.12",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "19.1.17",
    "babel-preset-expo": "~54.0.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "jest-expo": "~54.0.17",
    "pressto": "^0.7.0",
    "prettier": "^3.8.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ease": "^0.7.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "~0.5.1",
    "sonner-native": "0.26.3",
    "test-renderer": "^1.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.0"
  },
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912"
}
