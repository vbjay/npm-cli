{
  "name": "appconsent-clear-reactnative",
  "version": "2.7.0",
  "description": "AppConsent® cmp, the transparency-based consent management platform.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "CHANGELOG.md",
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "appconsent-clear-reactnative.podspec",
    "!lib/typescript/example",
    "!doc",
    "!**/build",
    "!**/.idea",
    "!**/.gradle",
    "!**/gradle",
    "!**/gradlew",
    "!**/gradlew.bat",
    "!**/local.properties",
    "!**/gradle.properties",
    "!ios/build",
    "!**/project.xcworkspace",
    "!**/xcuserdata",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/android/src/test"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --ignore-pattern \"**/ios/*\" --ignore-pattern \"**/android/*\" --ignore-pattern \"**/docs/*\"",
    "prepare": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods",
    "typedoc": "typedoc --options typedoc.json",
    "docusaurus": "yarn typedoc;sh scripts/bump_docusaurus.sh"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "app-consent",
    "appconsent",
    "cmp",
    "sfbx"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.datalf.chat/sfbx/dev/appconsent/cmp/mobile/react-native/appconsent-clear-reactnative.git"
  },
  "author": "sfbx <contact@sfbx.io> (https://sfbx.io)",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.datalf.chat/sfbx/dev/appconsent/cmp/mobile/react-native/appconsent-clear-reactnative.git/issues"
  },
  "homepage": "https://sfbx.io",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "devDependencies": {
    "@commitlint/config-conventional": "^11.0.0",
    "@react-native-community/eslint-config": "^3.0.3",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^26.0.0",
    "@types/react": "^18.0.0",
    "@types/react-native": "0.68.0",
    "commitlint": "^11.0.0",
    "eslint": "^8.18.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^6.0.0",
    "jest": "^26.6.3",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "18.0.0",
    "react-native": "0.68.5",
    "react-native-builder-bob": "^0.18.0",
    "release-it": "^15.1.1",
    "typedoc": "0.23.10",
    "typedoc-plugin-missing-exports": "1.0.0",
    "typescript": "^4.1.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "${version}"
    },
    "npm": {
      "publish": true
    },
    "gitlab": {
      "release": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": "conventionalcommits",
        "context": {
          "linkCompare": false,
          "linkReferences": false
        }
      }
    },
    "hooks": {
      "before:init": [
        "yarn lint",
        "yarn typescript",
        "yarn test"
      ],
      "after:bump": [
        "yarn typedoc"
      ],
      "after:git:release": [
        "echo After git push, before gitlab release"
      ],
      "after:release": [
        "sh scripts/bump_docusaurus.sh",
        "echo Successfully released ${name} v${version} to ${repo.repository}."
      ]
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
