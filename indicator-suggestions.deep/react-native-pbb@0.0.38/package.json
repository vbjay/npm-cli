{
  "name": "react-native-pbb",
  "version": "0.0.38",
  "description": "React Native组件库",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "lib",
    "!**/__test__",
    "!**/docs"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "commit": "cz",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "docs:docgen": "node docgen",
    "docs:start": "node docgen && dumi dev",
    "docs:build": "node docgen && dumi build",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch --coverage",
    "release": "bob build && release-it",
    "postinstall": "patch-package"
  },
  "keywords": [
    "react-native",
    "pbb"
  ],
  "author": "pbb",
  "license": "",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^15.0.0",
    "@commitlint/config-conventional": "^15.0.0",
    "@react-native-community/eslint-config": "^2.0.0",
    "@react-native-community/hooks": "^2.8.1",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^5.14.9",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.10",
    "@types/lodash": "^4.14.175",
    "@types/react": "^18.0.24",
    "@types/react-native-linear-gradient": "^2.4.0",
    "@types/react-test-renderer": "^18.0.2",
    "@types/set-cookie-parser": "^2.4.2",
    "aliyun-oss-react-native": "git+https://gitee.com/pbb-frontend/aliyun-oss-react-native.git",
    "axios": "^0.21.1",
    "axios-mock-adapter": "^1.22.0",
    "commitizen": "^4.2.3",
    "conventional-changelog-cli": "^2.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "dumi": "^1.0.13",
    "eslint": "^7.14.0",
    "eslint-config-prettier": "^8.1.0",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "lint-staged": "^12.1.2",
    "lodash": "^4.17.21",
    "metro-react-native-babel-preset": "0.73.9",
    "moment": "^2.27.0",
    "react": "18.2.0",
    "react-docgen": "^5.4.0",
    "react-native": "0.71.7",
    "react-native-builder-bob": "^0.20.4",
    "react-native-date-picker": "^4.2.5",
    "react-native-device-info": "^11.1.0",
    "react-native-fast-image": "^8.3.2",
    "react-native-gesture-handler": "^1.10.3",
    "react-native-hw-obs": "git+https://gitee.com/pbb-frontend/react-native-hw-obs.git",
    "react-native-linear-gradient": "^2.5.6",
    "react-native-reanimated": "3.6.1",
    "react-native-refresh": "^2.0.17",
    "react-native-safe-area-context": "^3.2.0",
    "react-native-screens": "^3.27.0",
    "react-native-svg": "^12.1.1",
    "react-test-renderer": "18.2.0",
    "release-it": "^15.9.3",
    "rn-codepush": "^1.3.0",
    "set-cookie-parser": "^2.6.0",
    "typescript": "^4.8.4",
    "validate-commit-msg": "^2.14.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npm run lint:fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "sourceMaps": false,
          "copyFlow": false
        }
      ],
      [
        "module",
        {
          "sourceMaps": false
        }
      ],
      "typescript"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@types/crypto-js": "^4.1.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react-docgen-typescript": "^2.2.2",
    "react-native-simple-toast": "^3.3.1"
  }
}
