{
  "name": "@aarushdixit73/zest",
  "version": "2.0.9",
  "description": "AI-powered companion — agent, plan, ask",
  "type": "module",
  "bin": {
    "zest": "./dist/zest.js"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --target bun src/cli-entry.ts --outfile dist/zest.js",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build",
    "link": "bun link @aarushdixit73/zest"
  },
  "engines": {
    "bun": ">= 1.0.0"
  },
  "files": [
    "dist/zest.js",
    "src/**/*.ts",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "ai",
    "langchain",
    "agent",
    "terminal",
    "openrouter"
  ],
  "author": "Aarush",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/core": "^1.4.0",
    "@clack/prompts": "^1.5.0",
    "@hapi/boom": "^10.0.1",
    "@inquirer/confirm": "^6.1.1",
    "@inquirer/core": "^11.2.1",
    "@inquirer/input": "^5.1.2",
    "@inquirer/select": "^5.2.1",
    "@langchain/core": "^1.1.48",
    "@langchain/openrouter": "^0.3.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "discord.js": "^14.26.4",
    "grammy": "^1.43.0",
    "inquirer": "^14.0.2",
    "langchain": "^1.4.2",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  }
}
