{
  "name": "@saidatom/storybook-addon-code",
  "version": "1.0.0",
  "description": "A Storybook addon that extracts and displays syntax-highlighted source code. Fork of the @whitespace-se/storybook-addon-code addon.",
  "keywords": [
    "addon",
    "storybook",
    "code",
    "source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saidatom/storybook-addon-code.git"
  },
  "scripts": {
    "build": "npm run clean & babel -d ./dist ./src",
    "build:watch": "babel --watch -d ./dist ./src",
    "clean": "rm -rf ./dist",
    "prepare": "npm run build",
    "prettier": "prettier --write '**/*.{js,json,md,yml}'"
  },
  "author": "Whitespace",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@storybook/addon-actions": "^8.5.0",
    "@storybook/addon-links": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@babel/eslint-parser": "^7.26.5",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "prettier": "^3.4.2",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@babel/generator": "^7.26.5",
    "@babel/parser": "^7.26.5",
    "@storybook/addons": "^7.6.17",
    "@storybook/source-loader": "^8.5.0",
    "estraverse": "^5.3.0",
    "prismjs": "^1.29.0",
    "react-syntax-highlighter": "^15.6.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
