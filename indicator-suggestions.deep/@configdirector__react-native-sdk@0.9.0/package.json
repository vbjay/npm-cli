{
  "name": "@configdirector/react-native-sdk",
  "version": "0.9.0",
  "description": "React Native client SDK for ConfigDirector. ConfigDirector is a remote configuration and feature flag service.",
  "license": "MIT",
  "author": "ConfigDirector",
  "keywords": [
    "configdirector",
    "configdirector react native",
    "config",
    "configuration",
    "remote config",
    "remote configuration",
    "feature flag",
    "feature toggle",
    "feature switch",
    "react-native",
    "ios",
    "android"
  ],
  "homepage": "https://www.configdirector.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConfigDirector/js-sdks.git"
  },
  "main": "./dist/configdirector-react-native.mjs",
  "types": "./dist/configdirector-react-native.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "react-native": "./dist/configdirector-react-native.mjs",
      "types": "./dist/configdirector-react-native.d.mts",
      "default": "./dist/configdirector-react-native.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "example": "yarn workspace @configdirector/react-native-sdk-example",
    "clean": "rm -fr dist",
    "build": "tsdown",
    "prepare": "yarn build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest --watchAll",
    "ci:test": "jest --ci",
    "coverage": "jest --ci --coverage",
    "release": "yarn clean && yarn lint && yarn ci:test && yarn build && npm publish --access public"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "^0.85.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/babel__core": "^7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19",
    "@types/wtfnode": "^0",
    "babel-jest": "^30.3.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.2.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "tsdown": "^0.21.7",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "wtfnode": "^0.10.1"
  },
  "peerDependencies": {
    "expo": ">=52",
    "react": "*",
    "react-native": ">=0.75"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint"
    ],
    "version": "0.61.0"
  },
  "jest": {
    "preset": "react-native",
    "testMatch": [
      "<rootDir>/test/**/*.spec.{ts,tsx}"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@js-client-core/(.*)$": "<rootDir>/../js-client-core/src/$1",
      "^@shared/(.*)$": "<rootDir>/../shared/src/$1",
      "^@eventsource/(.*)$": "<rootDir>/../eventsource/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@noble)/)"
    ]
  }
}
