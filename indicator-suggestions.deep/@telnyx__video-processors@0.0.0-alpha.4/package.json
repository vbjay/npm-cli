{
  "name": "@telnyx/video-processors",
  "title": "Telnyx Video Processors",
  "version": "0.0.0-alpha.4",
  "description": "Telnyx Video Processors JavaScript Library",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib"
  ],
  "homepage": "https://github.com/team-telnyx/video-processors-js#readme",
  "author": "Deivid Veloso <deivid@telnyx.com>",
  "license": "Apache-2.0",
  "keywords": [
    "telnyx",
    "webrtc",
    "library",
    "javascript",
    "video",
    "processors",
    "virtual background"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-telnyx/video-processors-js.git"
  },
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "prepare": "yarn build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "release": "NODE_DEBUG=release-it:* release-it"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1640029074",
    "@mediapipe/selfie_segmentation": "^0.1.1632777926"
  },
  "devDependencies": {
    "@babel/core": "^7.13.14",
    "@babel/preset-env": "^7.13.12",
    "@babel/preset-typescript": "^7.13.0",
    "@release-it/bumper": "^4.0.0",
    "@rollup/plugin-commonjs": "^22.0.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@types/jest": "^26.0.20",
    "@types/node": "^17.0.33",
    "babel-jest": "^26.6.3",
    "eslint": "^7.21.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-plugin-import": "^2.22.1",
    "jest": "^26.6.3",
    "prettier": "^2.2.1",
    "release-it": "^15.1.1",
    "rollup": "^2.68.0",
    "rollup-plugin-commonjs": "^10.0.2",
    "rollup-plugin-terser": "^7.0.0",
    "rollup-plugin-typescript2": "^0.24.0",
    "typescript": "^4.4.4"
  },
  "publishConfig": {
    "access": "public",
    "@telnyx:registry": "https://registry.npmjs.org"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "requireBranch": "main",
      "changelog": "git log $(git describe --tags --abbrev=0)..HEAD --pretty=format:'%s' | grep -i -E '^(feat|fix|docs|refactor|chore)'",
      "commitMessage": "Release video-processors ${version}",
      "tagAnnotation": "Release video-processors ${version}",
      "tagName": "video-processors/v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "video-processors@${version}",
      "releaseNotes": "git log $(git describe --tags --abbrev=0)..HEAD --pretty=format:'%s' | grep -i -E '^(feat|fix|docs|refactor|chore)'"
    }
  }
}
