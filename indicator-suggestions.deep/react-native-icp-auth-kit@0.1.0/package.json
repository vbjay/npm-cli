{
  "name": "react-native-icp-auth-kit",
  "version": "0.1.0",
  "description": "Internet Computer Protocol (ICP) authentication and agent library for React Native",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js || true",
    "test": "jest",
    "example": "cd example && npm install && npm start"
  },
  "keywords": [
    "icp",
    "internet-computer",
    "react-native",
    "authentication",
    "dfinity",
    "blockchain",
    "web3"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.0.0",
    "react-native": ">=0.60.0"
  },
  "dependencies": {
    "@dfinity/agent": "^1.1.0",
    "@dfinity/candid": "^1.1.0",
    "@dfinity/identity": "^1.1.0",
    "@dfinity/principal": "^1.1.0",
    "@noble/curves": "^1.3.0",
    "@scure/bip32": "^1.3.3",
    "@scure/bip39": "^1.2.2",
    "react-native-get-random-values": "^1.11.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-native": {
      "optional": false
    }
  },
  "bundledDependencies": [],
  "optionalDependencies": {
    "@react-native-async-storage/async-storage": "^1.23.0",
    "expo-secure-store": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.72.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ]
}
