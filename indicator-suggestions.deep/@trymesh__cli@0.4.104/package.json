{
  "name": "@trymesh/cli",
  "version": "0.4.104",
  "private": false,
  "type": "module",
  "description": "Mesh terminal agent CLI — token-efficient coding agent with a shared LLM gateway.",
  "keywords": [
    "ai",
    "ai-agent",
    "agent",
    "agentic",
    "autonomous-agent",
    "coding-agent",
    "ai-coding-assistant",
    "coding-assistant",
