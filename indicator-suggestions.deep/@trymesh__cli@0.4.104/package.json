    "developer-tools",
    "devtools",
    "cli",
    "command-line",
    "terminal",
    "tui",
    "repl",
    "llm",
    "llm-agent",
    "gpt",
    "chatgpt",
    "claude",
    "gemini",
    "grok",
    "deepseek",
    "qwen",
    "llama",
    "kimi",
    "openai",
    "anthropic",
    "google-ai",
    "vertex-ai",
    "bedrock",
    "nvidia-nim",
    "code-generation",
    "codegen",
    "code-assistant",
    "code-review",
    "refactoring",
    "debugging",
    "test-generation",
    "automation",
    "software-engineering",
    "rag",
    "codebase-search",
    "semantic-search",
    "workspace-index",
    "mcp",
    "model-context-protocol",
    "agent-sdk",
    "copilot",
    "cursor",
    "claude-code",
