{
  "name": "react-native-rnx",
  "version": "0.5.92",
  "description": "BerthX libs",
  "react-native": "src/index",
  "source": "src/index",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "react-native-rnx.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "prepare": "bob build",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods",
    "release1": "git add . && git commit -am 'fix(some): fix some bugs' && npm version patch && git push origin master --tags && npm publish",
    "bump": "git add . && git commit -am 'bump version' && git push origin master"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/charlyBerthet/react-native-rnx",
  "author": "charlyberthet <charlyberthet94@gmail.com> (https://berthx.io)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/charlyBerthet/react-native-rnx/issues"
  },
  "homepage": "https://github.com/charlyBerthet/react-native-rnx#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@crowdlinker/react-native-pager": "^0.2.3",
    "@react-native-async-storage/async-storage": "^1.15.2",
    "@react-native-community/eslint-config": "^2.0.0",
    "@react-native-community/masked-view": "^0.1.10",
    "@react-navigation/bottom-tabs": "6.0.9",
    "@react-navigation/native": "6.0.8",
    "@react-navigation/stack": "6.2.0",
    "@types/jest": "^26.0.0",
    "@types/react": "^16.9.19",
    "@types/react-native": "0.62.13",
    "@types/react-native-vector-icons": "^6.4.6",
    "eslint": "^7.2.0",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-prettier": "^3.1.3",
    "i18next": "^20.1.0",
    "jest": "^26.0.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "16.13.1",
    "react-i18next": "^11.8.12",
    "react-native": "0.63.4",
    "react-native-builder-bob": "^0.30.2",
    "react-native-gesture-handler": "^1.10.3",
    "react-native-localize": "^2.0.2",
    "react-native-rate": "^1.2.6",
    "react-native-safe-area-context": "4.7.1",
    "react-native-screens": "^3.0.0",
    "react-native-svg": "^12.1.1-0",
    "react-native-vector-icons": "^8.1.0",
    "typescript": "4.9.4"
  },
  "peerDependencies": {
    "@crowdlinker/react-native-pager": "^0.2.3",
    "@gorhom/bottom-sheet": "4.5.1",
    "@react-native-async-storage/async-storage": "^1.15.2",
    "@react-native-community/masked-view": "^0.1.10",
    "@react-navigation/bottom-tabs": "6.0.9",
    "@react-navigation/native": "6.0.8",
    "@react-navigation/stack": "6.2.0",
    "@types/react-native-vector-icons": "^6.4.6",
    "i18next": "^20.1.0",
    "react": "*",
    "react-i18next": "^11.8.12",
    "react-native": "*",
    "react-native-gesture-handler": "^1.10.3",
    "react-native-localize": "^2.0.2",
    "react-native-rate": "^1.2.6",
    "react-native-reanimated": "^3.2.0",
    "react-native-safe-area-context": "^3.2.0",
    "react-native-screens": "^3.0.0",
    "react-native-svg": "^12.1.1-0",
    "react-native-vector-icons": "^8.1.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "4.5.1",
    "react-native-linear-gradient": "^2.5.6"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
