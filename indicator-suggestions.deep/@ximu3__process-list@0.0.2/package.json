{
  "name": "@ximu3/process-list",
  "version": "0.0.2",
  "description": "A lightweight Windows library for getting process information",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ximu3/process-list.git"
  },
  "license": "MIT",
  "keywords": [
    "process",
    "ps",
    "process-list",
    "system",
    "foreground",
    "napi-rs",
    "rust"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "process-list",
    "targets": [
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 14"
  },
  "packageManager": "pnpm@11.2.2",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --esm --js index.js",
    "build:debug": "napi build --platform --esm --js index.js",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint . --ignore-path .eslintignore",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "test": "ava",
    "test:esm": "tsx scripts/verify-esm.ts",
    "preversion": "pnpm build:debug",
    "version": "napi version && pnpm build:debug && git add index.js index.d.ts",
    "prepare": "lefthook install --reset-hooks-path"
  },
  "devDependencies": {
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@oxc-node/core": "^0.0.35",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "@types/node": "^24.10.0",
    "ava": "^6.4.1",
    "chalk": "^5.6.2",
    "lefthook": "^2.1.10",
    "lint-staged": "^16.1.6",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.14.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "optionalDependencies": {
    "@ximu3/process-list-win32-x64-msvc": "0.0.2"
  }
}