{
  "name": "@interopio/iocd-cli",
  "version": "0.0.90",
  "description": "CLI tool for setting up, building and packaging io.Connect Desktop platforms",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/commands/index.js",
  "bin": {
    "iocd": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ./scripts/delete-dist.js && tsc && npm run format && npm run lint && npm run generate-schema && npm run copy-assets",
    "generate-schema": "node ./scripts/generate-schema.js",
    "copy-assets": "node ./scripts/copy-assets.js",
    "dev": "tsc --watch",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage jest",
    "test:watch": "cross-env NODE_OPTIONS=--no-experimental-webstorage jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts*",
    "prepublishOnly": "npm run build && npm run gitignore:pre-package",
    "postpublish": "npm run gitignore:post-publish",
    "postinstall": "npm run gitignore:post-install",
    "gitignore:pre-package": "node ./scripts/handle-gitignore-templates.js pre-package",
    "gitignore:post-publish": "node ./scripts/handle-gitignore-templates.js post-publish",
    "gitignore:post-install": "node ./scripts/handle-gitignore-templates.js post-install",
    "cli": "npm run build && node dist/cli.js",
    "prepare": "husky"
  },
  "keywords": [
    "io.connect",
    "desktop",
    "cli",
    "electron",
    "interop.io"
  ],
  "author": "Interop.io",
  "license": "MIT",
  "files": [
    "dist",
    "scripts",
    "tools",
    "assets",
    "README.md",
    "changelog.md"
  ],
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@electron/notarize": "^3.1.0",
    "@electron/osx-sign": "^2.2.0",
    "@sentry/node": "^10.17.0",
    "adm-zip": "^0.5.17",
    "commander": "^14.0.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.2.2",
    "fs-extra": "^11.3.1",
    "jsonwebtoken": "^9.0.2",
    "log4js": "^6.9.1",
    "plist": "^3.1.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@interopio/desktop": "^6.15.0",
    "@types/adm-zip": "^0.5.8",
    "@types/electron-builder": "^2.0.29",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/log4js": "^0.0.33",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "typescript-json-schema": "^0.65.1"
  },
  "peerDependencies": {
    "@electron-forge/core": "^7.11.2"
  },
  "overrides": {
    "tar": ">=7.5.7"
  }
}
