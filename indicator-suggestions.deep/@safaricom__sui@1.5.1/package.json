{
  "name": "@safaricom/sui",
  "description": "SUI Design System",
  "author": "Safaricom PLC",
  "license": "MIT",
  "version": "1.5.1",
  "files": [
    "dist"
  ],
  "main": "./dist/sui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sui.es.js",
      "default": "./dist/sui.es.js"
    },
    "./style.css": "./dist/style.css"
  },
  "keywords": [
    "react",
    "typescript",
    "theme",
    "sui",
    "javascript",
    "material"
  ],
  "scripts": {
    "build": "yarn lint && vite build",
    "lint": "tsc && eslint . --ext .ts,.tsx",
    "lint:fix": "yarn lint -- --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "run-unit-tests": "jest --json --outputFile=.jest-test-results.json || true",
    "test": "jest",
    "start-and-test": "node startAndRunTestsWithOutput.js",
    "test:coverage": "test-storybook --coverage --index-json && npx nyc report --reporter=lcov -t coverage/storybook --report-dir coverage/storybook",
    "test:coverage:generate-lcov": "test-storybook --coverage --index-json && npx nyc report --reporter=lcov -t coverage/storybook --report-dir coverage/storybook",
    "release": "standard-version",
    "test:vitestcoverage": "vitest run --coverage",
    "prepare": "husky install",
    "serve": "http-server ./storybook-static -p 6006"
  },
  "standard-version": {
    "scripts": {
      "prerelease": "yarn build"
    },
    "skip": {
      "changelog": true
    }
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@mui/system": "^6.4.7",
    "@mui/x-date-pickers": "^7.27.3",
    "@types/react": "^19.0.10",
    "dayjs": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@mui/system": {
      "optional": true
    },
    "@mui/x-date-pickers": {
      "optional": false
    },
    "@types/react": {
      "optional": true
    },
    "dayjs": {
      "optional": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/plugin-syntax-flow": "^7.23.3",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-flow": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@chromatic-com/storybook": "^3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@mui/system": "^6.4.7",
    "@mui/x-date-pickers": "7.27.3",
    "@playwright/test": "^1.41.2",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@storybook/addon-actions": "^8.4.5",
    "@storybook/addon-coverage": "^1.0.0",
    "@storybook/addon-docs": "^8.4.5",
    "@storybook/addon-essentials": "^8.4.5",
    "@storybook/addon-interactions": "^8.4.5",
    "@storybook/addon-jest": "^8.4.5",
    "@storybook/addon-links": "^8.4.5",
    "@storybook/addon-mdx-gfm": "^8.4.5",
    "@storybook/manager-api": "^8.4.5",
    "@storybook/preview-api": "^8.4.5",
    "@storybook/react": "^8.4.5",
    "@storybook/react-vite": "^8.4.5",
    "@storybook/test": "^8.4.5",
    "@storybook/test-runner": "^0.19.1",
    "@storybook/theming": "^8.4.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7",
    "@types/babel__preset-env": "^7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.8.4",
    "@types/react": "^19.0.10",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/coverage-v8": "^2.1.5",
    "babel-jest": "^29.7.0",
    "dayjs": "^1.11.13",
    "eslint": "^8.45.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "^13.5.2",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jest-dom": "^5.1.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-mdx": "^2.2.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.4.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "standard-version": "^9.5.0",
    "storybook": "^8.4.5",
    "typescript": "^5.1.6",
    "vite": "^6.2.1",
    "vite-aliases": "^0.11.8",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.8"
  }
}
