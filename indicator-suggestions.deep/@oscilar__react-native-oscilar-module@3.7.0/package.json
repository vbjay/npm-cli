{
  "name": "@oscilar/react-native-oscilar-module",
  "version": "3.7.0",
  "description": "Oscilar module for React Native",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-oscilar-module-example",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "release": "release-it",
    "detox": "detox"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "oscilar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oscilar/react-native-oscilar-module.git"
  },
  "author": "Oscilar <mobile@oscilar.com> (https://oscilar.com)",
  "license": "Copyright",
  "bugs": {
    "url": "https://github.com/Oscilar/react-native-oscilar-module/issues"
  },
  "homepage": "https://github.com/Oscilar/react-native-oscilar-module#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.28.5",
    "@babel/runtime": "7.29.2",
    "@commitlint/config-conventional": "17.0.2",
    "@evilmartians/lefthook": "1.5.0",
    "@react-native-community/cli": "18.0.1",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.84.1",
    "@release-it/conventional-changelog": "11.0.0",
    "@types/react": "19.0.0",
    "commitlint": "17.0.2",
    "del-cli": "5.1.0",
    "detox": "20.44.0",
    "eslint": "9.27.0",
    "eslint-plugin-prettier": "5.0.1",
    "hermes-eslint": "0.36.1",
    "jest": "29.7.0",
    "prettier": "3.0.3",
    "react": "19.0.0",
    "react-native": "0.79.1",
    "react-native-builder-bob": "0.37.0",
    "release-it": "20.0.1",
    "turbo": "2.9.14",
    "typescript": "5.2.2",
    "vite": "8.0.16",
    "vitest": "4.1.5",
    "wait-on": "9.0.10"
  },
  "resolutions": {
    "axios": "1.16.0",
    "tmp": "0.2.7",
    "tar": "7.5.16",
    "fast-xml-parser": "5.9.3",
    "fast-uri": "3.1.2",
    "eslint-plugin-ft-flow": "3.0.11",
    "form-data": "4.0.6",
    "js-yaml": "4.2.0",
    "qs": "6.15.2",
    "release-it/undici": "7.28.0",
    "node-gyp/undici": "6.27.0",
    "@react-native-community/cli-config/joi": "17.13.4",
    "@react-native-community/cli-types/joi": "17.13.4",
    "shell-quote": "1.8.4",
    "launch-editor": "2.14.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.14.1",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "legacy-module",
    "languages": "kotlin-swift",
    "version": "0.48.3"
  },
  "dependencies": {
    "detox-cli": "20.50.1",
    "react-native-dotenv": "3.4.11"
  }
}
