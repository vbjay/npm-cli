{
  "name": "optimized-react-component-library-xyz123-addfiles",
  "version": "0.0.6",
  "description": "A modern React component library using TypeScript with React 19 support.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./css/darkMode.css": "./src/css/darkMode.css",
    "./css/mobileView.css": "./src/css/mobileView.css",
    "./css/styles.css": "./src/css/styles.css"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "./src/css/darkMode.css",
    "./src/css/mobileView.css",
    "./src/css/styles.css"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --dts --format esm,cjs --out-dir dist",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest",
    "prepare": "husky install",
    "release": "standard-version",
    "example:install": "cd examples/react-demo && npm install",
    "example:start": "cd examples/react-demo && npm start",
    "example:build": "cd examples/react-demo && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/optimized-react-component-library-xyz123-ch-react19.git"
  },
  "keywords": [
    "react",
    "react19",
    "component-library",
    "typescript",
    "npm",
    "modern-react",
    "boilerplate"
  ],
  "author": "YOUR NAME",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0",
    "standard-version": "^9.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dropzone": "^14.3.8"
  }
}
