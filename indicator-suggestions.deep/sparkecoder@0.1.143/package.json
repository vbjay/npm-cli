{
  "name": "sparkecoder",
  "version": "0.1.143",
  "description": "A powerful coding agent CLI with HTTP API for development environments",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    }
  },
  "bin": {
    "sparkecoder": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/skills/default",
    "web/.next/standalone",
    "web/.next/static",
    "web/.next/BUILD_ID",
    "web/public",
    "web/package.json",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:watch": "tsx watch --clear-screen=false src/cli.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node dist/cli.js",
    "postinstall": "npm install -g agent-browser 2>/dev/null || true; agent-browser install 2>/dev/null || true",
    "prepublishOnly": "pnpm run build && pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/gateway": "^3.0.104",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/mcp": "^1.0.42",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agent-browser": "^0.14.0",
    "ai": "^6.0.168",
    "ajv": "^8.18.0",
    "chalk": "^5.4.1",
    "commander": "^13.0.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.0",
    "jose": "^6.2.3",
    "minimatch": "^10.1.1",
    "nanoid": "^5.0.9",
    "node-pty": "^1.1.0",
    "ora": "^8.1.1",
    "resumable-stream": "^2.2.10",
    "sharp": "^0.34.5",
    "vscode-jsonrpc": "^8.2.0",
    "ws": "^8.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "drizzle-orm": "^0.45.1",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gostudyfetchgo/sparkecoder.git"
  },
  "homepage": "https://github.com/gostudyfetchgo/sparkecoder#readme",
  "bugs": {
    "url": "https://github.com/gostudyfetchgo/sparkecoder/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "llm",
    "automation",
    "developer-tools"
  ],
  "author": "gostudyfetchgo",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
