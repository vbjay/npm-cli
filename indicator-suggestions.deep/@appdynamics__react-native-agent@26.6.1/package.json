{
  "name": "@appdynamics/react-native-agent",
  "version": "26.6.1",
  "description": "Native instrumentation of iOS and android apps built with react-native.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "bin",
    "*.podspec",
    "react-native.config.js",
    "!**/*.tgz",
    "!node_modules",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!ios/Pods",
    "!example"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint --ignore-path .gitignore \"**/*.{js,json,jsx,md,ts,tsx}\"",
    "prepack": "bob build",
    "example": "yarn --cwd example/every-feature",
    "bootstrap": "yarn example && yarn install && yarn example pods",
    "clean": "del-cli android/build example/every-feature/android/build example/every-feature/android/app/build example/every-feature/ios/build",
    "ts:watch": "tsc -w --noEmit"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/appdynamics/react-native-agent.git",
  "author": "AppDynamics <info@appdynamics.com> (https://docs.appdynamics.com)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/appdynamics/react-native-agent.git/issues"
  },
  "homepage": "https://github.com/appdynamics/react-native-agent.git#readme",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-decorators": "7.17.2",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.7",
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/codegen": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "13.2.0",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-react-native": "^0.2.0",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest-extended": "^2.0.0",
    "eslint-plugin-jsdoc": "^44.2.3",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-markdown": "^3.0.0",
    "eslint-plugin-no-secrets": "^0.8.9",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-sonarjs": "^0.18.0",
    "eslint-plugin-testing-library": "^5.10.0",
    "eslint-plugin-unicorn": "^45.0.2",
    "jest": "^29.2.1",
    "jest-extended": "^3.2.4",
    "jest-watch-typeahead": "^2.2.1",
    "pod-install": "^0.1.0",
    "prettier": "^3.0.3",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-builder-bob": "^0.33.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-test-renderer": "19.2.3",
    "turbo": "^1.10.7",
    "typedoc": "^0.23.24",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "@types/react": "^19.2.0",
    "tar": "7.5.13",
    "glob@^10.0.0": "10.5.0",
    "glob@^7.1.3": "7.2.3",
    "brace-expansion@^1": "^1.1.13",
    "brace-expansion@^5": "^5.0.5",
    "picomatch@^2": "^2.3.2",
    "picomatch@^4": "^4.0.4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "esm": true
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ReactNativeAppdynamicsSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.appdynamics.eum.reactnative"
    }
  },
  "eslintIgnore": [
    "node_modules/"
  ]
}
