{
  "name": "nexum-code",
  "version": "0.7.20",
  "description": "A terminal-native AI agent for builders",
  "license": "MIT",
  "author": "NexumCli",
  "homepage": "https://github.com/Hsssliu/nexum-code/tree/main/apps/nexum-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hsssliu/nexum-code.git",
    "directory": "apps/nexum-code"
  },
  "bugs": {
    "url": "https://github.com/Hsssliu/nexum-code/issues"
  },
  "keywords": [
    "nexum",
    "nexum-code",
    "cli",
    "agent",
    "coding-agent",
    "ai",
    "tui"
  ],
  "bin": {
    "nexum": "dist/main.mjs"
  },
  "files": [
    "dist",
    "icon.ico",
    "scripts/postinstall.mjs",
    "scripts/postinstall"
  ],
  "type": "module",
  "imports": {
    "#*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ],
    "#constant/app": "./src/constant/app.ts",
    "#constant/*": "./src/constant/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "node scripts/dev.mjs",
    "dev:cli-only": "tsx --import ../../build/register-raw-text-loader.mjs ./src/main.ts",
    "dev:prod": "node dist/main.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w run build:packages && vitest run",
    "e2e": "pnpm -w run build:packages && NEXUM_E2E=1 vitest run test/e2e",
    "e2e:real": "pnpm -w run build:packages && NEXUM_E2E_REAL=1 vitest run test/e2e/real-llm-smoke.e2e.test.ts",
    "preinstall": "node -e \"console.log('\\n正在安装 nexum-code，请稍候...\\n')\"",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "node scripts/verify-publish.mjs",
    "smoke": "node dist/main.mjs --version"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.80.2",
    "@mariozechner/clipboard": "^0.3.2",
    "@napi-rs/canvas": "1.0.1",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "diff": "^9.0.0",
    "fastembed": "^2.1.0",
    "pdfjs-dist": "^5.3.0",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "canvas": "3.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nexum-cli/config": "workspace:^",
    "@nexum-cli/knowledge": "workspace:^",
    "@nexum-cli/migration-legacy": "workspace:^",
    "@nexum-cli/nexum-code-sdk": "workspace:^",
    "@nexum-code/memory": "workspace:*",
    "@types/semver": "^7.7.0",
    "tsx": "^4.22.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
