{
    "name": "@forwardslashns/fws-cli",
    "version": "0.4.29",
    "description": "CLI meant to work together with other Forwardslash boilerplates.",
    "main": "src/app.js",
    "type": "module",
    "engines": {
        "node": ">=22.0.0 <23.0.0"
    },
    "bin": {
        "fws": "./src/app.js"
    },
    "scripts": {
        "test": "jest --silent",
        "test:verbose": "jest --collect-coverage",
        "lint": "eslint src --ext js --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --check --ignore-path .gitignore '**/*.{js,ts,json,md}'",
        "format:fix": "prettier --write --ignore-path .gitignore '**/*.{js,ts,json,md}'",
        "postinstall": "node postinstall.js"
    },
    "keywords": [
        "cli",
        "fws"
    ],
    "author": "Forwardslash",
    "homepage": "https://forwardslashny.com/",
    "publishConfig": {
        "access": "public"
    },
    "license": "ISC",
    "dependencies": {
        "@html-next/svg-icon-optimizer": "^0.0.1",
        "ansi-colors": "^4.1.3",
        "cli-spinner": "^0.2.10",
        "cli-spinners": "^3.3.0",
        "commander": "^14.0.2",
        "dotenv": "^17.2.3",
        "fancy-log": "^2.0.0",
        "figlet": "^1.9.3",
        "is-url": "^1.2.4",
        "lodash": "^4.17.21",
        "lodash.startcase": "^4.4.0",
        "lodash.template": "^4.5.0",
        "semver": "^7.7.3",
        "superagent": "^10.2.3",
        "svgo": "^4.0.0"
    },
    "devDependencies": {
        "@types/cli-spinner": "^0.2.3",
        "@types/fancy-log": "^2.0.2",
        "@types/figlet": "^1.7.0",
        "@types/is-url": "^1.2.32",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.20",
        "@types/lodash.startcase": "^4.4.9",
        "@types/lodash.template": "^4.5.3",
        "@types/mock-fs": "^4.13.4",
        "@types/semver": "^7.7.1",
        "@types/superagent": "^8.1.9",
        "eslint": "^9.38.0",
        "eslint-plugin-node": "^11.1.0",
        "install": "^0.13.0",
        "jest": "^30.2.0",
        "mock-fs": "^5.5.0",
        "nodemon": "^3.1.10",
        "npm": "^11.6.2",
        "prettier": "3.6.2",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.4.5",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
