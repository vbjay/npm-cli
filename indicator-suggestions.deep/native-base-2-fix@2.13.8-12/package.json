    "fs-extra": "^2.0.0",
    "lodash": "^4.17.14",
    "native-base-shoutem-theme": "npm:native-base-shoutem-theme-19@0.5.0",
    "opencollective-postinstall": "^2.0.2",
    "print-message": "^2.1.0",
    "prop-types": "^15.5.10",
    "react-native-safe-area-context": "5.6.1",
    "react-native-easy-grid": "0.2.2",
