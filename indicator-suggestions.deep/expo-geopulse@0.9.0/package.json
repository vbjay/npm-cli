{
  "name": "expo-geopulse",
  "version": "0.9.0",
  "description": "Open-source background geolocation SDK for React Native + Expo (Android): fused location, Kalman sensor-fusion (C++/NDK), geofencing, battery-smart motion detection, offline sync.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "plugin/build/index.js",
    "plugin/build/index.d.ts",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!android/src/main/cpp/test_fusion.cpp"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-geopulse",
    "ExpoGeopulse"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramon3198/expo-geopulse.git"
  },
  "bugs": {
    "url": "https://github.com/ramon3198/expo-geopulse/issues"
  },
  "author": "Ramon Carcamo <carcamodev@gmail.com> (https://github.com/ramon3198)",
  "license": "MIT",
  "homepage": "https://github.com/ramon3198/expo-geopulse#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^56.0.7",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.0",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
