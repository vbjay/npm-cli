  "author": "v9u",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/v9u/epson-printer-status.git"
  },
  "bugs": {
    "url": "https://github.com/v9u/epson-printer-status/issues"
  },
  "homepage": "https://github.com/v9u/epson-printer-status#readme",
  "files": [
    "index.js",
    "index.d.ts",
    "addon.cpp",
    "binding.gyp",
    "EpsStmApi.h",
    "README.md",
    "LICENSE",
    "example.js"
  ],
  "dependencies": {
