{
  "name": "dhre-ui-kit",
  "version": "3.1.0",
  "publishConfig": {
    "access": "public"
  },
  "VerifyBeforePublish": [
    "we will use the following versions for different projects",
    ": Meraas & DP = 0.0.1, Nakheel = 2.0.1"
  ],
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "typings": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "src/assets/fonts"
  ],
  "keywords": [
    "react-native",
    "component",
    "library"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "rollup -c && tsc --project tsconfig.json --declaration --emitDeclarationOnly --declarationDir lib",
    "pkg:watch": "rollup -c --watch",
    "test": "jest",
    "tsc": "tsc",
    "lint": "npx eslint ./src",
    "lint:fix": "npm run lint -- --fix",
    "lint:report": "eslint . --format=json --output-file=eslint-report.json",
    "prettier": "npx prettier ./src --check",
    "prettier:fix": "npm run prettier ./src -- --write",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.14.2",
    "@react-native-community/blur": "^4.4.1",
    "lottie-react-native": "^7.2.2",
    "react-native-blob-util": "^0.19.11",
    "react-native-calendars": "^1.1306.0",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-device-info": "^14.0.2",
    "react-native-element-dropdown": "^2.12.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "2.25.0",
    "react-native-modal": "^13.0.1",
    "react-native-paper": "^5.12.5",
    "react-native-pdf": "^6.7.5",
    "react-native-progress": "^5.0.1",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "^1.5.0",
    "react-native-walkthrough-tooltip": "^1.6.0",
    "react-native-webview": "^13.12.0",
    "react-redux": "^9.1.2",
    "rn-tooltip": "^3.0.3",
    "react-native-linear-gradient": "^2.8.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.7",
    "@babel/preset-react": "^7.25.7",
    "@babel/preset-typescript": "^7.25.7",
    "@eslint/js": "^9.12.0",
    "@react-native/babel-preset": "0.74.85",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@svgr/rollup": "^8.1.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.11",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-native": "^4.1.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "react": "^18.2.0",
    "react-native": "0.72.0",
    "react-test-renderer": "18.3.1",
    "rollup": "^2.79.1",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-svg": "^2.0.0",
    "rollup-plugin-svg-import": "^3.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-native": ">=0.60.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint ./src --fix",
      "prettier ./src --write"
    ]
  }
}
