{
  "name": "@moonpay/react-native-moonpay-sdk",
  "version": "1.1.8",
  "description": "The MoonPay Mobile SDK enables you to integrate the MoonPay widget so you can facilitate crypto purchases within your platform.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index",
  "files": [
    "dist",
    "CHANGELOG.md",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "npm run build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://dev.moonpay.com/",
  "author": "tomislavhrenmp <tomislav@moonpay.com> (https://dev.moonpay.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://dev.moonpay.com/"
  },
  "homepage": "https://dev.moonpay.com/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@moonpay-widget/common": "*",
    "@moonpay-widget/common-sdk-communication": "*",
    "@moonpay-widget/core-sdk": "*",
    "expo-constants": "14.4.2",
    "expo-web-browser": "~12.1.1",
    "react": "18.2.0",
    "react-native": "0.71.8",
    "react-native-inappbrowser-reborn": "^3.7.0",
    "react-native-webview": "13.10.2",
    "tsup": "8.5.0",
    "typescript": "5.1.3"
  },
  "peerDependencies": {
    "react": ">=16",
    "react-native": ">0.60",
    "react-native-webview": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "^npm@10.8.2",
  "overrides": {
    "react": "$react",
    "react-native": {
      "react-shallow-renderer": {
        "react": "$react"
      },
      "use-sync-external-store": {
        "react": "$react"
      }
    }
  }
}
