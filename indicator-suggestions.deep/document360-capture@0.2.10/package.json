{
  "name": "document360-capture",
  "version": "0.2.10",
  "description": "CLI that captures product screenshots from Playwright specs. Login once, capture many. Companion to document360-writer.",
  "type": "module",
  "bin": {
    "document360-capture": "./dist/cli.js",
    "d360-capture": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./helpers": "./dist/helpers/index.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc -b && node ../../scripts/bundle.mjs",
    "clean": "rimraf dist",
    "postinstall": "node -e \"import('./dist/scripts/postinstall.js').catch(() => {})\"",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saravana-mv/document360-writer.git",
    "directory": "packages/capture"
  },
  "homepage": "https://github.com/saravana-mv/document360-writer#readme",
  "bugs": {
    "url": "https://github.com/saravana-mv/document360-writer/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@playwright/test": "^1.49.0",
    "commander": "^12.1.0",
    "playwright": "^1.49.0",
    "sharp": "^0.34.5",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/update-notifier": "^6.0.8",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.0"
  },
  "keywords": [
    "screenshot",
    "playwright",
    "documentation",
    "cli",
    "document360"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
