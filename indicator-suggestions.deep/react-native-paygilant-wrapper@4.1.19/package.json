{
  "name": "react-native-paygilant-wrapper",
  "version": "4.1.19",
  "description": "react-native-paygilant",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean:pods:lib && bob build",
    "verify": "npm run test",
    "build:android": "cd example/android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "cd example/ios && xcodebuild -workspace PaygilantWrapperExample.xcworkspace -scheme PaygilantWrapperExample -configuration Debug -sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO",
    "bootstrap": "yarn example && yarn install && yarn example pods",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build",
    "ci:test:android": "npm run ci:bootstrap && npm run e2e:android",
    "ci:test:ios": "npm run ci:bootstrap:ios && npm run e2e:ios",
    "ci:bootstrap": "npm ci && npm --prefix example ci",
    "ci:bootstrap:ios": "npm ci && npm --prefix example ci && npm run example:pods",
    "example:ci": "npm --prefix example ci",
    "example:pods": "bash -lc 'cd example/ios && pod install'",
    "start:metro": "bash scripts/start-metro-mac.sh",
    "start": "npm --prefix example run start",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "build": "bob build",
    "prepack": "npm run clean:pods:lib && npm run build",
    "release": "release-it",
    "example": "npm --prefix example run start",
    "stop:metro": "bash -lc 'lsof -ti:8081 | xargs -r kill; sleep 1; lsof -ti:8081 | xargs -r kill -9; pkill -f \"react-native start\" || true; pkill -f \"@react-native-community/cli.* start\" || true'",
    "clean:caches": "bash -lc 'watchman watch-del-all || true; rm -rf $TMPDIR/metro-* $TMPDIR/haste-map-* || true'",
    "clean:all": "npm run stop:metro || true && npm run clean:builds && npm run clean:node && npm run clean:caches",
    "clean:builds": "bash -lc 'rm -rf lib example/android/build example/android/app/build example/android/.gradle example/android/.cxx example/ios/build'",
    "clean:node": "bash -lc 'rm -rf node_modules example/node_modules'",
    "clean:pods:lib": "bash -lc 'rm -rf ios/Pods ios/Podfile.lock ios/build'",
    "bootstrap:base": "npm ci && npm --prefix example ci",
    "bootstrap:pods": "bash -lc 'cd example/ios && pod install' || true",
    "bootstrap:fresh": "npm run clean:all && npm run bootstrap:base && npm run bootstrap:pods",
    "e2e:build:android": "npm --prefix example run e2e:build:android",
    "e2e:test:android": "npm --prefix example run e2e:test:android",
    "e2e:android": "npm run e2e:build:android && npm run e2e:test:android",
    "e2e:build:ios": "npm --prefix example run e2e:build:ios",
    "e2e:test:ios": "npm --prefix example run e2e:test:ios",
    "e2e:ios": "npm run e2e:build:ios && npm run e2e:test:ios",
    "ci:tests": "npm run bootstrap:fresh &&npm run start:metro && npm run e2e:android && npm run e2e:ios",
    "ci:pack": "npm run ci:tests && npm run build && npm pack",
    "ci:publish": "npm run ci:tests && npm run build && npm publish",
    "dev": "npm run bootstrap:base && npm --prefix example run start"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paygilant/react-native-wrapper.git"
  },
  "author": "Paygilant <mobile@paygilant.com> (https://github.com/Paygilant/react-native-wrapper)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Paygilant/react-native-wrapper.git/issues"
  },
  "homepage": "https://github.com/Paygilant/react-native-wrapper.git#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.2.2",
    "@release-it/conventional-changelog": "^5.0.0",
    "@testing-library/react-native": "^13.2.2",
    "@types/jest": "29.5.14",
    "@types/react": "^19.2.14",
    "@types/react-native": "0.70.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.0.0",
    "detox": "^20.51.1",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "29.7.0",
    "jest-circus": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "pod-install": "^0.1.0",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.21.3",
    "react-test-renderer": "19.2.3",
    "release-it": "^15.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "turbo": "^1.10.7",
    "typescript": "^5.9.2",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/runtime": "^7.29.2",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/react-test-renderer": "^19.1.0",
    "jest-environment-node": "29.7.0",
    "babel-jest": "29.7.0"
  },
  "resolutions": {
    "@types/react": "17.0.21"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.0.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNPaygilantWrapperSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  }
}
