{
  "name": "@zezosoft/react-native-zezopay",
  "version": "1.3.6",
  "description": "A React Native library for integrating ZezoPay payment gateway seamlessly in iOS and Android apps.",
  "main": "./lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "*.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @zezosoft/react-native-zezopay-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it --only-version",
    "build": "bob build",
    "watch": "nodemon --watch src --ext ts,tsx,js --delay 500ms --exec \"yarn clean && yarn build && yalc push\""
  },
  "keywords": [
    "react-native",
    "zezopay",
    "payment",
    "payment-gateway",
    "ios",
    "android",
    "upi",
    "razorpay",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zezo-Soft/react-native-zezopay.git"
  },
  "author": "Naresh Dhamu <narsadhamu@gmail.com> (https://github.com/naresh-dhamu)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Zezo-Soft/react-native-zezopay/issues"
  },
  "homepage": "https://github.com/Zezo-Soft/react-native-zezopay#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/babel-preset": "0.78.2",
    "@react-native/eslint-config": "^0.78.0",
    "@release-it/conventional-changelog": "^9.0.2",
    "@types/axios": "^0.14.4",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.12",
    "@types/react-native-razorpay": "^2.2.6",
    "commitlint": "^19.6.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.3",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-builder-bob": "^0.40.13",
    "react-native-safe-area-context": "^5.6.1",
    "release-it": "^17.10.0",
    "typescript": "5.4.4",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": "*",
    "@stripe/stripe-react-native": "*",
    "lucide-react-native": "*",
    "react": "*",
    "react-native": "*",
    "react-native-device-info": "*",
    "react-native-iap": "*",
    "react-native-keyboard-aware-scroll-view": "*",
    "react-native-linear-gradient": "*",
    "react-native-mmkv": "*",
    "react-native-nitro-modules": "*",
    "react-native-razorpay": "*",
    "react-native-safe-area-context": "*",
    "react-native-size-matters": "*",
    "react-native-svg": "*",
    "react-native-system-navigation-bar": "*",
    "react-native-webview": "*",
    "zustand": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.52.1"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@stripe/stripe-react-native": "^0.63.0",
    "axios": "^1.12.2",
    "crypto-js": "^4.2.0",
    "json_encode": "^0.1.0",
    "lucide-react-native": "^1.8.0",
    "qs": "^6.14.0",
    "react-native-blob-util": "^0.24.9",
    "react-native-device-info": "^15.0.2",
    "react-native-iap": "^15.0.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-phonepe-pg": "^3.1.1",
    "react-native-razorpay": "^2.3.1",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "^15.15.4",
    "react-native-system-navigation-bar": "^2.8.0",
    "react-native-view-shot": "^5.1.0",
    "react-native-webview": "^13.16.1",
    "zustand": "^5.0.12"
  }
}
