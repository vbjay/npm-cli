{
  "name": "@datadome/datadome-axios",
  "version": "3.2.0",
  "description": "The DataDome interceptor for Axios",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/datadome/datadome-axios",
  "author": "DataDome <dev@datadome.co> (https://datadome.co/)",
  "bugs": {
    "url": "https://github.com/datadome/datadome-axios/issues"
  },
  "homepage": "https://github.com/datadome/datadome-axios#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "react": "19.2.3",
    "@types/react": "19.2.3",
    "react-native": "0.85.2",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "jest": "^29.6.3",
    "@types/jest": "^29.5.13",
    "react-native-builder-bob": "^0.20.0",
    "turbo": "2.9.9",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "axios": "^1.11.0",
    "react-native": ">= 0.72.0 < 1.0.0",
    "react-native-webview": "^13.2.0"
  },
  "engines": {
    "node": ">= 18.16.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "codegenConfig": {
    "name": "DatadomeAxiosSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "co.datadome.datadomeaxios"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
