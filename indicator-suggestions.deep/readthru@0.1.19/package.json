{
  "name": "readthru",
  "version": "0.1.19",
  "description": "Chapter-style code review against your local git branch.",
  "keywords": [
    "code-review",
    "cli",
    "chapters",
    "git",
    "claude-code",
    "cursor",
    "codex",
    "gemini",
    "opencode"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "readthru": "dist/index.js"
  },
  "files": [
    "dist",
    "drizzle",
    "web-dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/sync-skill.mjs && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "prepack": "node scripts/sync-skill.mjs && node -e \"const fs=require('node:fs');fs.copyFileSync('../../README.md','./README.md')\""
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "ignore": "^7.0.5",
    "js-yaml": "^4.2.0",
    "open": "^11.0.0",
    "parse-diff": "^0.11.1",
    "pyright": "^1.1.410",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0",
    "vscode-jsonrpc": "^9.0.0",
    "vscode-languageserver-protocol": "^3.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@readthru/types": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "tsdown": "^0.21.10",
    "vitest": "^4.1.5"
  }
}
