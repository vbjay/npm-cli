{
  "name": "hstack",
  "version": "0.6.0",
  "description": "A spec-driven engineering workflow that ships as Claude Code Skills and subagents.",
  "keywords": [
    "claude-code",
    "ai",
    "workflow",
    "spec-driven",
    "agents"
  ],
  "license": "MIT",
  "author": "Hugo Ganet",
  "homepage": "https://github.com/hugoganet/hstack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugoganet/hstack.git"
  },
  "type": "module",
  "bin": {
    "hstack": "dist/cli.js"
  },
  "files": [
    "dist/",
    "template/",
    "VERSION",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "clean:pyc": "find template -type d -name __pycache__ -prune -exec rm -rf {} + ; find template -name '*.pyc' -delete",
    "prepack": "npm run build && npm run clean:pyc",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
