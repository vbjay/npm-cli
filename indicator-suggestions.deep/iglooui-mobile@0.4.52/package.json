{
  "name": "iglooui-mobile",
  "version": "0.4.52",
  "description": "mobile UI components for Igloo",
  "main": "lib/module/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "lib/module/index.js",
  "source": "src/index",
  "files": [
    "lib",
    "android",
    "ios",
    "cpp",
    "iglooui-mobile.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release": "release-it patch",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://gitlab.iglooinsure.com/axinan/fe/iglooui-mobile",
  "author": "iglooDevelopers <developers@iglooinsure.com> (https://developers.iglooinsure.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.iglooinsure.com/axinan/fe/iglooui-mobile/issues"
  },
  "homepage": "https://gitlab.iglooinsure.com/axinan/fe/iglooui-mobile#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^11.0.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/eslint-config": "^2.0.0",
    "@react-native-documents/picker": "^10.1.1",
    "@release-it/conventional-changelog": "^2.0.0",
    "@types/jest": "^26.0.0",
    "@types/lodash": "^4.14.194",
    "@types/react": "^16.9.19",
    "@types/react-native": "0.62.13",
    "commitlint": "^11.0.0",
    "decimal.js": "^10.3.1",
    "deepmerge": "^4.3.1",
    "eslint": "^7.2.0",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^6.0.0",
    "jest": "^26.0.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "17.0.2",
    "react-native": "0.65.3",
    "react-native-builder-bob": "^0.40.18",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "^1.18.6",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-safe-area-context": "^5.6.1",
    "release-it": "^14.2.2",
    "typescript": "^4.1.3"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-documents/picker": "^10.1.1",
    "deepmerge": "^4.3.1",
    "react": "*",
    "react-native": "*",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "^1.18.6",
    "react-native-modal": "*",
    "react-native-safe-area-context": "^5.6.1"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "formik": "^2.4.1",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.33",
    "yup": "^0.32.11"
  }
}
