{
 "name": "@jheavenknows/bluerouter",
 "version": "5.1.5",
 "description": "Bluerouter CLI - Start and manage Bluerouter server",
 "bin": {
  "bluerouter": "./cli.js"
 },
 "publishConfig": {
  "access": "public"
 },
 "files": [
  "cli.js",
  "src",
  "hooks",
  "app",
  "README.md",
  "LICENSE"
 ],
 "scripts": {
  "dev": "nodemon -I --watch cli.js --watch src --watch hooks --ext js,json cli.js",
  "build": "node scripts/build-cli.js",
  "pack:cli": "npm run build && npm pack --pack-destination ../..",
  "publish:cli": "npm run build && npm publish --access public",
  "postinstall": "node hooks/postinstall.js",
  "prepublishOnly": "npm run build"
 },
 "dependencies": {
  "enquirer": "^2.4.1",
  "mysql2": "^3.22.4",
  "node-forge": "^1.3.3",
  "node-machine-id": "^1.1.12",
  "pg": "^8.21.0",
  "react": "19.2.1",
  "react-dom": "19.2.1"
 },
 "engines": {
  "node": ">=18.0.0"
 },
 "keywords": [
  "bluerouter",
  "cli",
  "proxy",
  "ai",
  "api"
 ],
 "license": "MIT",
 "devDependencies": {
  "esbuild": "^0.25.12",
  "nodemon": "^3.1.14"
 }
}
