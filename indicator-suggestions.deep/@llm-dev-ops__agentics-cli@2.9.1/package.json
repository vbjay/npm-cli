{
  "name": "@llm-dev-ops/agentics-cli",
  "version": "2.9.1",
  "description": "Agentics CLI - Pure orchestration layer for agentics platform services",
  "type": "module",
  "main": "./dist/cli/index.js",
  "bin": {
    "agentics": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "agents",
    "docs/ecosystem.graph.json",
    "docs/templates",
    "scripts/postinstall.sh",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "dev": "tsc --watch -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "npm test -- --testPathPattern=tests/unit",
    "test:integration": "npm test -- --testPathPattern=tests/integration",
    "test:e2e": "npm test -- --testPathPattern=tests/e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postbuild": "test -f dist/cli/index.js || { echo 'BUILD FAILED: dist/cli/index.js missing — TypeScript did not emit (is `typescript` installed?)'; exit 1; }; chmod +x dist/cli/index.js 2>/dev/null || true",
    "bundle-agents": "bash scripts/bundle-agents.sh",
    "postinstall": "bash scripts/postinstall.sh 2>/dev/null || true",
    "prepublishOnly": "npm run clean && npm run build && npm run bundle-agents",
    "start:server": "node dist/server/index.js"
  },
  "keywords": [
    "agentics",
    "cli",
    "orchestration",
    "deployment",
    "llm",
    "ai-agents",
    "simulation"
  ],
  "author": "llm-dev-ops",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/llm-dev-ops/agentics-cli.git"
  },
  "homepage": "https://github.com/llm-dev-ops/agentics-cli#readme",
  "bugs": {
    "url": "https://github.com/llm-dev-ops/agentics-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "claude-flow": "^3.0.0-alpha.179",
    "hono": "^4.6.14",
    "ruflo": "^3.5.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "jose": "^5.10.0",
    "ts-jest": "^29.4.6",
    "typescript": "5.9.3"
  }
}
